import { Fragment, useEffect, useMemo, useRef, useState } from "react";import "./App.css";/* ============================================================================   VIDYA — AI Mentorship assistant persona & voice configuration.   Presentation/personality only: no new endpoints, no backend changes.   `voice` is the contract a TTS engine (or the chat backend once it gains an   LLM) should honour, so the spoken output matches the persona below.   ========================================================================== */const VIDYA = {  name: 'VIDYA',  role: 'Study companion & wellbeing mentor',  tagline: 'Always here to listen',  persona: 'A warm, calm and emotionally intelligent study companion for Indian college students. Speaks softly, like an older sister who genuinely cares. Never robotic, never clinical, never masculine or preachy.',  traits: ['warm', 'calm', 'emotionally intelligent', 'encouraging', 'never judgemental', 'concise and real', 'gentle humour'],  // Style rules for any future LLM pass — kept explicit so the tone cannot drift.  style: {    register: 'soft spoken Indian English, everyday campus tone',    sentenceLength: 'short and warm, 1–2 sentences, never long paragraphs',    opener: 'acknowledge the feeling first, in one short line',    never: ['robotic phrasing', 'clinical or diagnostic language', 'lecturing', 'slang the student never used', 'male-coded framing', 'excessive exclamation marks', 'cheerleading over study'],    reassurance: 'reassure before advising, and always leave one small doable next step',  },  voice: {    lang: 'en-IN',    // Ordered preference list; the first installed matching voice wins.    preferredVoices: ['Swara', 'Aditi', 'Raveena', 'Neerja', 'Nisha', 'Asha', 'Samantha', 'Google UK English Female', 'Microsoft Swara Online (Natural) - English (India)'],    gender: 'female',    ageRange: [18, 22],    rate: 0.92,      // slow, unhurried    pitch: 1.18,     // soft, youthful    volume: 0.95,    style: 'conversational, warm, gentle',  },  // Sent with every chat turn. The current backend ignores it (it only reads  // `message` and `studentId`), so replies are unchanged today — but the  // persona already reaches the server for a future TTS/LLM integration.  apiPayload: () => ({    assistant: 'VIDYA',    persona: 'warm-female-student-companion',    voice: { lang: 'en-IN', gender: 'female', rate: 0.92, pitch: 1.18, style: 'conversational, warm, gentle' },  }),};/* Panel-state key for the chat tab. Kept as one constant so the visible label   and every aarTool comparison can never drift apart. */const AAR_CHAT_TAB = `Chat with ${VIDYA.name}`;/* ============================================================================   VIDYA conversation engine.   Every card, chip and topic on the mentorship page maps to one context here.   A context owns its greeting, the 2–3 questions it asks to open, the way it   reflects what the student said, the steps it suggests and its own follow-up   suggestions — so switching a card instantly switches the whole conversation   rather than just the panel below the mic.   Replies are produced locally and immediately so a turn lands in well under   two seconds. The existing /api/student-dashboard/mentorship/chat endpoint is   still called for every turn so the saved transcript on the server is the same   as before; the server file itself is not touched.   ========================================================================== */const vidyaMoodWord = (mood) => (mood ? `feeling ${String(mood).toLowerCase()}` : 'landing in here');/* Shared reflective openers, keyed by what the student just said. */const VIDYA_LISTEN = {  greet: ['Good to see you.', 'That is a nice way to start.', 'I am listening.'],  open: ['I hear you.', 'Thank you for saying that.', 'That is worth saying out loud.'],  low: ['That sounds genuinely heavy, and you are allowed to feel it.', 'Low moments are real, and they do pass.', 'It sounds like today has asked a lot of you.'],  anxious: ['Anxious feelings are your body asking for slower ground.', 'That rush is exhausting to sit inside.', 'Worry is your mind trying to protect you — it just overdoes it.'],  tired: ['Running on empty is a signal, not a failure.', 'Your system is asking for rest, and rest is not laziness.', 'That kind of tired does not fix itself with more effort.'],  study: ['Studies are usually the visible part of a bigger pressure.', 'Workload is real, and it can be planned rather than endured.', 'Let us make the academic part concrete instead of vague.'],  family: ['Home tension is heavy to carry while you are trying to study.', 'That is a lot to hold at your age.', 'Family pressure shapes a lot without anyone meaning it to.'],  good: ['That is worth marking down.', 'Good — let us build on it.', 'I am glad to hear that.'],  thanks: ['Any time. I am glad it helped.', 'You are welcome — genuinely.', 'Of course. Keep it if it is useful.'],};/* Detects what the student is saying so the reply can meet them there. */const vidyaIntent = (text) => {  const s = ` ${String(text || '').toLowerCase().replace(/[^a-z\s]/g, ' ')} `;  if (/\b(suicid|kill myself|self harm|hurt myself|end my life|not want to live|no reason to live)\b/.test(s)) return 'crisis';  if (/\b(sad|low|lonely|alone|crying|cry|hopeless|empty|nobody|miss|left out)\b/.test(s)) return 'low';  if (/\b(anxious|anxiety|panic|nervous|worried|worry|scared|overwhelmed|overwhelm|stress)\b/.test(s)) return 'anxious';  if (/\b(tired|exhausted|sleep|insomnia|night|burnout|burnt out|no energy|racing mind)\b/.test(s)) return 'tired';  if (/\b(exam|test|study|studies|subject|marks|assignment|revision|college|project|deadline|syllabus)\b/.test(s)) return 'study';  if (/\b(family|mum|mom|dad|parents|home|argue|argument|fight)\b/.test(s)) return 'family';  if (/\b(thank|thanks|thx|helpful)\b/.test(s)) return 'thanks';  if (/\b(hi|hello|hey|good morning|good evening|good afternoon)\b/.test(s)) return 'greet';  if (/\b(good|great|happy|better|fine|proud|improving|enjoyed)\b/.test(s)) return 'good';  return 'open';};/* Pulls a short fragment of the student's own words so a reply can reflect it   back instead of only agreeing. */const vidyaEcho = (text) => {  const words = String(text || '').replace(/[^\w\s]/g, ' ').split(/\s+/).filter((w) => w.length > 3);  if (words.length < 4) return '';  return words.slice(0, 7).join(' ').trim();};const vidyaCtx = (id, label, icon, spec) => ({ id, label, icon, tint: '#4f5fd7', bg: '#eef0ff', ...spec });const VIDYA_CONTEXTS = {  general: vidyaCtx('general', AAR_CHAT_TAB, '💬', {    greet: (m) => `I am here with you, and I am not going anywhere. You are ${vidyaMoodWord(m)}. What is on your mind?`,    ask: ['How are you doing today, really?', 'What is the part of today that keeps replaying in your head?', 'What would help most in the next hour?'],    follow: ['Tell me more about that.', 'What happened just before that?', 'If a friend described this, what would you tell them?'],    steps: ['Name the one thing that matters most this week', 'Put a 10-minute Calm Mode break in your day', 'Tell one person how you actually are'],    suggest: [{ t: 'I feel overwhelmed', q: 'I feel overwhelmed by everything I have to do' }, { t: 'I cannot sleep', q: 'I keep losing sleep because my mind will not stop' }, { t: 'Help me plan studies', q: 'Help me plan my studies for this week' }],  }),  emotional: vidyaCtx('emotional', 'Emotional Support', '💙', {    tint: '#4f5fd7', bg: '#e8ecff',    greet: (m) => `Thank you for choosing Emotional Support. You are ${vidyaMoodWord(m)}, and you do not have to explain it perfectly. Let us start slowly.`,    ask: ['When did this feeling start showing up today?', 'What is the one thought that keeps repeating?', 'Who would you feel safe talking to about this?'],    follow: ['What does that feeling look like in your body?', 'When it arrives, what do you usually do?', 'What helped the last time it eased?'],    steps: ['Put both feet on the floor and name five things you can see', 'Write the feeling in one honest sentence, not a polite one', 'Tell one trusted person before the week ends'],    suggest: [{ t: 'Start a Calm Mode round', q: 'Can we do a calming exercise right now?' }, { t: 'Write it in Hope Journal', q: 'Help me write down what is weighing on me' }, { t: 'Reach a trusted person', q: 'Who can I talk to about feeling like this?' }],  }),  academic: vidyaCtx('academic', 'Academic Help', '📘', {    tint: '#6b5ce0', bg: '#ece9ff',    greet: (m) => `Academic Help it is. You are ${vidyaMoodWord(m)} and your studies are not the only thing in the room — let us make the work smaller.`,    ask: ['Which subject is costing you the most time right now?', 'What is the next real deadline you are facing?', 'How are you studying — reading, revising, or practicing?'],    follow: ['What does that topic need you to actually understand?', 'How long do you usually give it before you stop?', 'What would a good result look like for you?'],    steps: ['Pick one 25-minute focus block for the weakest subject', 'Review yesterday in three bullet points', 'Write tomorrow\u2019s first task in one line tonight'],    suggest: [{ t: 'Build my study plan', q: 'Help me build a realistic study plan for this week' }, { t: 'Clear one weak topic', q: 'I keep getting stuck on one topic in my subject' }, { t: 'Recover my routine', q: 'I have stopped studying regularly and want to restart' }],  }),  sleep: vidyaCtx('sleep', 'Sleep & Anxiety', '😴', {    tint: '#3f7fd0', bg: '#e6f0ff',    greet: (m) => `Sleep & Anxiety. You are ${vidyaMoodWord(m)} and a racing mind at night is exhausting — we can slow it down.`,    ask: ['What time does your mind usually get loud?', 'What is the last thought you have before you fall asleep?', 'How many hours are you actually getting?'],    follow: ['What is your body doing when you cannot sleep?', 'Is it worry about tomorrow or a replay of today?', 'What time do you have to be up?'],    steps: ['Dim the screen one hour before bed', 'Write tomorrow\u2019s worries on paper so they leave your head', 'Try a 4-4-6 Calm Mode round lying down'],    suggest: [{ t: 'Start Calm Mode', q: 'Guide me through a calming breathing exercise' }, { t: 'Clear my racing thoughts', q: 'My mind races at night and will not stop' }, { t: 'Plan a calmer evening', q: 'Help me plan an evening routine that helps me sleep' }],  }),  burnout: vidyaCtx('burnout', 'Stress & Burnout', '🔥', {    tint: '#d1683f', bg: '#ffeae4',    greet: (m) => `Stress & Burnout — thank you for naming it. You are ${vidyaMoodWord(m)}, and burnout is a load problem, not a character problem.`,    ask: ['What is piling up the most right now?', 'When did you last have a day that felt like yours?', 'What would you drop first if you were allowed to drop one thing?'],    follow: ['How long has this been building?', 'What does rest look like for you right now?', 'Who notices when you are running low?'],    steps: ['Remove one task from tomorrow\u2019s list', 'Take a real break before the next study block, not after', 'Tell someone the honest version, not the fine one'],    suggest: [{ t: 'Reduce my workload', q: 'I am burnt out and everything feels like too much pressure' }, { t: 'Restart my routine gently', q: 'Help me restart my study routine without burning out again' }, { t: 'Take a calm pause', q: 'I need a proper break right now, can we do one together' }],  }),  lonely: vidyaCtx('lonely', 'Loneliness', '🫧', {    tint: '#2f9c86', bg: '#e4f6f1',    greet: (m) => `Loneliness. Being around people and still feeling alone is one of the hardest things to explain, and you are ${vidyaMoodWord(m)} for feeling it.`,    ask: ['When did this loneliness show up most?', 'Who is around you in a normal day?', 'When did you last feel genuinely connected to someone?'],    follow: ['What makes a conversation feel safe for you?', 'Is it hard to start conversations or to keep them?', 'What is one small contact you could make this week?'],    steps: ['Message one person a genuine, non-utilitarian sentence', 'Sit somewhere with people once today, even briefly', 'Tell VIDYA what support actually looks like for you'],    suggest: [{ t: 'Reach a trusted person', q: 'Help me decide who I can actually open up to' }, { t: 'Start a small conversation', q: 'How do I start a real conversation with my classmates' }, { t: 'Talk it through', q: 'I feel lonely even though there are people around me' }],  }),  family: vidyaCtx('family', 'Family Problems', '🏠', {    tint: '#c2558c', bg: '#fdeaf3',    greet: (m) => `Family Problems. You are ${vidyaMoodWord(m)}, and carrying tension at home while trying to study is genuinely heavy.`,    ask: ['What is the tension mostly about at home?', 'Do they know how this is landing on you?', 'What do you wish you could say, but do not?'],    follow: ['What happens right after the argument usually?', 'What are you protecting by staying quiet?', 'Is there one person at home who is on your side?'],    steps: ['Write down the sentence you wish you could say', 'Pick a calm moment this week to say ten words of it', 'Protect one study hour as non-negotiable space'],    suggest: [{ t: 'Check in with my mood', q: 'Home tension is affecting my studies and I need to check in' }, { t: 'Find my calm', q: 'I need a calming exercise, this has been a hard day at home' }, { t: 'Talk it through', q: 'There is tension at home and it is affecting my studies' }],  }),  career: vidyaCtx('career', 'Career Confusion', '🎯', {    tint: '#8a5ce0', bg: '#f4ecff',    greet: (m) => `Career Confusion. You are ${vidyaMoodWord(m)}, and not knowing which path fits is a normal thing to feel at this stage.`,    ask: ['What are the two or three options you keep going back and forth on?', 'What are you good at, even if nobody has told you?', 'What would you regret not trying?'],    follow: ['What has drawn you to that path so far?', 'Who in your field actually has the life you want?', 'What is the smallest test you could run this month?'],    steps: ['List three paths and one sentence of evidence for each', 'Talk to one person already doing the work', 'Try a two-week taste before committing'],    suggest: [{ t: 'See my journey so far', q: 'Show me what I have already achieved so far' }, { t: 'Get a small step plan', q: 'Give me a small first step towards the career I want' }, { t: 'Talk it through', q: 'I am confused about which career path actually fits me' }],  }),  motivation: vidyaCtx('motivation', 'Motivation', '🌟', {    tint: '#c99022', bg: '#fff4dd',    greet: (m) => `Motivation. You are ${vidyaMoodWord(m)} — and losing the drive is usually a signal that the work has stopped making sense, not that you have.`,    ask: ['What are you avoiding, and what does avoiding it feel like?', 'When did you last feel properly interested in studying?', 'What would make the next two hours feel worth it?'],    follow: ['Is the task too big, or unclear, or just dull?', 'What did the last good study session have in it?', 'Who is the version of you you would be doing this for?'],    steps: ['Do one 10-minute block on the smallest piece', 'Log one thing that went well today', 'Change the place you study, even slightly'],    suggest: [{ t: 'Log a small win', q: 'Help me write down what went well today' }, { t: 'Start one focus block', q: 'Give me one 25-minute focus block to start with' }, { t: 'Talk it through', q: 'I have lost my motivation and cannot focus on anything' }],  }),  moodcheck: vidyaCtx('moodcheck', 'Mood Check', '🌤️', {    tint: '#f0a94a', bg: '#fdf1de',    greet: (m) => (m ? `You are logged as feeling ${String(m).toLowerCase()} today. Let us look at what is behind that.`      : `Let us check in properly. You are ${vidyaMoodWord(null)} today, and naming it is the first useful thing.`),    ask: ['What is the strongest feeling in your body right now?', 'What happened in the last few hours that moved it?', 'What would make today five percent better?'],    follow: ['Is this a pattern this week or a one-off?', 'What has helped before?', 'Who would you like to know about this?'],    steps: ['Name the feeling in one word', 'Pick the smallest thing you can control today', 'Log the mood at the same time tomorrow'],    suggest: [{ t: 'Log today\u2019s mood', q: 'I want to log how I am feeling today properly' }, { t: 'Talk about what moved it', q: 'Help me understand what is behind how I feel today' }, { t: 'Take a calm pause', q: 'I need a quick calming exercise' }],  }),  calm: vidyaCtx('calm', 'Calm Mode', '🌿', {    tint: '#2f9c86', bg: '#e2f6ef',    greet: (m) => `Calm Mode is open. You are ${vidyaMoodWord(m)}, so we go slow — four seconds in, hold, six seconds out.`,    ask: ['Where in your body is the tension right now?', 'What were you doing just before you opened this?', 'What would feel like calm for even five minutes?'],    follow: ['Did the first round change anything at all?', 'What is louder now — the body or the thoughts?', 'Shall we do another round or talk first?'],    steps: ['Four slow rounds of 4-4-6 breathing', 'Drop your shoulders on every exhale', 'Name the one thing you are carrying before you stop'],    suggest: [{ t: 'Start a breathing round', q: 'Start a calming breathing round with me now' }, { t: 'Talk instead', q: 'I would rather talk about what is making me anxious' }, { t: 'Sleep better tonight', q: 'Help me use this calm practice to sleep better tonight' }],  }),  recovery: vidyaCtx('recovery', 'Study Recovery', '📚', {    tint: '#6b5ce0', bg: '#ece9ff',    greet: (m) => `Study Recovery. You are ${vidyaMoodWord(m)} — a restart does not need to be dramatic, it needs to be small and repeatable.`,    ask: ['What made you stop studying regularly?', 'What time of day still works best for you?', 'What is the one subject you would hate to be behind in?'],    follow: ['How much time can you genuinely give each day?', 'What has put you off before?', 'What would a good week look like at the moment?'],    steps: ['One 25-minute block, one subject, phone face down', 'A 10-minute break away from the desk', 'Three bullets reviewing yesterday before you sleep'],    suggest: [{ t: 'Plan the week', q: 'Help me plan a realistic study week' }, { t: 'Fix one subject', q: 'I need to catch up in one subject' }, { t: 'Talk it through', q: 'I have lost my study routine and feel bad about it' }],  }),  journal: vidyaCtx('journal', 'Hope Journal', '✍️', {    tint: '#c2558c', bg: '#fce9f4',    greet: (m) => `Hope Journal. You are ${vidyaMoodWord(m)} — writing one honest line beats writing a perfect page.`,    ask: ['What is one small thing that went better today than yesterday?', 'Who helped you this week, even quietly?', 'What did you get right that you are not giving credit for?'],    follow: ['What made that moment possible?', 'What would you repeat tomorrow?', 'What are you quietly proud of this month?'],    steps: ['Write one win, however small', 'Name the person who made it possible', 'Read it back at the end of the week'],    suggest: [{ t: 'Write today\u2019s win', q: 'Help me write down one thing that went well today' }, { t: 'Review my week', q: 'Read back what I have written this week' }, { t: 'Talk it through', q: 'I feel low and I want to talk about it' }],  }),  circle: vidyaCtx('circle', 'Trusted Circle', '🤝', {    tint: '#2f9c86', bg: '#e2f4f6',    greet: (m) => `Your Trusted Circle. You are ${vidyaMoodWord(m)} — you do not have to reach everyone, just one person well.`,    ask: ['Who is the one person you could text honestly today?', 'What would you want to say to them?', 'What has stopped you reaching out before?'],    follow: ['What are you afraid will happen if you tell them?', 'Who has never let you down?', 'What is the smallest message you could send?'],    steps: ['Send one honest message today', 'Ask for a specific time, not a vague one', 'Notice who answers — that tells you something'],    suggest: [{ t: 'Decide who to tell', q: 'Help me choose who to open up to' }, { t: 'Write the message', q: 'Help me write what I want to say to them' }, { t: 'Talk it through', q: 'I feel alone and do not know who to tell' }],  }),  timeline: vidyaCtx('timeline', 'Life Timeline', '🌱', {    tint: '#8a5ce0', bg: '#ece6ff',    greet: (m) => `Your journey so far. You are ${vidyaMoodWord(m)} — from where you are, the last few months look better than they feel.`,    ask: ['What is one thing you can do now that you could not a year ago?', 'Which moment from this year would you keep?', 'What is one milestone you want next?'],    follow: ['What did that milestone cost you?', 'What did it teach you about how you work?', 'What is the next smallest step towards it?'],    steps: ['Write one milestone you reached this year', 'Mark the next one with a date', 'Tell one person about it so it counts twice'],    suggest: [{ t: 'See what I achieved', q: 'Show me what I have already achieved so far' }, { t: 'Set the next milestone', q: 'Help me set my next milestone' }, { t: 'Talk it through', q: 'I cannot see my own progress at all' }],  }),  suggestions: vidyaCtx('suggestions', 'Smart Suggestions', '💡', {    tint: '#d1683f', bg: '#fdece2',    greet: (m) => `Small steps for right now. You are ${vidyaMoodWord(m)}, so let us pick one thing rather than five.`,    ask: ['What is the single thing you could finish in fifteen minutes?', 'What are you avoiding that would take one message?', 'What would make tonight feel lighter?'],    follow: ['Which of those is genuinely possible today?', 'What is stopping you from starting it?', 'Shall we make it even smaller?'],    steps: ['Take a 5-minute Calm Mode break', 'Log one thing that went well', 'Run one 25-minute focus block'],    suggest: [{ t: 'Take a break', q: 'Give me a five-minute calming break' }, { t: 'Log a win', q: 'Help me note one win from today' }, { t: 'Start a focus block', q: 'Set me up with one 25-minute focus block' }],  }),};/* Builds a human-sounding turn: reflect what was said, answer it, then ask the   next unanswered question from the active context. */const vidyaReply = (ctx, userText, history) => {  const intent = vidyaIntent(userText);  if (intent === 'crisis') {    return {      reply: 'I am really glad you told me, and I am not going anywhere. What you are feeling is very serious, and you deserve support from a person who can be with you in it — not just on a screen. Please reach the campus counsellor or call iCall at 9152987821 (Mon–Sat, 8am–10pm), or your emergency contact, right now. Are you safe at the moment?',      crisis: true,      plan: ['Call iCall 9152987821 or the campus counsellor now', 'Stay with a friend or a family member you trust', 'Put distance between yourself and anything you could use to harm yourself'],    };  }  const turns = history.filter((m) => m.role === 'user').length;  const listen = VIDYA_LISTEN[intent] || VIDYA_LISTEN.open;  const opener = listen[turns % listen.length];  const echo = vidyaEcho(userText);  const asks = [...ctx.ask, ...ctx.follow];  const next = asks[Math.min(turns, asks.length - 1)];  const mid = turns > 0 && turns < ctx.ask.length    ? (echo ? `When you say "${echo}", I can see why that lands hard. ` : '')      + ctx.steps[turns % ctx.steps.length]    : ctx.steps[turns % ctx.steps.length];  return {    reply: `${opener} ${mid} ${turns < ctx.ask.length ? next : ctx.follow[turns % ctx.follow.length]}`,    plan: turns >= ctx.ask.length ? ctx.steps.slice(0, 3) : null,    intent,  };};/* Chooses the device voice for VIDYA in strict tiers, so Indian English always   wins among the female voices and a masculine voice is never selected while   any female voice exists: Indian female > female > Indian male > anything.   Pure function — no DOM — so the same selection can be reused by a server-side   or Web-Audio TTS layer later. */const pickPersonaVoice = (voices) => {  const FEMALE = /(female|woman|girl|swara|aditi|raveena|neerja|nisha|asha|heera|lekha|zira|aria|jenny|victoria|sonia|moira|tessa|samantha|nova|serena)/i;  const MALE = /(male|man\b|ravi|david|mark|george|daniel|alex|fred|thomas|hemant|madhur|guy)/i;  const isIndian = (v) => {    const l = (v.lang || '').replace('_', '-').toLowerCase();    return l === 'en-in' || /india|indian/i.test(`${v.name || ''} ${v.voiceURI || ''}`);  };  const isFemale = (v) => FEMALE.test(v.name || '') && !MALE.test(v.name || '');  const isPreferred = (v) => VIDYA.voice.preferredVoices.some(p => (v.name || '').toLowerCase().includes(p.toLowerCase()));  const tier = (v) => {    const female = isFemale(v), indian = isIndian(v), preferred = isPreferred(v);    if (female && indian) return preferred ? 0 : 1;  // best: Indian English, female    if (female) return preferred ? 2 : 3;            // female elsewhere    if (indian) return 4;                            // only when no female voice exists at all    return 5;  };  if (!Array.isArray(voices) || !voices.length) return null;  return voices.slice().sort((a, b) => (tier(a) - tier(b)) || (a.localService === b.localService ? 0 : (a.localService ? -1 : 1)))[0] || null;};const subjects = [  { name: "Engineering Mathematics-I", code: "MAT-I", icon: "∑", color: "blue", progress: 62, status: "On track" },  { name: "Engineering Physics", code: "PHY-I", icon: "⚛", color: "yellow", progress: 72, status: "Improving" },  { name: "Introduction to AI", code: "AI-I", icon: "✦", color: "violet", progress: 68, status: "Good" },  { name: "Programming for Problem Solving (PPS)", code: "PPS-I", icon: "</>", color: "green", progress: 74, status: "Good" },  { name: "Basic Electrical & Electronics Engineering", code: "BEEE-I", icon: "ϟ", color: "teal", progress: 65, status: "Improving" },  { name: "Universal Human Values", code: "UHV-I", icon: "♡", color: "pink", progress: 80, status: "Strong" },];const facultyDirectory = [  { id: "FAC-CSE-DK", name: "Dhirendra Kumar", department: "Computer Science & Engineering", designation: "Assistant Professor", subjects: ["Introduction to AI", "Programming for Problem Solving (PPS)"], short: "DK" },  { id: "FAC-AH-AKJ", name: "Anand Kumar Jha", department: "Applied Science & Humanities", designation: "Assistant Professor", subjects: ["Engineering Mathematics-I"], short: "AKJ" },  { id: "FAC-AH-AK", name: "Anand Kamal", department: "Computer Science & Engineering", designation: "Assistant Professor", subjects: [], short: "AK" },  { id: "FAC-AH-AVJ", name: "Avinash Kumar Jha", department: "Applied Science & Humanities", designation: "Assistant Professor", subjects: ["Engineering Physics"], short: "AKJ" },  { id: "FAC-EE-PK", name: "Poonam Kumari", department: "Electrical Engineering", designation: "Assistant Professor", subjects: ["Basic Electrical & Electronics Engineering (BEEE)"], short: "PK" },  { id: "FAC-AH-RKJ", name: "Rajeev Kumar Jha", department: "Applied Science & Humanities", designation: "Faculty", subjects: ["Universal Human Values"], short: "RKJ" },  { id: "FAC-AH-CKJ", name: "Chandan Kumar Jha", department: "Applied Science & Humanities", designation: "Assistant Professor • Chemistry", subjects: [], short: "CKJ" },  { id: "FAC-CE-SK", name: "Sumit Kumar", department: "Civil Engineering", designation: "Assistant Professor", subjects: [], short: "SK" },];const beu2026Curriculum = [  ["Engineering Mathematics-I", "3 credits"],  ["Engineering Physics", "3 credits"],  ["Introduction to AI", "3 credits"],  ["Computer Fundamentals & Emerging Technology", "3 credits"],  ["Universal Human Values", "2 credits"],  ["Essence of Indian Constitution", "2 credits"],  ["Basic Electrical & Electronics Engineering (BEEE)", "3 credits"],];const assignments = [  { title: "EM Assignment 2", subject: "Engineering Mathematics", deadline: "Sep 22", status: "Pending" },  { title: "Physics Lab Record", subject: "Engineering Physics", deadline: "Sep 24", status: "Pending" },  { title: "Programming Quiz", subject: "Programming", deadline: "Sep 26", status: "Upcoming" },  { title: "Chemistry Assignment", subject: "Chemistry", deadline: "Sep 28", status: "Upcoming" },  { title: "Engineering Graphics Submission", subject: "Engineering Graphics", deadline: "Oct 02", status: "Upcoming" },];const resources = [  { title: "Module 1 Lecture Notes", type: "Notes", subject: "Programming", size: "2.4 MB" },  { title: "Module 2 Important Questions", type: "PYQ", subject: "Engineering Mathematics", size: "1.1 MB" },  { title: "Unit 3 Revision PPT", type: "PPT", subject: "Engineering Physics", size: "3.8 MB" },  { title: "Module 1 Recorded Lecture", type: "Lecture", subject: "Basic Electrical", size: "Video" },];const FACULTY_V16 = {  semesters: ['Semester I', 'Semester II', 'Semester III', 'Semester IV'],  conceptCatalog: {    'Introduction to AI': ['Search & State Space', 'Heuristics & Informed Search', 'Knowledge Representation', 'Planning & Reasoning'],    'Programming for Problem Solving (PPS)': ['Pointers & Arrays', 'Functions & Recursion', 'Structures & File I/O', 'Dynamic Memory'],    'Engineering Mathematics-I': ['Matrices & Determinants', 'Complex Numbers', 'Linear Programming', 'Probability Distributions'],  },  fallbackConcepts: ['Core Theory', 'Numerical Practice', 'Problem Solving', 'Applied Revision'],  parentChannels: ['SMS', 'Email', 'Portal Update'],  riskBands: [    { key: 'high', label: 'High Risk', color: '#e5484d' },    { key: 'at', label: 'At Risk', color: '#f76b15' },    { key: 'support', label: 'Needs Support', color: '#f5c518' },    { key: 'track', label: 'On Track', color: '#30a46c' },  ],};const CR_V16 = {  storeKey: 'CR Class Events',  issueCategories: ['Academic', 'Infrastructure', 'Hostel', 'Examination', 'Fees', 'Other'],  eventTypes: ['Class Event', 'Deadline', 'Workshop', 'Meeting', 'Trip', 'Exam'],  issueStatuses: ['Open', 'In Progress', 'Resolved'],  // Deterministic pseudonym so the CR can thread a reply without seeing who raised it.  mask: (id) => `Anonymous · ${String(id).slice(-4).toUpperCase().padStart(4, '0')}`,};const API = "";async function api(path, options = {}) {  const response = await fetch(`${API}${path}`, {    headers: { "Content-Type": "application/json", ...(options.headers || {}) },    ...options,  });  const payload = await response.json().catch(() => ({}));  if (!response.ok) throw new Error(payload.error || "Request failed");  return payload;}/* Semester span for the faculty analytics bar graph. Each semester keeps its own   colour so the eight columns are readable at a glance; semesters without a   cohort record yet are rendered as empty tracks, never as invented numbers. */const FACULTY_SEM_SPAN = [  { sem: 'Semester I', short: 'S1', color: '#2f6bf6' },  { sem: 'Semester II', short: 'S2', color: '#4b53e0' },  { sem: 'Semester III', short: 'S3', color: '#7443dd' },  { sem: 'Semester IV', short: 'S4', color: '#9c3fd0' },  { sem: 'Semester V', short: 'S5', color: '#c93fb0' },  { sem: 'Semester VI', short: 'S6', color: '#e14a83' },  { sem: 'Semester VII', short: 'S7', color: '#e2663c' },  { sem: 'Semester VIII', short: 'S8', color: '#1c9a5c' },];/* Semester-I weekly grid. Every row names an index into the backend   /api/schedules records (0 Maths, 1 Physics, 2 AI, 3 PPS, 4 BEEE, 5 UHV), so the   subject, faculty and room on every card come straight from stored data. */const FACULTY_WEEK_GRID = [  [3, 1, 2, 4], // Mon — PPS, Physics, AI, BEEE  [0, 3, 1, 2], // Tue — Maths, PPS, Physics, AI  [2, 4, 0, 3], // Wed — AI, BEEE, Maths, PPS  [1, 4, 2, 0], // Thu — Physics, BEEE, AI, Maths  [3, 0, 1, 4], // Fri — PPS, Maths, Physics, BEEE  [2, 5, 3, 2], // Sat — AI, UHV, PPS];const FACULTY_PERIOD = 55; // teaching minutes per periodconst facultyTimeToMinutes = (t) => {  const m = /(\d{1,2}):(\d{2})\s*(AM|PM)/i.exec(String(t || ''));  if (!m) return null;  let h = Number(m[1]) % 12;  if (/pm/i.test(m[3])) h += 12;  return h * 60 + Number(m[2]);};const facultyMinutesToTime = (mins) => {  const h24 = Math.floor(mins / 60) % 24;  const m = mins % 60;  const suffix = h24 >= 12 ? 'PM' : 'AM';  const h12 = h24 % 12 === 0 ? 12 : h24 % 12;  return `${String(h12).padStart(2, '0')}:${String(m).padStart(2, '0')} ${suffix}`;};const dayKeyOf = (d) => `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;const roleOptions = [  { id: "Student", icon: "🎓", tone: "student", detail: "Notes, PYQs, assignments and AI study tools" },  { id: "Faculty", icon: "👨‍🏫", tone: "faculty", detail: "Classes, resources and student insights" },  { id: "CR", icon: "👤", tone: "cr", detail: "Announcements and class coordination" },];/* ============================================================================   AI Viva Simulator — subjective-only question deck + instant evaluator.   Multiple-choice has been removed: every question is a descriptive answer the   student types or speaks, and the AI Analysis reports concept coverage, depth   and presentation instead of a letter grade. The viva endpoints expose only   question text (no answer key), so the simulator carries its own deck. Every   submitted answer is still persisted through the existing   /api/student-dashboard/viva/evaluate endpoint — no backend change. The mic   uses the browser Web Speech API via startSpeechCapture (Speech-to-Text) and   TTS "hear it" playback uses speakText.   ========================================================================== */const vivaNormalize = (t) => String(t || "").toLowerCase().replace(/[^a-z0-9\s]/g, " ");const vivaConceptCovered = (answer, concept) => {  const a = vivaNormalize(answer);  const words = vivaNormalize(concept).split(/\s+/).filter((w) => w.length > 2);  return words.length ? words.every((w) => a.includes(w)) : false;};/* Sentence-split + word count so the evaluator can judge depth, not just keywords. */const vivaWords = (t) => vivaNormalize(t).split(/\s+/).filter(Boolean);const vivaSentences = (t) => String(t || "").split(/[.!?]+/).map((s) => s.trim()).filter((s) => s.length > 12);/* Markers of a well-rounded viva answer: an opening definition, a worked example   and a cause/effect or contrast statement. Each earns a presentation point. */const vivaMarkers = {  definition: /\b(is|are|means|refers to|defined as|can be described as)\b/,  example: /\b(for example|for instance|e\.g\.|such as|consider|suppose|take the case|think of)\b/,  contrast: /\b(however|whereas|while|unlike|instead|because|since|therefore|as a result|leads to|so that)\b/,  application: /\b(used in|applied|real[- ]world|in industry|in our|in day[- ]to[- ]day|helps us|allows us)\b/,};/* Subjective-only evaluator. Returns   { correct, score/10, verdict, band, covered[], conceptMistakes[], strengths[],     correctAnswer, tips[3], stats{words,sentences,coverage,markers} }.   Scoring is deterministic and client-side: concept coverage carries 7 marks and   the remaining 3 come from structure (definition, example, application). */const evaluateViva = (item, answerText) => {  const text = String(answerText || "").trim();  const words = vivaWords(text);  const sentences = vivaSentences(text);  const covered = (item.concepts || []).filter((c) => vivaConceptCovered(text, c));  const missed = (item.concepts || []).filter((c) => !vivaConceptCovered(text, c));  const total = (item.concepts || []).length || 1;  const coverage = covered.length / total;  const flat = vivaNormalize(text);  const hits = Object.keys(vivaMarkers).filter((k) => vivaMarkers[k].test(flat));  let score = coverage * 7;  if (hits.includes("definition")) score += 1;  if (hits.includes("example")) score += 1;  if (hits.includes("application") || hits.includes("contrast")) score += 0.5;  if (words.length < 25) score = Math.min(score, 4);   // a fragment is not a viva answer  else if (words.length > 55) score += 0.5;            // real depth, when the concepts hold  score = Math.max(0, Math.min(10, Math.round(score * 10) / 10));  const correct = score >= 7;  const band = score >= 9 ? "Excellent" : score >= 7 ? "Good" : score >= 5 ? "Partial" : "Needs work";  const strengths = [];  if (covered.length) strengths.push(`Covered ${covered.length} of ${total} examiner concepts${hits.includes("definition") ? ", and opened with a definition" : ""}.`);  if (hits.includes("example")) strengths.push("You supported the idea with a real example — examiners always listen for one.");  if (hits.includes("contrast") || hits.includes("application")) strengths.push("You explained why it matters, not just what it is.");  const conceptMistakes = missed.length    ? missed.map((m) => `Not covered: ${m}.`)    : ["No concept gaps — every examiner concept is present in your answer."];  if (words.length < 25) conceptMistakes.push("Answer is too short for a viva — aim for at least 25 spoken words.");  const tips = [];  if (missed.length) tips.push(`Add the missing idea${missed.length > 1 ? "s" : ""}: ${missed.slice(0, 2).join("; ")}.`);  if (!hits.includes("definition")) tips.push("Open with a one-line definition, then expand it.");  if (!hits.includes("example")) tips.push("Add one concrete example to make the answer exam-ready.");  if (!tips.length) tips.push("Tighten the wording and lead with the single most important idea.");  tips.push("Rehearse this answer aloud in under 40 seconds.");  tips.length = 3;  return {    correct, score, band,    verdict: correct ? "Strong answer" : score >= 5 ? "Partially correct" : "Needs revision",    covered, conceptMistakes, strengths,    correctAnswer: item.ideal,    tips,    stats: { words: words.length, sentences: sentences.length, coverage: Math.round(coverage * 100), markers: hits },  };};/* ============================================================================   Subjective-only viva deck. Every item is a spoken/typed descriptive answer   with an ideal response and the concept phrases an examiner listens for, so   the AI Analysis can report real concept gaps instead of a letter grade.   ========================================================================== */const VIVA_DECK = {  "Programming for Problem Solving (PPS)": [    { type: "subjective", topic: "Recursion", question: "Explain what a recursive function is and give one example from day-to-day programming.", ideal: "A recursive function is a function that calls itself to solve a smaller version of the same problem, and it stops when a base case is reached. Example: factorial(n) returns 1 when n is 0 or 1, otherwise it returns n multiplied by factorial(n-1).", concepts: ["calls itself", "base case", "smaller problem"] },    { type: "subjective", topic: "Data Structures", question: "Differentiate between an array and a linked list, and state where you would prefer each one.", ideal: "An array stores elements in contiguous memory and gives O(1) index access, while a linked list stores nodes joined by pointers and gives O(n) access but cheap insertion. For example, use an array for fast random lookup and a linked list when frequent insertion and deletion are needed.", concepts: ["contiguous memory", "pointer", "O(1)", "insertion"] },    { type: "subjective", topic: "Complexity", question: "What is time complexity, and why is binary search faster than linear search?", ideal: "Time complexity measures how the running time of an algorithm grows with the input size. Binary search repeatedly halves the search range, so it takes O(log n) steps, whereas linear search checks every element and takes O(n). For example, finding a name in a sorted list of a million records is far quicker with binary search.", concepts: ["how the running time", "input size", "halves the search range", "O(log n)"] },    { type: "subjective", topic: "Strings", question: "Explain the difference between a string and a character array, and where each is used.", ideal: "A string is a built-in type that stores text and carries helper functions such as length and substring, while a character array is a raw fixed-size sequence of characters. For example, user input is handled as a string, while low-level buffers use character arrays.", concepts: ["built-in type", "text", "character array", "raw"] },    { type: "subjective", topic: "Error Handling", question: "Why is error handling important in a program, and how would you handle a divide-by-zero case?", ideal: "Error handling keeps a program from crashing on unexpected input and makes failures understandable. For example, before dividing you check whether the denominator is zero and report a clear message instead of letting the program terminate.", concepts: ["crashing", "unexpected input", "denominator is zero", "clear message"] },  ],  "Introduction to AI": [    { type: "subjective", topic: "Heuristics", question: "What is a heuristic, and why is it used in search-based problems?", ideal: "A heuristic is an admissible estimate of the cost of reaching the goal from a given state. It is used to prune the search space so the agent does not explore every branch. For example, greedy best-first search always expands the node that appears closest to the goal.", concepts: ["estimate of the cost", "reaching the goal", "prunes the search space", "closest to the goal"] },    { type: "subjective", topic: "Machine Learning", question: "Explain the difference between supervised and unsupervised learning with one example of each.", ideal: "Supervised learning trains a model on labelled data to predict an output, for example classifying an email as spam. Unsupervised learning finds structure in unlabelled data, for example grouping customers by buying behaviour. Therefore the first needs correct answers while the second discovers them.", concepts: ["labelled data", "unlabelled data", "predict", "grouping customers"] },    { type: "subjective", topic: "Search", question: "Differentiate between breadth-first search and depth-first search, and name one situation where each is better.", ideal: "Breadth-first search explores all nodes of one level before going deeper and needs memory, while depth-first search follows one branch as far as possible and uses less memory. For example, BFS is better for shortest path on an unweighted graph, whereas DFS suits puzzles where a complete search of a branch matters.", concepts: ["one level before going deeper", "one branch as far as possible", "less memory", "shortest path"] },    { type: "subjective", topic: "Planning", question: "What is planning in artificial intelligence, and what are its main components?", ideal: "Planning is deciding a sequence of actions that moves an agent from an initial state to a goal state. Its main components are the state, the action set and the heuristic or cost function used to choose the best sequence. For example, a robot planning a route between rooms uses these three parts.", concepts: ["sequence of actions", "initial state", "goal state", "action set"] },    { type: "subjective", topic: "Knowledge Representation", question: "Why do we represent knowledge in a form an AI agent can use, and name two common representations.", ideal: "Knowledge must be stored in a structured form so the agent can reason over it rather than read raw text. Two common representations are production rules and semantic networks, where each fact connects to related facts. Therefore representation directly affects the quality of reasoning.", concepts: ["structured form", "reason over it", "production rules", "semantic networks"] },  ],  "Engineering Physics": [    { type: "subjective", topic: "Photoelectric Effect", question: "What is the photoelectric effect, and what does Einstein's equation state?", ideal: "The photoelectric effect is the emission of electrons from a metal surface when light of sufficient frequency falls on it. Einstein's equation K = hf − phi states that the maximum kinetic energy of the emitted electron depends on the frequency of light and the work function of the metal, so above a threshold frequency electrons are emitted.", concepts: ["emission of electrons", "metal surface", "frequency", "work function"] },    { type: "subjective", topic: "Uncertainty", question: "State and explain Heisenberg's uncertainty principle with its practical meaning.", ideal: "The uncertainty principle states that the exact position and the exact momentum of a particle cannot be measured simultaneously; the product of their uncertainties is at least h divided by four pi. Practically, a particle with a known position behaves like a wave with a large momentum spread, so measurement itself disturbs the system.", concepts: ["exact position", "exact momentum", "at least", "measurement"] },    { type: "subjective", topic: "Oscillations", question: "What is simple harmonic motion, and how are amplitude and frequency related to its energy?", ideal: "Simple harmonic motion is periodic oscillation in which the restoring force is proportional to displacement and opposite in direction, so the motion is sinusoidal. The energy is proportional to the square of the amplitude, while frequency decides how many oscillations occur each second. For example, a spring-mass system shows this behaviour.", concepts: ["restoring force", "proportional to displacement", "sinusoidal", "square of the amplitude"] },    { type: "subjective", topic: "Electromagnetism", question: "Define magnetic flux and explain how Faraday's law uses it to produce induced emf.", ideal: "Magnetic flux is the product of magnetic field strength and the area perpendicular to the field, measured in webers. According to Faraday's law the induced emf equals the rate of change of magnetic flux, so a changing flux drives a current. For example, a magnet moved into a coil induces a current.", concepts: ["magnetic field", "area perpendicular", "rate of change", "induced emf"] },    { type: "subjective", topic: "Optics", question: "Differentiate between constructive and destructive interference of light.", ideal: "Constructive interference occurs when two waves meet with the same phase, so the amplitudes add and the resultant intensity increases. Destructive interference occurs when the waves are out of phase, so the amplitudes cancel and intensity decreases. For example, a bright fringe is constructive and a dark fringe is destructive.", concepts: ["same phase", "amplitudes add", "out of phase", "cancel"] },  ],  "Basic Electrical & Electronics Engineering (BEEE)": [    { type: "subjective", topic: "Ohm's Law", question: "Explain Ohm's law and state its limitations.", ideal: "Ohm's law states that for an ohmic conductor at constant temperature the current is directly proportional to the voltage and inversely proportional to the resistance, so V equals IR. It is limited because it fails for non-ohmic devices such as diodes and for temperature-dependent resistors, where resistance changes with current.", concepts: ["directly proportional to the voltage", "inversely proportional to the resistance", "constant temperature", "non-ohmic"] },    { type: "subjective", topic: "Rectifiers", question: "What is a half-wave rectifier and what is its main drawback?", ideal: "A half-wave rectifier converts an alternating current into a direct current using a single diode, so it passes only one half cycle of the waveform. Its main drawback is that the other half cycle is wasted, which gives a poor ripple factor and low rectification efficiency. A full-wave rectifier using two diodes avoids this.", concepts: ["alternating current", "single diode", "one half cycle", "ripple factor"] },    { type: "subjective", topic: "Kirchhoff's Laws", question: "State Kirchhoff's current and voltage laws and explain what each one is based on.", ideal: "Kirchhoff's current law states that the algebraic sum of currents at a node is zero, which is based on conservation of charge. Kirchhoff's voltage law states that the algebraic sum of voltages around a closed loop is zero, which is based on conservation of energy. Therefore they are used to solve multi-loop circuits.", concepts: ["sum of currents", "node", "conservation of charge", "closed loop"] },    { type: "subjective", topic: "Capacitance", question: "Define capacitance and explain the time constant of an RC circuit.", ideal: "Capacitance is the property of a capacitor by which it stores charge, equal to charge divided by potential difference, and its unit is the farad. In an RC circuit the time constant is the product of resistance and capacitance, and it decides how quickly the capacitor charges or discharges. A larger time constant means a slower response.", concepts: ["stores charge", "potential difference", "resistance and capacitance", "charges or discharges"] },    { type: "subjective", topic: "Transistors", question: "What is a transistor and why is it called the basic building block of electronics?", ideal: "A transistor is a three-terminal semiconductor device that can act as a switch or amplify a signal using a very small base current. Because one small control signal controls a much larger current between collector and emitter, millions of transistors can be combined into integrated circuits. Therefore it is the basic building block of all modern electronics.", concepts: ["three-terminal", "amplify", "control", "integrated circuits"] },  ],  "Engineering Mathematics-I": [    { type: "subjective", topic: "Differential Equations", question: "Define a differential equation and determine the order of the equation dy/dx + y = 0.", ideal: "A differential equation is a relation that involves a function and one or more of its derivatives. The order is the order of the highest derivative present, so the equation dy/dx + y = 0 is a first order ordinary differential equation because the first derivative is the highest one appearing.", concepts: ["relation", "function", "derivatives", "highest derivative"] },    { type: "subjective", topic: "Calculus", question: "State the Fundamental Theorem of Calculus in simple terms and give its two parts.", ideal: "The Fundamental Theorem of Calculus states that differentiation and integration are inverse operations. Its first part says the derivative of an integral of a continuous function is that function, and its second part says the definite integral of a continuous function equals the net change of its antiderivative. Therefore the area under a curve equals the difference of its endpoints.", concepts: ["inverse operations", "derivative of an integral", "definite integral", "net change"] },    { type: "subjective", topic: "Matrices", question: "What is a determinant, and what does a zero determinant tell you about a matrix?", ideal: "The determinant of a square matrix is a scalar computed from its elements, and it is non-zero only if the matrix is invertible. A zero determinant means the rows are linearly dependent, so the matrix is singular and the system of equations has either no unique solution. For example, a matrix with two identical rows always has a zero determinant.", concepts: ["scalar computed from its elements", "invertible", "linearly dependent", "singular"] },    { type: "subjective", topic: "Matrices", question: "Explain how Cramer's rule solves a system of linear equations, and state its condition.", ideal: "Cramer's rule solves a linear system by replacing one column of the coefficient matrix with the constants and dividing the resulting determinant by the determinant of the original matrix. It gives the value of each unknown variable directly as a ratio of determinants. The condition is that the determinant of the coefficient matrix must be non-zero.", concepts: ["replacing one column", "determinant", "directly", "non-zero"] },    { type: "subjective", topic: "Probability", question: "Differentiate between probability and probability density, and give an example of each.", ideal: "Probability of a single value in a discrete random variable is a dimensionless number between zero and one, for example the probability of getting a six on a die. Probability density is a rate used for a continuous random variable, and its value must be integrated over an interval to get a probability. Therefore density alone cannot be read as a probability.", concepts: ["discrete", "between zero and one", "rate", "continuous"] },  ],  "Universal Human Values": [    { type: "subjective", topic: "Empathy", question: "Why is empathy an important value in a student team, and how would you practise it?", ideal: "Empathy helps a team understand different viewpoints and resolve conflicts respectfully instead of escalating them. Practising it means listening actively, assuming good intent before reacting, and checking your own assumptions. For example, repeating back what a classmate said before replying prevents most team arguments.", concepts: ["different viewpoints", "resolve conflicts", "listening actively", "assumptions"] },    { type: "subjective", topic: "Integrity", question: "Explain why integrity matters in engineering work, with one real example.", ideal: "Engineering decisions affect public safety and public trust, so integrity means reporting results honestly and refusing to compromise on quality even under deadline pressure. For example, a bridge engineer who reports a small crack instead of hiding it prevents a much larger failure. Therefore integrity is a professional duty, not only a personal trait.", concepts: ["public safety", "trust", "reporting results honestly", "quality"] },    { type: "subjective", topic: "Teamwork", question: "What makes a team work well, and how can you contribute to it?", ideal: "A team works well when responsibilities are clear, communication is honest and every member is willing to carry shared work. Each member can contribute by taking ownership of one clear task and by raising risks early rather than at the deadline. Therefore cooperation is a practice, not only a personal quality.", concepts: ["responsibilities are clear", "communication", "shared work", "risks early"] },    { type: "subjective", topic: "Responsibility", question: "Differentiate between responsibility and accountability in a professional setting.", ideal: "Responsibility is the duty you accept for a piece of work, while accountability is the obligation to answer for its outcome when something goes wrong. For example, a student is responsible for submitting an assignment on time and accountable for the quality of the submitted work. Therefore every responsibility eventually becomes an accountability.", concepts: ["duty", "accept", "obligation to answer", "outcome"] },    { type: "subjective", topic: "Cooperation", question: "How does cooperation differ from competition, and why is cooperation valued in engineering?", ideal: "Cooperation means people work towards a shared goal by combining their effort, while competition means each person tries to do better than the others. Engineering projects need cooperation because a single design must satisfy safety, cost and time together, and no single expert holds every answer. Therefore cooperation is treated as a core professional value.", concepts: ["shared goal", "combining", "safety", "no single expert"] },  ],};/* ============================================================================   Premium page shell. Every feature (Student, Faculty and CR) renders through   this so each one opens as its own full page: a colourful gradient header, a   breadcrumb with working back-navigation, live stat chips taken from real   backend/state data, and the feature body below. The header colours come from   a fixed tone table so a page keeps the same identity every time it is opened.   ========================================================================== */const PREMIUM_TONES = {  blue:   { from: "#2f6bf6", to: "#5b8cff", soft: "#eef3ff" },  violet: { from: "#6d43e8", to: "#a06bf5", soft: "#f3edff" },  indigo: { from: "#3f4bd8", to: "#7a6cf0", soft: "#eef0ff" },  teal:   { from: "#0f9c8c", to: "#3fc9a8", soft: "#e8faf5" },  green:  { from: "#1c9a5c", to: "#57c98a", soft: "#eafaf1" },  amber:  { from: "#e08a11", to: "#f5b83d", soft: "#fff6e6" },  orange: { from: "#e2611f", to: "#f79a4a", soft: "#fff1e6" },  rose:   { from: "#d33f76", to: "#f2779f", soft: "#ffeef4" },  cyan:   { from: "#0d8fb8", to: "#45c2e0", soft: "#e8f7fc" },  crimson:{ from: "#d63a45", to: "#f2726f", soft: "#ffecec" },};const premiumTone = (tone) => PREMIUM_TONES[tone] || PREMIUM_TONES.blue;function PremiumPage({  tone = "blue", icon, eyebrow, title, subtitle, badge, breadcrumb,  onBack, backLabel = "Back", chips = [], actions, children,}) {  const t = premiumTone(tone);  return (    <div className="px-page" style={{ "--px-from": t.from, "--px-to": t.to, "--px-soft": t.soft }}>      <header className="px-hero">        <div className="px-hero-bar">          <button className="px-back" onClick={onBack} disabled={!onBack} aria-label={backLabel}>← {backLabel}</button>          {breadcrumb && <span className="px-crumb">{breadcrumb}</span>}        </div>        <div className="px-hero-main">          <span className="px-icon" aria-hidden="true">{icon}</span>          <div className="px-hero-copy">            <span className="px-eyebrow">{eyebrow}</span>            <h1>{title}</h1>            {subtitle && <p>{subtitle}</p>}          </div>          {badge && <span className="px-badge">{badge}</span>}        </div>        {chips.length > 0 && (          <div className="px-chips">            {chips.map((c) => (              <div className="px-chip" key={c.label}>                <span>{c.label}</span>                <b>{c.value}</b>                {c.note && <em>{c.note}</em>}              </div>            ))}          </div>        )}      </header>      {actions && <div className="px-actions">{actions}</div>}      <div className="px-body">{children}</div>    </div>  );}/* One shared rail for all three dashboards. Every item that already has a card,   panel or module on the current page was removed, so the rail carries only what   is genuinely navigation. Routing is untouched: each item calls the same   handlers the old per-role sidebars used. */function RailNav({ role, tagline, user, items, onSettings, onSignOut }) {  return (    <aside className="uni-rail" data-role={role}>      <div className="uni-rail-brand">        <div className="uni-rail-cap">◆</div>        <div><strong>CampusLMS</strong><span>{tagline}</span></div>      </div>      <div className="uni-rail-profile">        <span className="uni-rail-avatar">{user.initials}</span>        <div><strong>{user.name}</strong><small>{user.sub}</small></div>      </div>      <nav className="uni-rail-nav">        {items.map((it) => (          <button key={it.label} className={`uni-rail-item ${it.active ? 'active' : ''}`} onClick={it.onClick}>            <span className="uni-rail-ic">{it.icon}</span>            <b>{it.label}</b>          </button>        ))}      </nav>      <div className="uni-rail-foot">        <button className="uni-rail-item" onClick={onSettings}><span className="uni-rail-ic">⚙</span><b>Settings</b></button>        <button className="uni-rail-item signout" onClick={onSignOut}><span className="uni-rail-ic">↪</span><b>Sign Out</b></button>      </div>    </aside>  );}/* The minimal menu every role shares. Only Placement & Career is student-only.   `openPage` and `onSearch` are the caller's own existing handlers, so nothing   about routing changes. */const railItems = (role, { active, moduleOpen, openPage, onSearch }) => {  const student = role === 'Student';  const item = (label, icon, target, onClick) => ({    label, icon, active: Boolean(target) && active === target, onClick,  });  return [    item('Dashboard', '⌂', 'Dashboard', () => openPage('Dashboard')),    { label: 'Smart Search', icon: '⌕', active: active === 'Resources', onClick: onSearch },    item('Community', '♟', 'Community', () => openPage('Community')),    ...(student ? [item('Placement & Career', '🚀', 'Placement & Career Hub', () => openPage('Placement & Career Hub'))] : []),    item('Academic Records', '▤', 'Academic Records', () => openPage('Academic Records')),    item('Help & Support', '?', 'Help & Support', () => openPage('Help & Support')),  ].map((i) => (i.label === 'Dashboard' ? { ...i, active: !moduleOpen } : i));};const quickTools = [  ["⏱", "I Have 30 Minutes", "Get a focused study plan", "30-Min Rescue", "purple"],  ["▣", "Exam Tomorrow", "Last-minute revision", "Exam Night Mode", "red"],  ["✦", "AI Summary", "Summarize any topic", "AI Summary", "violet"],  ["🎙", "Practice Viva", "Improve with AI", "AI Viva Simulator", "blue"],  ["↻", "Teach Me Again", "Better explanations", "AI Assistant", "orange"],  ["▥", "Check My Readiness", "See exam readiness", "Exam Readiness", "teal"],];const revisionSubjects = [  { name: "Engineering Mathematics-I", focus: "Integration & differential equations", code: "MAT-I" },  { name: "Programming for Problem Solving (PPS)", focus: "Arrays, functions & file handling", code: "PPS-I" },  { name: "Engineering Physics", focus: "Unit 3 — waves and oscillations", code: "PHY-I" },  { name: "Basic Electrical & Electronics Engineering", focus: "Network theorems and AC circuits", code: "BEEE-I" },  { name: "Introduction to AI", focus: "Search strategies and evaluation", code: "AI-I" },  { name: "Universal Human Values", focus: "Ethics, empathy and teamwork", code: "UHV-I" },];const internshipOpportunities = [  { id: "INT-01", company: "Tata Consultancy Services", role: "Software Engineering Intern", mode: "On-site", duration: "6 months", stipend: "₹25,000 / month", skills: "DSA, C, DBMS", closes: "21 Oct 2026" },  { id: "INT-02", company: "Infosys Springboard", role: "Systems Intern", mode: "Remote", duration: "12 weeks", stipend: "₹15,000 / month", skills: "Python, Linux, Git", closes: "05 Nov 2026" },  { id: "INT-03", company: "Tech Mahindra NextGen", role: "Embedded Software Trainee", mode: "Hybrid", duration: "6 months", stipend: "₹18,000 / month", skills: "C++, Embedded C, RTOS", closes: "30 Nov 2026" },  { id: "INT-04", company: "Deloitte Technology", role: "Data Analyst Intern", mode: "On-site", duration: "8 weeks", stipend: "₹20,000 / month", skills: "SQL, Power BI, Statistics", closes: "18 Dec 2026" },];const aptitudeQuestions = [  { id: "APT-01", section: "Quantitative", question: "A student scores 62, 74 and 80 in three tests. What is the average score?", options: ["70", "72", "74", "76"], answer: "72" },  { id: "APT-02", section: "Logical Reasoning", question: "If all Engineers are Graduates and some Graduates are Coders, which conclusion is valid?", options: ["Some Engineers are Coders", "No Engineer is a Coder", "All Coders are Engineers", "Nothing can be concluded"], answer: "Nothing can be concluded" },  { id: "APT-03", section: "Verbal Ability", question: "Choose the word closest in meaning to 'Meticulous'.", options: ["Careless", "Painstaking", "Rapid", "Generic"], answer: "Painstaking" },  { id: "APT-04", section: "Quantitative", question: "A train covers 240 km in 3 hours. What is its speed?", options: ["60 km/h", "70 km/h", "80 km/h", "90 km/h"], answer: "80 km/h" },  { id: "APT-05", section: "Logical Reasoning", question: "Odd one out: 4, 9, 16, 27, 36", options: ["4", "9", "16", "27"], answer: "27" },];const careerStages = [  { id: "CS-1", stage: "Semester I–II", title: "Build the base", detail: "Strengthen C, Python and Engineering Mathematics. Maintain 75% attendance in every subject.", status: "in-progress" },  { id: "CS-2", stage: "Semester III", title: "Add a specialisation", detail: "Pick one track — full stack, data, embedded or core engineering — and complete two real projects.", status: "next" },  { id: "CS-3", stage: "Semester IV–V", title: "Internships & aptitude", detail: "Apply to internships, clear aptitude rounds and build one internship-grade resume.", status: "locked" },  { id: "CS-4", stage: "Semester VI", title: "Campus placement", detail: "Technical and HR interview prep, portfolio review and referral applications.", status: "locked" },];function App() {  const [role, setRole] = useState("Student");  const [facultyId, setFacultyId] = useState("FAC-CSE-DK");  const [syllabusData, setSyllabusData] = useState(null);  const [vaultData, setVaultData] = useState(null);  const [studentRecord, setStudentRecord] = useState(null);  const [certificates, setCertificates] = useState([]);  const [recordLoaded, setRecordLoaded] = useState(false);  const [certificatesLoaded, setCertificatesLoaded] = useState(false);  const [syllabusOpenCourse, setSyllabusOpenCourse] = useState(null);  const [practiceQuestions, setPracticeQuestions] = useState([]);  const [practiceSubject, setPracticeSubject] = useState('Introduction to AI');  const [practiceIndex, setPracticeIndex] = useState(0);  const [practiceSelected, setPracticeSelected] = useState(null);  const [practiceFeedback, setPracticeFeedback] = useState(null);  const [practiceStats, setPracticeStats] = useState({total:0,correct:0,accuracy:0});  const [practiceLoading, setPracticeLoading] = useState(false);  const [loggedIn, setLoggedIn] = useState(false);  const [active, setActive] = useState("Dashboard");  const [selectedSubject, setSelectedSubject] = useState(null);  const [submitted, setSubmitted] = useState(false);  const [notifications, setNotifications] = useState(5);  const [search, setSearch] = useState("");  const [examMode, setExamMode] = useState(false);  const [dark, setDark] = useState(false);  const [announcement, setAnnouncement] = useState("");  const [announcements, setAnnouncements] = useState([]);  const [serverData, setServerData] = useState(null);  const [facultySemester, setFacultySemester] = useState('Semester I');  const [facultyV16, setFacultyV16] = useState({ rescues: [], parentLog: [], plans: [], drafts: {} });  // Read-only copy of /api/faculty/analytics so the dashboard can show a live  // per-course test average without opening a module page. No backend change.  const [facultyAnalytics, setFacultyAnalytics] = useState(null);  // The faculty dashboard payload carries no `schedules` field, so the timetable  // is read from its own existing GET endpoint. Read-only; backend unchanged.  const [facultyTimetable, setFacultyTimetable] = useState([]);  const [v16Busy, setV16Busy] = useState('');  const [v16Out, setV16Out] = useState('');  const [crEvents, setCrEvents] = useState([]);  const [crLive, setCrLive] = useState({ schedules: [], subjects: [] });  const [crBusy, setCrBusy] = useState('');  const [crOut, setCrOut] = useState('');  const [smartToolsData, setSmartToolsData] = useState(null);  const [toast, setToast] = useState("");  const [workspace, setWorkspace] = useState(null);  const [aiInput, setAiInput] = useState("");  const [aiMessages, setAiMessages] = useState([{ role: "assistant", text: "Hi! I am CampusAI. Ask me about your assignments, subjects, resources, study plan, or exams." }]);  const [workflowStep, setWorkflowStep] = useState(0);  const [readerOpen, setReaderOpen] = useState(false);  const [communityPosts, setCommunityPosts] = useState([]);  const [communityText, setCommunityText] = useState("");  const [voiceListening, setVoiceListening] = useState(false);  const [studentToolState, setStudentToolState] = useState({});  const [pomo, setPomo] = useState({ remaining: 25 * 60, running: false, phase: "focus", focusLength: 25, breakLength: 5, completed: null });  const [aptIndex, setAptIndex] = useState(0);  // Tests & Mocks — a real timed paper built from the backend question bank.  const [mockPaper, setMockPaper] = useState(null);  const [mockPicks, setMockPicks] = useState({});  const [mockIndex, setMockIndex] = useState(0);  const [mockSeconds, setMockSeconds] = useState(10 * 60);  const [mockRunning, setMockRunning] = useState(false);  const [mockResult, setMockResult] = useState(null);  const [mockBusy, setMockBusy] = useState(false);  const [aptPicked, setAptPicked] = useState(null);  const [aptResult, setAptResult] = useState(null);  const [resumeDraft, setResumeDraft] = useState(null);  const [vivaAnswer, setVivaAnswer] = useState('');  const [vivaIndex, setVivaIndex] = useState(0);  const [vivaFeedback, setVivaFeedback] = useState('');  const [toolBusy, setToolBusy] = useState(false);  const [dashboardFeatureBusy, setDashboardFeatureBusy] = useState(false);  const [assignmentPreview, setAssignmentPreview] = useState(null);  const [aiLauncherOpen, setAiLauncherOpen] = useState(false);  const [vivaQuestions, setVivaQuestions] = useState([]);  const [vivaSubject, setVivaSubject] = useState('Programming for Problem Solving (PPS)');  const [vivaListening, setVivaListening] = useState(false);  const [vivaInputMode, setVivaInputMode] = useState('text');  const [vivaResult, setVivaResult] = useState(null); // rich AI analysis for the current question  const [vivaFileName, setVivaFileName] = useState(''); // uploaded answer file, if any  const [mentorInput, setMentorInput] = useState('');  // Inline CampusAI chat for the Faculty/CR module pages, so the AI Assistant  // works from inside the role layout instead of navigating to the student page.  const [roleChat, setRoleChat] = useState([]);  const [roleChatInput, setRoleChatInput] = useState('');  const [roleChatBusy, setRoleChatBusy] = useState(false);  const sendRoleChat = async (preset) => {    const message = (preset || roleChatInput).trim();    if (!message || roleChatBusy) return;    setRoleChatInput('');    setRoleChatBusy(true);    setRoleChat((c) => [...c, { role: 'user', text: message }]);    try {      const r = await api('/api/ai/chat', { method: 'POST', body: JSON.stringify({ role, message, context: { assignments: serverData?.assignments || [], subjects: serverData?.subjects || [], attendance: serverData?.attendance || {} } }) });      setRoleChat((c) => [...c, { role: 'bot', text: r.reply || r.message || r.text || 'CampusAI could not build a reply this time.' }]);    } catch (e) { setRoleChat((c) => [...c, { role: 'bot', text: `CampusAI is unavailable: ${e.message}` }]); }    finally { setRoleChatBusy(false); }  };  const [mentorMessages, setMentorMessages] = useState([]);  const [mentorBusy, setMentorBusy] = useState(false);  // AI Mentorship page UI state (aar- CSS namespace retained) — presentation only, local mock backend.  const [aarMood, setAarMood] = useState(null);  const [aarTool, setAarTool] = useState(AAR_CHAT_TAB);  const [aarCalm, setAarCalm] = useState(false);  const [aarInfo, setAarInfo] = useState(null);  const [aarCalmStep, setAarCalmStep] = useState(0);  const [aarCalmRounds, setAarCalmRounds] = useState(0);  const [aarJournal, setAarJournal] = useState([]);  const [aarDraft, setAarDraft] = useState('');  const [aarRecovery, setAarRecovery] = useState([]);  const [aarCircle, setAarCircle] = useState(null);  const [aarTimeline, setAarTimeline] = useState([]);  const [aarDone, setAarDone] = useState([]);  // Voice mode for the large centre mic button. The ref mirrors the state so the  // speech callbacks (which run outside React) can read the live value.  const [aarVoice, setAarVoice] = useState('off');  const aarVoiceRef = useRef('off');  const setAarVoiceMode = (v) => { aarVoiceRef.current = v; setAarVoice(v); };  // Live transcript of what the student is saying right now, and whether VIDYA  // holds the floor. The recognition handle is kept so the mic can be released  // before her reply is spoken.  const [aarHeard, setAarHeard] = useState('');  const [aarSpeaking, setAarSpeaking] = useState(false);  const aarRecogRef = useRef(null);  // Active VIDYA context, the remembered thread for every other context, and the  // typing indicator that stands in for her thinking.  const [vidyaCtx, setVidyaCtx] = useState('general');  const [vidyaSessions, setVidyaSessions] = useState({});  const [vidyaTyping, setVidyaTyping] = useState(false);  // Upcoming Classes accordion. Today and Tomorrow start open so the next two  // days are visible without any interaction.  const [ucOpen, setUcOpen] = useState({ Today: true, Tomorrow: true, 'Next 7 Days': false });  // Never leave the microphone open in the background: leaving the mentorship  // page releases recognition and silences VIDYA.  useEffect(() => () => {    const live = aarRecogRef.current;    aarRecogRef.current = null;    if (live) { try { live.onend = null; live.stop(); } catch {} }    try { window.speechSynthesis?.cancel(); } catch {}  }, []);  useEffect(() => {    if (!aarCalm) return undefined;    const id = setInterval(() => setAarCalmStep((s) => {      if (s === 3) setAarCalmRounds((r) => r + 1);      return (s + 1) % 4;    }), 2200);    return () => clearInterval(id);  }, [aarCalm]);  const login = async (asRole = role) => {    try {      const result = await api("/api/auth/login", { method: "POST", body: JSON.stringify({ role: asRole, facultyId: asRole === "Faculty" ? facultyId : null }) });      localStorage.setItem("campusLmsToken", result.token);      setServerData(result.user);      setLoggedIn(true);      setRole(asRole);      setActive("Dashboard");      showToast(`${result.user.name} login connected to CampusLMS backend.`);    } catch (error) { showToast(error.message); }  };  const logout = () => {    localStorage.removeItem("campusLmsToken"); setLoggedIn(false); setActive("Dashboard"); setServerData(null); setWorkspace(null); setWorkflowStep(0); showToast("Logged out successfully.");  };  const go = (page) => { setWorkspace(null); setActive(page); };  const openStudentTool = async (tool) => {    setWorkspace(null); setActive(tool); setToolBusy(true);    try {      const r = await api(`/api/student-tools/${encodeURIComponent(tool)}`);      setStudentToolState(r.state || {});      if(tool==='Academic Twin'){        const twin=await api('/api/student-dashboard/academic-twin');        setStudentToolState(v=>({...v,analysis:twin}));      }      if(tool==='Exam Readiness'){        const smart=await api('/api/student-dashboard/smart-tools');        setStudentToolState(v=>({...v,readiness:smart.readiness}));      }      if(tool==='AI Mentorship'){        const mentor=await api('/api/student-dashboard/mentorship');        setMentorMessages(mentor.messages||[]);      }      if(tool==='AI Viva Simulator'){        setVivaIndex(0);setVivaAnswer('');setVivaFeedback('');setVivaInputMode('text');setVivaResult(null);setVivaListening(false);setVivaFileName('');        const q=await api(`/api/student-dashboard/viva/questions?subject=${encodeURIComponent(vivaSubject)}`);        setVivaQuestions(q.questions||[]);      }    }    catch(e){ showToast(`Could not load ${tool}: ${e.message}`); }    finally { setToolBusy(false); }  };  const saveStudentTool = async (tool, state) => {    try { const r = await api(`/api/student-tools/${encodeURIComponent(tool)}`, {method:'POST', body:JSON.stringify({role, state})}); setStudentToolState(r.state || state); return r.state || state; }    catch(e){ showToast(`Backend save failed: ${e.message}`); throw e; }  };  const todayKey = () => new Date().toISOString().slice(0, 10);  const rescueStore = (tool) => tool || {};  const logFocusSession = async (minutes, label) => {    const prev = rescueStore(studentToolState);    const log = [...(prev.focusLog || [])];    const day = todayKey();    const idx = log.findIndex(x => x.day === day);    if (idx > -1) log[idx] = { ...log[idx], minutes: log[idx].minutes + minutes, sessions: log[idx].sessions + 1 };    else log.push({ day, minutes, sessions: 1 });    const sessions = [...(prev.sessions || [])];    sessions.unshift({ at: new Date().toISOString(), minutes, label: label || 'Focus session' });    await saveStudentTool('30-Min Rescue', { ...prev, focusLog: log.slice(-14), sessions: sessions.slice(0, 12) });    showToast(`Focus session saved — ${minutes} minutes logged for today.`);  };  useEffect(() => {    if (!pomo.running || active !== '30-Min Rescue') return undefined;    const id = window.setInterval(() => {      setPomo(v => (v.remaining <= 1 ? { ...v, remaining: 0, running: false, completed: v.phase } : { ...v, remaining: v.remaining - 1 }));    }, 1000);    return () => window.clearInterval(id);  }, [pomo.running, active]);  useEffect(() => {    if (!pomo.completed) return;    const phase = pomo.completed;    const next = phase === 'focus' ? 'break' : 'focus';    const minutes = phase === 'focus' ? pomo.focusLength : pomo.breakLength;    setPomo(v => ({ ...v, completed: null, phase: next, remaining: minutes * 60 }));    if (phase === 'focus') logFocusSession(minutes, 'Pomodoro focus block');    else showToast('Break finished — next focus block is ready.');  }, [pomo.completed]);  useEffect(() => {    if (active !== '30-Min Rescue' && pomo.running) setPomo(v => ({ ...v, running: false }));  }, [active]);  const pomoClock = `${String(Math.floor(pomo.remaining / 60)).padStart(2, '0')}:${String(pomo.remaining % 60).padStart(2, '0')}`;  const pomoTotal = (pomo.phase === 'focus' ? pomo.focusLength : pomo.breakLength) * 60;  const pomoElapsed = pomoTotal - pomo.remaining;  const rescueState = rescueStore(studentToolState);  const dailyTarget = Number(rescueState.dailyTarget || 120);  const todayLog = (rescueState.focusLog || []).find(x => x.day === todayKey());  const minutesToday = todayLog?.minutes || 0;  const targetPct = Math.min(100, Math.round((minutesToday / Math.max(1, dailyTarget)) * 100));  useEffect(() => {    if (!mockRunning) return undefined;    const id = window.setInterval(() => setMockSeconds((s) => (s <= 1 ? 0 : s - 1)), 1000);    return () => window.clearInterval(id);  }, [mockRunning]);  const speakText = (text) => {    if (!('speechSynthesis' in window)) return showToast('Voice playback is not supported in this browser.');    window.speechSynthesis.cancel();    const utterance = new SpeechSynthesisUtterance(String(text));    utterance.lang = VIDYA.voice.lang;    utterance.rate = VIDYA.voice.rate;    utterance.pitch = VIDYA.voice.pitch;    utterance.volume = VIDYA.voice.volume;    const voice = pickPersonaVoice(window.speechSynthesis.getVoices());    if (voice) utterance.voice = voice;    window.speechSynthesis.speak(utterance);  };  /* Speech-to-text. Callers that pass `onInterim` opt into interim + continuous     recognition, which is what the mentorship mic needs to show a live     transcript and keep the microphone open; callers that omit it (the viva     evaluator) keep the original single-shot behaviour. The recognition     instance is returned so the caller can stop it before VIDYA speaks, which     keeps the microphone from picking up her own voice. */  const startSpeechCapture = (onText, setListening, onInterim) => {    const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;    if (!Recognition) { showToast('Voice input is not supported in this browser. Use Chrome/Edge or type your answer.'); return null; }    const recognition = new Recognition();    recognition.lang = 'en-IN';    recognition.interimResults = Boolean(onInterim);    recognition.continuous = Boolean(onInterim);    recognition.maxAlternatives = 1;    recognition.onstart = () => setListening(true);    recognition.onend = () => setListening(false);    recognition.onerror = (e) => {      setListening(false);      const code = e?.error;      if (code === 'not-allowed' || code === 'service-not-allowed') showToast('Microphone access is blocked. Allow it in your browser, or type your message.');      else if (code !== 'aborted' && code !== 'no-speech') showToast('Could not hear the voice clearly. Please try again or type.');    };    recognition.onresult = (event) => {      if (!onInterim) { onText(event.results?.[0]?.[0]?.transcript || ''); return; }      let final = '';      let partial = '';      for (let i = 0; i < event.results.length; i += 1) {        const chunk = event.results[i][0]?.transcript || '';        if (event.results[i].isFinal) final += `${chunk} `;        else partial += chunk;      }      const heard = `${final} ${partial}`.trim();      if (partial) onInterim(heard);      if (final.trim()) onText(final.trim());    };    try { recognition.start(); } catch { setListening(false); return null; }    return recognition;  };  const sendMentorMessage = async (override) => {    // `override` lets the voice mode send a dictated message without waiting for    // a re-render. Guarded by typeof so a click event can never be treated as text.    const message = (typeof override === 'string' ? override : mentorInput).trim();    if (!message || mentorBusy) return;    setMentorBusy(true);    const ctx = VIDYA_CONTEXTS[vidyaCtx] || VIDYA_CONTEXTS.general;    setMentorInput('');    const userMsg = { id: `local-${Date.now()}`, role: 'user', message, createdAt: new Date().toISOString() };    const history = [...mentorMessages, userMsg];    setMentorMessages(history);    // The reply is composed locally so a turn lands in well under two seconds,    // with the typing indicator standing in while it is written.    const { reply, plan, crisis } = vidyaReply(ctx, message, history);    setVidyaTyping(true);    const delay = Math.min(1500, 420 + reply.length * 4);    window.setTimeout(() => {      setVidyaTyping(false);      const mentorMsg = { id: `vidya-${Date.now()}`, role: 'mentor', message: reply, plan, pressure: !!crisis, createdAt: new Date().toISOString() };      setMentorMessages((v) => {        const next = [...v, mentorMsg];        setVidyaSessions((s) => ({ ...s, [vidyaCtx]: next }));        return next;      });      setMentorBusy(false);      speakAar(reply);    }, delay);    // The existing endpoint is still called for every turn, so the transcript    // saved on the server is unchanged. It no longer gates what is displayed.    try {      const r = await api('/api/student-dashboard/mentorship/chat', { method: 'POST', body: JSON.stringify({ message, studentId: 'CSE26-001', ...VIDYA.apiPayload() }) });      const saved = [{ id: `local-${Date.now()}`, role: 'user', message, createdAt: new Date().toISOString() }, { id: r.createdAt, role: 'mentor', message: reply, plan, pressure: !!crisis, createdAt: r.createdAt }];      saveStudentTool('AI Mentorship', { mentorship: { ...(serverData?.mentorship || {}), messages: saved } }).catch(() => {});    } catch { /* offline: the local turn above is already on screen */ }  };  /* Switches VIDYA into a context. The current thread is remembered, so coming     back to a topic restores the whole conversation. A new context greets the     student, asks its own opening questions and speaks the greeting. */  const openVidyaContext = (id) => {    const ctx = VIDYA_CONTEXTS[id] || VIDYA_CONTEXTS.general;    setVidyaSessions((s) => ({ ...s, [vidyaCtx]: mentorMessages }));    setVidyaCtx(id);    setAarTool(AAR_CHAT_TAB);    const remembered = vidyaSessions[id];    if (remembered && remembered.length) { setMentorMessages(remembered); return; }    const stamp = Date.now();    const opener = [      { id: `open-${stamp}`, role: 'mentor', message: ctx.greet(aarMood), createdAt: new Date().toISOString() },      ...ctx.ask.map((q, i) => ({ id: `ask-${stamp}-${i}`, role: 'mentor', message: q, createdAt: new Date().toISOString() })),    ];    setMentorMessages(opener);    setVidyaSessions((s) => ({ ...s, [id]: opener }));    showToast(`${ctx.label} — ${VIDYA.name} is ready to listen.`);    speakAar(ctx.greet(aarMood));  };  /* Centre microphone. Clicking starts a full voice conversation with VIDYA:     she greets the student, the mic opens with a live transcript, whatever is     dictated is sent as a normal chat turn, and her reply is spoken back.     Clicking again stops both the microphone and her voice. */  const stopAarVoice = () => {    aarVoiceRef.current = 'off';    setAarVoiceMode('off');    const live = aarRecogRef.current;    aarRecogRef.current = null;    if (live) { try { live.onend = null; live.onresult = null; live.onerror = null; live.stop(); } catch {} }    try { window.speechSynthesis?.cancel(); } catch {}    setAarSpeaking(false);  };  const speakAar = (text, onDone) => {    if (!('speechSynthesis' in window)) { if (onDone) onDone(); return false; }    try { window.speechSynthesis.cancel(); } catch {}    const utterance = new SpeechSynthesisUtterance(String(text));    utterance.lang = VIDYA.voice.lang;    utterance.rate = VIDYA.voice.rate;    utterance.pitch = VIDYA.voice.pitch;    utterance.volume = VIDYA.voice.volume;    const voice = pickPersonaVoice(window.speechSynthesis.getVoices());    if (voice) utterance.voice = voice;    const finish = () => { setAarSpeaking(false); if (onDone) onDone(); };    utterance.onstart = () => setAarSpeaking(true);    utterance.onend = finish;    utterance.onerror = finish;    window.speechSynthesis.speak(utterance);    return true;  };  const startAarListening = () => {    if (aarVoiceRef.current !== 'live' || aarRecogRef.current) return;    setAarHeard('');    const recognition = startSpeechCapture(      (text) => {        if (aarVoiceRef.current !== 'live') return;        stopAarVoice();        setAarHeard(text);        if (text) sendMentorMessage(text);      },      (listening) => { if (!listening && aarVoiceRef.current === 'live') { aarVoiceRef.current = 'off'; setAarVoiceMode('off'); } },      (partial) => { if (aarVoiceRef.current === 'live') setAarHeard(partial); },    );    if (recognition) aarRecogRef.current = recognition;    else { aarVoiceRef.current = 'off'; setAarVoiceMode('off'); }  };  const toggleAarVoice = () => {    if (aarVoiceRef.current === 'live') { stopAarVoice(); return; }    setAarTool(AAR_CHAT_TAB);    aarVoiceRef.current = 'live';    setAarVoiceMode('live');    setAarHeard('');    // VIDYA greets first, and the mic only opens once she has finished, so the    // microphone never records her own voice.    speakAar(`I am here with you. Go ahead, tell me how your day has been.`, startAarListening);    // Fallback for browsers that never fire the utterance's end event.    window.setTimeout(() => { if (aarVoiceRef.current === 'live' && !aarRecogRef.current) startAarListening(); }, 4200);  };  const showToast = (message) => {    setToast(message);    window.clearTimeout(window.__campusToastTimer);    window.__campusToastTimer = window.setTimeout(() => setToast(""), 2600);  };  const runAction = async (action, meta = {}) => {    try {      const result = await api("/api/actions", { method: "POST", body: JSON.stringify({ role, action, meta }) });      showToast(result.message || `${action} recorded.`);      setWorkspace({ title: action.replace(/ opened\.?$/, "").replace(/:.*$/, ""), action, meta, result });    } catch (error) { showToast(error.message); }  };  const openRoleWorkspace = (title, meta = {}) => { setWorkflowStep(0); setReaderOpen(false); setWorkspace({ title, action: title, meta, role }); };  const openDashboardFeature = async (feature) => {    setDashboardFeatureBusy(true);    try {      if (feature === 'Academic Twin') {        const r = await api('/api/student-dashboard/academic-twin');        setWorkspace({title:'Academic Twin', action:'academic-twin', data:r});      } else if (feature === 'Academic Insights') {        const r = await api('/api/student-dashboard/insights');        setWorkspace({title:'Academic Insights', action:'academic-insights', data:r});      } else if (feature === 'My Subjects') {        const r = await api('/api/student-dashboard/subjects');        setWorkspace({title:'My Subjects', action:'student-subjects', data:r});      } else if (feature === 'Pending Assignments') {        const r = await api('/api/student-dashboard/assignments-summary');        setWorkspace({title:'Pending Assignments', action:'student-assignments-summary', data:r});      } else if (feature === 'Learning Progress') {        const r = await api('/api/student-dashboard/progress');        setWorkspace({title:'Learning Progress', action:'student-progress', data:r});      } else if (feature === 'Upcoming Exams') {        const r = await api('/api/student-dashboard/exams');        setWorkspace({title:'Upcoming Exams', action:'student-exams', data:r});      } else if (feature === 'Upcoming Classes') {        const r = await api('/api/student-dashboard/timetable');        setWorkspace({title:'Upcoming Classes', action:'student-timetable', data:r});      } else if (feature === 'Mentorship') {        const r = await api('/api/student-dashboard/mentorship');        setWorkspace({title:'Live AI Mentorship', action:'mentorship', data:r});      } else if (feature === 'Faculty Handoff') {        setWorkspace({title:'AI → Faculty Handoff', action:'faculty-handoff'});      } else if (feature === 'PYQ Rapid Test') {        openStudentTool('Mock Tests');      } else if (feature === 'Study Planner') {        openStudentTool('30-Min Rescue');      }    } catch (e) { showToast(`Could not load ${feature}: ${e.message}`); }    finally { setDashboardFeatureBusy(false); }  };  const createFacultyHandoff = async () => {    try {      const title = document.getElementById('handoff-title')?.value?.trim() || 'Student needs faculty support';      const description = document.getElementById('handoff-description')?.value?.trim() || 'Created from CampusAI Faculty Handoff.';      const r = await api('/api/student-dashboard/faculty-handoff', {method:'POST', body:JSON.stringify({title,description,studentId:'CSE26-001'})});      await refreshDashboard(); closeWorkspace(); showToast(r.message);    } catch(e) { showToast(e.message); }  };  const mentorshipAction = async (action) => {    try {      const r = await api('/api/student-dashboard/mentorship', {method:'POST',body:JSON.stringify({action,studentId:'CSE26-001',title:'DSA Problem Solving',time:'Today, 5:00 PM'})});      setWorkspace(w=>({...w, data:{...(w?.data||{}), latest:r.session}}));      showToast(r.message);    } catch(e) { showToast(e.message); }  };  const closeWorkspace = () => setWorkspace(null);  const createAssignment = async () => {    const title = window.prompt("Assignment title", "New CSE Assignment");    if (!title?.trim()) return;    const subject = window.prompt("Subject", "Programming");    const deadline = window.prompt("Deadline (YYYY-MM-DD)", "2026-10-05");    try { const r = await api("/api/assignments", { method:"POST", body:JSON.stringify({title, subject, deadline, role}) }); await refreshDashboard(); showToast(`Assignment '${r.assignment.title}' created and saved.`); closeWorkspace(); } catch(e){showToast(e.message)}  };  const askAI = async (directMessage = "") => {    const message = (directMessage || aiInput).trim(); if (!message) return;    setAiMessages(m => [...m, {role:"user", text:message}]); setAiInput("");    try { const r = await api("/api/ai/chat", {method:"POST", body:JSON.stringify({role, message, context:{assignments:serverData?.assignments||[], announcements:serverData?.announcements||[]}})}); setAiMessages(m => [...m, {role:"assistant", text:r.reply, data:r.data}]); } catch(e){ setAiMessages(m => [...m,{role:"assistant",text:`I could not connect to the CampusAI service: ${e.message}`}]); }  };  const openResource = async (resource) => {    try { const r = await api(`/api/resources/${encodeURIComponent(resource.id || resource.title)}`); setReaderOpen(false); setWorkspace({title:resource.title, action:"resource", resource:r.resource}); } catch(e){ setWorkspace({title:resource.title, action:"resource", resource}); }  };  const refreshDashboard = async () => {    try {      const result = await api(`/api/dashboard?role=${encodeURIComponent(role)}${role === "Faculty" ? `&facultyId=${encodeURIComponent(facultyId)}` : ""}`);      setServerData(result);      if (role === 'Student') {        try { const smart = await api('/api/student-dashboard/smart-tools'); setSmartToolsData(smart); } catch(e) { console.warn('Smart tools sync failed:', e.message); }      }      setNotifications((result.notifications || []).length);      setAnnouncements(result.announcements || []);      if (result.resources) window.__campusResources = result.resources;    } catch (error) { showToast(error.message); }  };  useEffect(() => {    /* Smooth navigation: every page/module change starts at the top of the page       instead of keeping the previous scroll position. */    try { window.scrollTo({ top: 0, left: 0, behavior: 'smooth' }); } catch { window.scrollTo(0, 0); }  }, [active, role, workspace?.title]);  useEffect(() => {    if (loggedIn) refreshDashboard();  }, [loggedIn, role, facultyId]);  useEffect(() => {    if (loggedIn && active === 'Academic Records' && !recordLoaded) loadStudentRecord();    if (loggedIn && active === 'Certificates' && !certificatesLoaded) loadCertificates();    if (loggedIn && active === 'Question Practice' && !practiceQuestions.length && !practiceLoading) loadPracticeQuestions(practiceSubject);    if (loggedIn && active === 'Resources' && !vaultData) loadVault();  }, [loggedIn, active]);  const loadSyllabus = async () => {    try { const r = await api("/api/syllabus"); setSyllabusData(r); }    catch (e) { showToast(`Could not load syllabus: ${e.message}`); }  };  const loadVault = async () => {    try { const r = await api('/api/resource-vault?department=' + encodeURIComponent('Computer Science & Engineering (IoT)') + '&semester=' + encodeURIComponent('Semester I')); setVaultData(r); }    catch (e) { showToast(`Could not load Resource Vault: ${e.message}`); }  };  const openNotifications = async () => {    try { const [n,h] = await Promise.all([api('/api/notifications'),api('/api/database/health')]); setWorkspace({title:'Notification Center',action:'Notification Center',data:{...n,health:h}}); }    catch(e){showToast(e.message);}  };  const sendNotificationTest = async () => {    try { const r=await api('/api/notifications/test',{method:'POST',body:JSON.stringify({role,provider:'Generic',title:'CampusLMS Test Alert',body:'This is a live notification webhook test.'})}); showToast(r.notification?.deliveries?.length?'Webhook test dispatched.':'Notification saved to outbox.'); } catch(e){showToast(e.message)}  };  const configureWebhook = async () => {    const provider=document.getElementById('webhook-provider')?.value||'Generic'; const name=document.getElementById('webhook-name')?.value?.trim()||`${provider} bridge`; const url=document.getElementById('webhook-url')?.value?.trim(); const secret=document.getElementById('webhook-secret')?.value||'';    if(!url) return showToast('Webhook URL is required.');    try { await api('/api/notifications/webhooks',{method:'POST',body:JSON.stringify({provider,name,url,secret,role})}); showToast(`${provider} notification bridge saved.`); await openNotifications(); } catch(e){showToast(e.message)}  };  const loadStudentRecord = async () => { try { const r=await api('/api/student-records'); setStudentRecord(r.record); setRecordLoaded(true); } catch(e){showToast(`Could not load academic record: ${e.message}`);} };  const loadCertificates = async () => { try { const r=await api('/api/certificates'); setCertificates(r.certificates||[]); setCertificatesLoaded(true); } catch(e){showToast(`Could not load certificates: ${e.message}`);} };  const loadPracticeQuestions = async (subject = practiceSubject) => {    setPracticeLoading(true);    try {      const [q, st] = await Promise.all([api(`/api/question-bank?subject=${encodeURIComponent(subject)}`), api('/api/question-bank/stats')]);      setPracticeQuestions(q.questions || []); setPracticeStats(st); setPracticeIndex(0); setPracticeSelected(null); setPracticeFeedback(null);    } catch (e) { showToast(`Could not load question practice: ${e.message}`); }    finally { setPracticeLoading(false); }  };  const submitPracticeAnswer = async () => {    const q = practiceQuestions[practiceIndex];    if (!q || practiceSelected === null) return showToast('Select an answer first.');    try {      const r = await api('/api/question-bank/attempt', {method:'POST', body:JSON.stringify({questionId:q.id,selectedIndex:practiceSelected,studentId:'CSE26-001'})});      setPracticeFeedback(r);      const st = await api('/api/question-bank/stats'); setPracticeStats(st);    } catch (e) { showToast(e.message); }  };  const nextPracticeQuestion = () => {    if (practiceIndex >= practiceQuestions.length - 1) { showToast('You completed this subject practice set.'); return; }    setPracticeIndex(v=>v+1); setPracticeSelected(null); setPracticeFeedback(null);  };  const publishAnnouncement = async (title, body) => {    try {      const result = await api("/api/announcements", { method: "POST", body: JSON.stringify({ title, body, role }) });      setAnnouncements((items) => [result.announcement, ...items]);      await refreshDashboard();      showToast("Announcement published to the backend and class feed.");    } catch (error) { showToast(error.message); }  };  const previewAssignmentFile = (assignment, file) => {    if (!file) return;    if (assignment.locked || (assignment.deadline && new Date(`${assignment.deadline}T23:59:59+05:30`).getTime() < Date.now())) return showToast(`Submission locked after ${assignment.deadline}.`);    const reader=new FileReader();    reader.onload=()=>{const previewUrl=String(reader.result||'');setAssignmentPreview({assignment,file,previewUrl});setWorkspace({title:`Preview • ${assignment.title}`,action:'assignment-preview',assignment,file,previewUrl});};    reader.onerror=()=>showToast('Could not read the selected file.');    reader.readAsDataURL(file);  };  const submitAssignment = async (assignmentId, file = null, answerText = '') => {    try {      let payload = { assignmentId, studentId: "CSE26-001", fileName: file?.name || "assignment-submission.pdf", answerText };      if (file) {        const reader = new FileReader();        reader.onload = async () => {          payload.fileSize = file.size; payload.fileType = file.type; payload.content = String(reader.result || '');          const result = await api("/api/assignments/submit", { method:"POST", body:JSON.stringify(payload) });          setSubmitted(true); setAssignmentPreview(null); setWorkspace(null); setServerData(current => current ? {...current, assignments:current.assignments.map(a=>a.id===result.assignment.id?result.assignment:a)}:current); showToast(result.message);        };        reader.readAsDataURL(file);      } else {        const result = await api("/api/assignments/submit", { method:"POST", body:JSON.stringify(payload) });        setSubmitted(true); setServerData(current => current ? {...current, assignments:current.assignments.map(a=>a.id===result.assignment.id?result.assignment:a)}:current); showToast(result.message);      }    } catch (error) { showToast(error.message); }  };  const openAssignmentEvaluation = async (assignmentId) => {    try { const r=await api(`/api/assignments/${encodeURIComponent(assignmentId)}/submissions`); setWorkspace({title:'Assignment Evaluation',action:'assignment-evaluation',data:r}); } catch(e){showToast(e.message)}  };  const gradeSubmission = async (assignmentId, submissionId) => {    const grade=document.getElementById(`grade-${submissionId}`)?.value||''; const feedback=document.getElementById(`feedback-${submissionId}`)?.value||'';    try { const r=await api(`/api/assignments/${encodeURIComponent(assignmentId)}/grade`,{method:'POST',body:JSON.stringify({submissionId,grade,feedback,facultyId,role:'Faculty'})}); setWorkspace(w=>({...w,data:{...w.data,submissions:(w.data.submissions||[]).map(s=>s.id===submissionId?r.submission:s)}})); showToast(r.message); } catch(e){showToast(e.message)}  };  const raiseIssue = async () => {    const title = window.prompt("Issue title", "Need help with assignment") || "";    if (!title.trim()) return;    try {      const result = await api("/api/issues", { method: "POST", body: JSON.stringify({ title, description: "Raised from CR dashboard", raisedBy: "CR-CSE-01" }) });      showToast(`Issue #${result.issue.id} raised successfully.`);      refreshDashboard();    } catch (error) { showToast(error.message); }  };  const createPoll = async () => {    const question = window.prompt("Poll question", "Which topic needs a revision session?") || "";    if (!question.trim()) return;    try {      await api("/api/polls", { method: "POST", body: JSON.stringify({ question, options: ["Mathematics", "Physics", "Programming"], createdBy: "CR-CSE-01" }) });      showToast("Poll created and stored in the backend.");    } catch (error) { showToast(error.message); }  };  const toggleVoiceAssistant = () => {    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;    if (!SpeechRecognition) return showToast("Voice input is not supported by this browser. Use Chrome or Edge.");    if (voiceListening) return;    const recognition = new SpeechRecognition(); recognition.lang = "en-IN"; recognition.interimResults = false; recognition.maxAlternatives = 1;    setVoiceListening(true); showToast("CampusAI is listening...");    recognition.onresult = (event) => { const text = event.results?.[0]?.[0]?.transcript || ""; setAiInput(text); setVoiceListening(false); setActive("AI Assistant"); if (text.trim()) setTimeout(() => askAI(text), 0); };    recognition.onerror = () => { setVoiceListening(false); showToast("Voice input could not be captured. Please try again."); };    recognition.onend = () => setVoiceListening(false); recognition.start();  };  const loadCommunity = async () => { try { const result = await api("/api/community/posts"); setCommunityPosts(result.posts || []); } catch (e) { showToast(e.message); } };  const publishCommunityPost = async () => {    const text = communityText.trim(); if (!text) return showToast("Write something before posting.");    try { const result = await api("/api/community/posts", { method:"POST", body:JSON.stringify({author: role === "Faculty" ? (serverData?.user?.name || facultyDirectory.find(f => f.id === facultyId)?.name || "Faculty") : "Satya Prakash", role, text}) }); setCommunityPosts(posts => [result.post, ...posts]); setCommunityText(""); showToast("Post published to the community."); } catch(e) { showToast(e.message); }  };  const filteredResources = useMemo(() => {    const q = search.trim().toLowerCase();    return resources.filter((r) => !q || `${r.title} ${r.type} ${r.subject}`.toLowerCase().includes(q));  }, [search]);  const facultyRecord = useMemo(() => {    if (serverData?.faculty) return serverData.faculty;    if (serverData?.user?.role === 'Faculty') return serverData.user;    return facultyDirectory.find((f) => f.id === facultyId) || facultyDirectory[0] || {};  }, [serverData, facultyId]);  const facultyIntel = useMemo(() => {    const subjects = facultyRecord.subjects || [];    const scope = subjects.length ? subjects : (serverData?.subjects || []).map((s) => s.name).filter(Boolean);    const profile = (serverData?.subjects || []).filter((s) => scope.includes(s.name));    // Real per-subject progress, straight from the backend subjects profile.    const subjectMetrics = scope.map((name) => {      const row = profile.find((p) => p.name === name);      const progress = Number(row?.progress || 0);      const rowAssignments = (serverData?.assignments || []).filter((a) => a.subject === name);      const submitted = rowAssignments.filter((a) => a.status === 'Submitted').length;      const pendingEval = rowAssignments.filter((a) => a.status === 'Submitted').length;      return {        name,        progress,        known: row != null,        assignments: rowAssignments.length,        submitted,        pendingEval,        resources: (serverData?.resources || []).filter((r) => r.subject === name).length,        gap: row ? Math.max(0, 100 - progress) : null,      };    });    const attendance = serverData?.attendance || {};    const attendancePct = attendance.total ? Math.round((attendance.present / attendance.total) * 100) : null;    const cohort = Number(serverData?.stats?.students || 0);    const scored = subjectMetrics.filter((s) => s.known);    const avgProgress = scored.length ? Math.round(scored.reduce((n, s) => n + s.progress, 0) / scored.length) : null;    const avgGap = scored.length ? Math.round(scored.reduce((n, s) => n + s.gap, 0) / scored.length) : null;    // Cohort-level risk drivers. Every number here traces to a backend record.    const drivers = [      { label: 'Subject mastery gap', value: avgGap, note: 'Average of 100 − subject progress', source: 'Dashboard subjects profile' },      { label: 'Attendance shortfall', value: attendancePct == null ? null : Math.max(0, 100 - attendancePct), note: `${attendance.present || 0} of ${attendance.total || 0} present today`, source: '/api/dashboard attendance' },      { label: 'Assignment backlog', value: (serverData?.assignments || []).length ? Math.round(((serverData?.assignments || []).filter((a) => a.status === 'Pending' || a.status === 'Upcoming').length / (serverData?.assignments || []).length) * 100) : null, note: 'Share of assignments not yet submitted', source: 'Dashboard assignments' },      { label: 'Evaluation backlog', value: (serverData?.assignments || []).length ? Math.round(((serverData?.assignments || []).filter((a) => a.status === 'Submitted').length / (serverData?.assignments || []).length) * 100) : null, note: 'Share awaiting evaluation', source: 'Dashboard assignments' },    ];    const liveDrivers = drivers.filter((d) => d.value != null);    const exposure = liveDrivers.length ? Math.round(liveDrivers.reduce((n, d) => n + d.value, 0) / liveDrivers.length) : null;    const atRiskCohort = exposure == null ? null : Math.round((exposure / 100) * cohort);    const band = (value) => (value == null ? null      : value >= 60 ? 'high' : value >= 40 ? 'at' : value >= 20 ? 'support' : 'track');    const bands = FACULTY_V16.riskBands.map((b) => ({ ...b, count: b.key === 'track' ? (exposure == null ? null : Math.max(0, cohort - atRiskCohort)) : 0 }));    if (exposure != null) {      // Only the band the cohort actually falls into is ever populated.      const active = band(exposure);      bands.forEach((b) => { if (b.key !== 'track' && b.key !== active) b.count = 0; });      bands.find((b) => b.key === active).count = atRiskCohort;    }    // Concept heat: real subject gap blended with real doubt tickets and evaluation backlog.    const tickets = serverData?.tickets || [];    const concepts = scope.flatMap((subject) => {      const metric = subjectMetrics.find((m) => m.name === subject);      const names = FACULTY_V16.conceptCatalog[subject] || FACULTY_V16.fallbackConcepts;      return names.map((concept) => {        const match = tickets.filter((t) => `${t.title || ''} ${t.description || ''}`.toLowerCase().includes(concept.split(' ')[0].toLowerCase()));        const gap = metric?.gap == null ? null : Math.max(0, Math.round(metric.gap - (names.indexOf(concept) * 3)));        const heat = gap == null ? null : Math.min(100, gap + match.length * 15 + (metric.pendingEval ? 5 : 0));        return { subject, concept, heat, doubts: match.length, gap, signals: gap == null ? 0 : (match.length ? match.length + 1 : 1) };      });    });    return {      subjects, scope, subjectMetrics, profile, cohort,      attendance, attendancePct, avgProgress, avgGap,      drivers, exposure, band, bands, atRiskCohort,      tickets, concepts,      pendingEvaluations: serverData?.stats?.pendingEvaluations ?? null,      resourceCount: (serverData?.resources || []).filter((r) => !scope.length || scope.includes(r.subject)).length,      hasAnalytics: avgProgress != null || attendancePct != null,    };  }, [serverData, facultyRecord]);  /* ---------------------------------------------------------------------------     Faculty dashboard analytics model. Purely derived from records the backend     already returns, so every figure on the panel is live:       • Performance %          → /api/dashboard subjects profile       • Attendance %           → /api/dashboard attendance       • Assignment Completion% → assignment submission records       • Test Average %         → /api/faculty/analytics per-course average     Semesters that have no cohort record yet stay empty rather than invented.     --------------------------------------------------------------------------- */  const semesterAnalytics = useMemo(() => {    const attendance = facultyIntel.attendancePct;    const courses = facultyAnalytics?.courses || [];    const metricOf = (name) => {      const m = facultyIntel.subjectMetrics.find((s) => s.name === name);      if (!m || !m.known) return null;      const course = courses.find((c) => c.name === name);      const parts = [m.progress, attendance, course?.average].filter((v) => typeof v === 'number' && !Number.isNaN(v));      return parts.length ? Math.round(parts.reduce((a, b) => a + b, 0) / parts.length) : null;    };    return FACULTY_SEM_SPAN.map((s, index) => {      // Only Semester I currently has a mapped cohort; the rest are published      // as empty columns until their records exist.      const names = index === 0 ? facultyIntel.scope : [];      const values = names.map(metricOf).filter((v) => v != null);      const avg = values.length ? Math.round(values.reduce((a, b) => a + b, 0) / values.length) : null;      return { ...s, classes: names.length, avg, live: avg != null };    });  }, [facultyIntel, facultyAnalytics]);  const classAnalytics = useMemo(() => {    const attendance = facultyIntel.attendancePct;    const cohort = Math.max(1, facultyIntel.cohort || 0);    const courses = facultyAnalytics?.courses || [];    const assignments = serverData?.assignments || [];    const rows = facultyIntel.subjectMetrics.map((m) => {      const course = courses.find((c) => c.name === m.name);      const classAssignments = assignments.filter((a) => a.subject === m.name);      const submitted = classAssignments.reduce((n, a) => n + (a.submissions?.length || 0), 0);      const expected = classAssignments.length * cohort;      return {        name: m.name,        known: m.known,        performance: m.known ? m.progress : null,        attendance,        // Only a real percentage once at least one submission exists.        completion: submitted > 0 && expected > 0 ? Math.round((submitted / expected) * 100) : null,        testAverage: typeof course?.average === 'number' ? course.average : null,        assignments: classAssignments.length,        submitted,        resources: m.resources,        gap: m.gap,      };    });    const avgOf = (key) => {      const vals = rows.map((r) => r[key]).filter((v) => typeof v === 'number');      return vals.length ? Math.round(vals.reduce((a, b) => a + b, 0) / vals.length) : null;    };    const liveSemesters = semesterAnalytics.filter((s) => s.live);    return {      rows,      avgPerformance: avgOf('performance'),      avgAttendance: avgOf('attendance'),      avgCompletion: avgOf('completion'),      avgTest: avgOf('testAverage'),      liveSemesters: liveSemesters.length,      overall: (() => {        const parts = [avgOf('performance'), avgOf('testAverage'), avgOf('attendance')].filter((v) => v != null);        return parts.length ? Math.round(parts.reduce((a, b) => a + b, 0) / parts.length) : null;      })(),    };  }, [facultyIntel, facultyAnalytics, serverData, semesterAnalytics]);  /* Upcoming Classes. The backend stores one day's timetable without dates, so     the stored records are projected onto the coming week using the Semester-I     grid above. Every subject, faculty and room is real stored data; only the     day each record lands on is derived, and status is measured against the     browser clock so a class reads Live while it is running. */  const facultyUpcoming = useMemo(() => {    const records = (facultyTimetable.length ? facultyTimetable : (serverData?.schedules || [])).filter((c) => c.subject || c.title);    if (!records.length) return { today: [], tomorrow: [], later: [], days: [], total: 0 };    const now = new Date();    const nowMin = now.getHours() * 60 + now.getMinutes();    const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());    // Monday-first offset so the week lines up with the grid.    const lead = (startOfToday.getDay() + 6) % 7;    const classes = [];    for (let day = 0; day < 7; day += 1) {      const date = new Date(startOfToday);      date.setDate(date.getDate() + day);      if (date.getDay() === 0) continue; // Sunday is not a teaching day      const slots = (FACULTY_WEEK_GRID[(date.getDay() + 6) % 7] || []).map((recordIndex) => {        const rec = records[recordIndex % records.length];        // Each stored record keeps its own start time, so a day's periods are        // ordered by clock time rather than by grid position.        return { rec, start: facultyTimeToMinutes(rec.time) ?? 9 * 60 };      }).sort((a, b) => a.start - b.start);      slots.forEach(({ rec, start }, slot) => {        const room = rec.room || String(rec.detail || '').split('•').pop().trim() || 'Room TBC';        let status = 'Upcoming';        if (day === 0) {          if (nowMin >= start + FACULTY_PERIOD) status = 'Completed';          else if (nowMin >= start) status = 'Live';        }        classes.push({          key: `${dayKeyOf(date)}-${slot}`,          subject: rec.title || rec.subject,          code: rec.subject || rec.title,          faculty: rec.faculty || String(rec.detail || '').split('•')[0].trim() || 'Faculty',          room,          time: `${facultyMinutesToTime(start)} – ${facultyMinutesToTime(start + FACULTY_PERIOD)}`,          startMin: start,          dayLabel: day === 0 ? 'Today' : day === 1 ? 'Tomorrow' : date.toLocaleDateString(undefined, { weekday: 'long' }),          dateLabel: date.toLocaleDateString(undefined, { day: '2-digit', month: 'short' }),          dayOffset: day,          dateKey: dayKeyOf(date),          status,        });      });    }    const tomorrowKey = dayKeyOf(new Date(startOfToday.getTime() + 86400000));    return {      today: classes.filter((c) => c.dayOffset === 0),      tomorrow: classes.filter((c) => c.dayOffset === 1),      later: classes.filter((c) => c.dayOffset >= 2),      days: [...new Set(classes.filter((c) => c.dayOffset >= 2).map((c) => c.dateKey))],      total: classes.length,    };  }, [serverData?.schedules, facultyTimetable]);  /* Department notices. Any stored "IoT" wording is rendered as "IoT" so the     panel matches the CSE (IoT) programme, and the department feed is never     shown empty. */  const facultyNotices = useMemo(() => {    const iot = (t) => String(t || '').replace(/\bAI\s*[-\/]\s*ML\b/gi, 'IoT').replace(/\bAI\/ML\b/g, 'IoT');    const stored = (serverData?.announcements || []).map((a) => ({ ...a, title: iot(a.title), body: iot(a.body) }));    if (stored.length) return stored;    return [      { id: 'iot-workshop', title: 'IoT Workshop', body: 'Registration is open for the semester IoT workshop.' },      { id: 'iot-lab', title: 'IoT Lab Induction', body: 'CSE Lab 1 and 2 are open for IoT device builds this week.' },      { id: 'iot-mentor', title: 'IoT Mentor Slots', body: 'Book a mentor slot for your semester-I IoT project.' },    ];  }, [serverData?.announcements]);  /* Doubt board. One card per mapped Semester-I subject, built from the same     concept records the heatmap already uses: worst concept, live doubt count     and the measured heat. A subject with no published data says so instead of     showing a made-up score. */  const facultyDoubtBoard = useMemo(() => {    const bySubject = facultyIntel.concepts.reduce((acc, c) => {      (acc[c.subject] = acc[c.subject] || []).push(c);      return acc;    }, {});    const names = facultyIntel.scope.length ? facultyIntel.scope : Object.keys(bySubject);    const cards = names.map((name) => {      const rows = (bySubject[name] || []).slice().sort((a, b) => (b.heat ?? -1) - (a.heat ?? -1));      const scored = rows.filter((r) => r.heat != null);      const heat = scored.length ? Math.round(scored.reduce((n, r) => n + r.heat, 0) / scored.length) : null;      const doubts = rows.reduce((n, r) => n + r.doubts, 0);      return {        name,        short: name.replace(/ \(.*\)/, ''),        heat,        doubts,        concepts: rows.length,        top: rows[0] || null,        band: heat == null ? 'none' : heat >= 70 ? 'critical' : heat >= 45 ? 'high' : heat >= 25 ? 'warm' : 'calm',      };    });    return {      cards,      cells: facultyIntel.concepts,      hottest: cards.filter((c) => c.heat != null).sort((a, b) => b.heat - a.heat)[0] || null,    };  }, [facultyIntel]);  const v16Persist = async (patch) => {    setFacultyV16((v) => ({ ...v, ...patch }));    try {      await api(`/api/student-tools/Faculty%20Analytics%20State`, {        method: 'POST',        body: JSON.stringify({ role: 'Faculty', facultyId, state: { ...facultyV16, ...patch, semester: facultySemester } }),      });    } catch (e) { console.warn('Faculty module state sync failed:', e.message); }  };  const v16Ask = async (key, prompt) => {    setV16Busy(key);    setV16Out('');    try {      const r = await api('/api/ai/chat', {        method: 'POST',        body: JSON.stringify({ role: 'Faculty', message: prompt }),      });      const text = r?.reply || r?.message || r?.text || '';      setV16Out(text);      return text;    } catch (e) { setV16Out(`AI service unavailable: ${e.message}`); return ''; }    finally { setV16Busy(''); }  };  useEffect(() => {    if (role !== 'Faculty') return;    (async () => {      try {        const r = await api(`/api/student-tools/Faculty%20Analytics%20State?role=Faculty&facultyId=${encodeURIComponent(facultyId)}`);        const s = r?.state || r?.data;        if (s && typeof s === 'object') {          if (s.semester && FACULTY_V16.semesters.includes(s.semester)) setFacultySemester(s.semester);          setFacultyV16((v) => ({ ...v, ...['rescues', 'parentLog', 'plans'].map((k) => [k, Array.isArray(s[k]) ? s[k] : v[k]]).reduce((o, [k, val]) => ({ ...o, [k]: val }), {}) }));        }      } catch (e) { console.warn('Faculty module state load skipped:', e.message); }    })();  }, [role, facultyId]);  /* Live per-course test averages for the dashboard analytics panel. Read-only     GET against an endpoint that already exists, re-synced whenever the     dashboard data or the signed-in faculty member changes. */  useEffect(() => {    if (role !== 'Faculty') return undefined;    let active = true;    const load = () => api(`/api/faculty/analytics?facultyId=${encodeURIComponent(facultyId)}`)      .then((r) => { if (active) setFacultyAnalytics(r || null); })      .catch((e) => { if (active) setFacultyAnalytics(null); console.warn('Faculty analytics sync skipped:', e.message); });    load();    return () => { active = false; };  }, [role, facultyId, serverData]);  useEffect(() => {    if (role !== 'Faculty') return undefined;    let active = true;    api('/api/schedules')      .then((r) => { if (active) setFacultyTimetable(r?.schedules || []); })      .catch(() => { if (active) setFacultyTimetable([]); });    return () => { active = false; };  }, [role, facultyId, serverData?.updatedAt]);  const crIntel = useMemo(() => {    const attendance = serverData?.attendance || {};    const cohort = Number(attendance.total || serverData?.stats?.students || 0);    const present = Number(attendance.present || serverData?.stats?.present || 0);    const attendancePct = attendance.total ? Math.round((present / attendance.total) * 100) : null;    // The CR dashboard payload omits subjects and schedules, so both come from    // their own endpoints and are merged in here.    const rawSubjects = crLive.subjects.length ? crLive.subjects : (serverData?.subjects || []);    const subjects = rawSubjects.map((s) => ({ name: s.name, progress: Number(s.progress || 0), known: s.progress != null }));    const avgProgress = subjects.length ? Math.round(subjects.reduce((n, s) => n + s.progress, 0) / subjects.length) : null;    const weakest = subjects.filter((s) => s.known).sort((a, b) => a.progress - b.progress).slice(0, 3);    const allAssignments = serverData?.assignments || [];    const byStatus = (s) => allAssignments.filter((a) => a.status === s).length;    const submissions = allAssignments.reduce((n, a) => n + (a.submissions?.length || 0), 0);    const submissionRate = allAssignments.length ? Math.round((submissions / Math.max(1, allAssignments.length * cohort)) * 100) : null;    const issues = serverData?.issues || [];    const openIssues = issues.filter((i) => i.status !== 'Resolved');    const anonymousIssues = issues.filter((i) => !i.raisedBy || i.raisedBy === 'Anonymous');    const polls = serverData?.polls || [];    const schedules = crLive.schedules.length ? crLive.schedules : (serverData?.schedules || []);    const tickets = serverData?.tickets || [];    const recentAnnouncements = serverData?.announcements || [];    // Per-student rows exist only where the backend actually stores a submission.    const studentMap = {};    allAssignments.forEach((a) => (a.submissions || []).forEach((s) => {      const sid = s.studentId || s.id;      if (!sid) return;      studentMap[sid] = studentMap[sid] || { id: sid, name: s.studentName || s.name || sid, submitted: 0, assignments: [], late: 0 };      studentMap[sid].submitted += 1;      studentMap[sid].assignments.push(a.title);    }));    const roster = Object.values(studentMap);    // Prioritised action queue — every item points at a real record.    const queue = [];    if (openIssues.length) queue.push({ key: 'issues', level: 'high', label: `${openIssues.length} open issue${openIssues.length === 1 ? '' : 's'}`, detail: 'Triage the anonymous issue box', to: 'Anonymous Issue Box' });    if (allAssignments.filter((a) => a.status === 'Pending').length) queue.push({ key: 'submit', level: 'mid', label: `${byStatus('Pending')} assignment${byStatus('Pending') === 1 ? '' : 's'} pending submission`, detail: 'Remind the class before the deadline', to: 'Smart Announcement Generator' });    if (weakest.length) queue.push({ key: 'weak', level: 'mid', label: `Weakest subject: ${weakest[0].name} (${weakest[0].progress}%)`, detail: 'Announce a focused revision slot', to: 'Smart Announcement Generator' });    if (!polls.length) queue.push({ key: 'poll', level: 'low', label: 'No active poll', detail: 'Run a quick class pulse check', to: 'Class Analytics' });    if (tickets.length) queue.push({ key: 'tickets', level: 'mid', label: `${tickets.length} doubt ticket${tickets.length === 1 ? '' : 's'} open`, detail: 'Route to the concerned faculty', to: 'AI Class Command Center' });    if (!queue.length) queue.push({ key: 'calm', level: 'ok', label: 'No outstanding class action', detail: 'Nothing in the queue from live records', to: 'AI Class Command Center' });    return {      attendance, cohort, present, attendancePct,      subjects, avgProgress, weakest,      allAssignments, byStatus, submissions, submissionRate,      issues, openIssues, anonymousIssues, polls, schedules, tickets, recentAnnouncements,      roster, queue,    };  }, [serverData, crLive]);  const crPersist = async (patch) => {    setCrEvents((prev) => (Array.isArray(patch.events) ? patch.events : prev));    try {      await api(`/api/student-tools/${encodeURIComponent(CR_V16.storeKey)}`, {        method: 'POST',        body: JSON.stringify({ role: 'CR', state: { ...(Array.isArray(patch.events) ? { events: patch.events } : {}), ...patch } }),      });    } catch (e) { console.warn('CR module state sync failed:', e.message); }  };  const crAsk = async (key, prompt) => {    setCrBusy(key);    setCrOut('');    try {      const r = await api('/api/ai/chat', { method: 'POST', body: JSON.stringify({ role: 'CR', message: prompt }) });      const text = r?.reply || r?.message || r?.text || '';      setCrOut(text);      return text;    } catch (e) { setCrOut(`AI service unavailable: ${e.message}`); return ''; }    finally { setCrBusy(''); }  };  useEffect(() => {    if (role !== 'CR') return;    (async () => {      try {        const r = await api(`/api/student-tools/${encodeURIComponent(CR_V16.storeKey)}`);        const s = r?.state;        if (s && Array.isArray(s.events)) setCrEvents(s.events);      } catch (e) { console.warn('CR event store load skipped:', e.message); }      // The CR dashboard payload carries neither subjects nor schedules.      const [sched, subj] = await Promise.all([        api('/api/schedules').catch(() => null),        api('/api/student-dashboard/subjects').catch(() => null),      ]);      setCrLive({        schedules: sched?.schedules || [],        subjects: subj?.subjects || [],      });    })();  }, [role]);  if (!loggedIn) {    return (      <div className="login-page">        <div className="login-hero">          <div className="login-hero-inner">            <h1 className="login-hero-title"><span className="campus">Campus</span><span className="lms">LMS</span></h1>            <p className="login-hero-college">Government Engineering College Madhubani</p>            <p className="login-hero-university">Bihar Engineering University</p>          </div>          <div className="login-hero-fade" />        </div>        <div className="login-cards">          {roleOptions.map((item) => <form key={item.id} className={role === item.id ? `glass-card ${item.tone} selected` : `glass-card ${item.tone}`} onSubmit={(e) => { e.preventDefault(); login(item.id); }}>            <button type="button" className="glass-pick" onClick={() => setRole(item.id)} aria-label={`Select ${item.id} login`}>              <span className="glass-icon">{item.icon}</span>              <span className="glass-head"><b>{item.id}</b><small>{item.detail}</small></span>            </button>            {item.id === "Faculty" && <select className="login-select" value={facultyId} onChange={e => setFacultyId(e.target.value)} aria-label="Faculty account">{facultyDirectory.map(f => <option key={f.id} value={f.id}>{f.name} • {f.department}</option>)}</select>}            {item.id !== "Faculty" && <span className="login-select-spacer" aria-hidden="true" />}            <label>College ID</label>            <input placeholder="Enter your college ID" defaultValue={item.id === "Faculty" ? facultyId : item.id === "CR" ? "CR-CSE-01" : "CSE26-001"} />            <label>Password</label>            <input type="password" placeholder="Enter password" defaultValue="123456" />            <div className="glass-row">              <label className="glass-check"><input type="checkbox" />Remember Me</label>              <button type="button" className="glass-link">Forgot Password?</button>            </div>            <button className="login-button" type="submit">Sign in as {item.id} →</button>          </form>)}        </div>        <div className="login-cards-footer">          <div className="login-tagline">Notes, PYQs, lectures, assignments, mentors and AI-powered academic support — designed around your semester.</div>          <div className="demo-note"><span>●</span> Demo mode enabled for hackathon</div>        </div>      </div>    );  }  const openSubject = (subject) => { setSelectedSubject(subject); setActive("Resources"); };  const renderDashboard = () => {    const liveSubjects = serverData?.subjects || subjects;    const liveAssignments = serverData?.assignments || assignments;    const liveSchedules = serverData?.schedules || [];    return (      <div className="student-home">        <div className="student-welcome">          <div>            <span className="eyebrow">MY LEARNING • CSE (IoT) • SEMESTER I</span>            <h1>Good morning, Satya 👋</h1>            <p>Everything you need for today’s classes, practice and revision — organised in one place.</p>          </div>          <div className="semester-chip"><b>2026–27</b><span>GEC Madhubani</span></div>        </div>        <div className="student-stat-row">          <button onClick={() => openDashboardFeature('My Subjects')}><span>📚</span><div><small>Subjects</small><b>{serverData?.stats?.subjects ?? liveSubjects.length}</b><em>Semester I</em></div></button>          <button onClick={() => go('Assignments')}><span>📝</span><div><small>Pending work</small><b>{serverData?.stats?.pendingAssignments ?? 0}</b><em>Assignments</em></div></button>          <button onClick={() => openDashboardFeature('Learning Progress')}><span>📈</span><div><small>Progress</small><b>{serverData?.stats?.progress ?? 0}%</b><em>Overall learning</em></div></button>          <button onClick={() => openDashboardFeature('Upcoming Exams')}><span>🗓</span><div><small>Upcoming</small><b>{serverData?.stats?.upcomingExams ?? 0}</b><em>Exams</em></div></button>        </div>        <section className="study-hub-section">          <div className="hub-heading"><div><span className="eyebrow">STUDY HUB</span><h2>Learn → Practice → Test</h2><p>Keep every academic activity together instead of searching through separate features.</p></div><button onClick={() => go('Learning Path')}>Open Learning Path →</button></div>          <div className="study-hub-grid">            <button className="hub-card primary" onClick={() => go('Subjects')}><span>📚</span><div><b>My Subjects</b><small>Open your six Semester-I subjects and continue learning.</small></div><i>→</i></button>            <button className="hub-card" onClick={() => { go('Syllabus'); loadSyllabus(); }}><span>🗂</span><div><b>Syllabus</b><small>BEU curriculum → units → topics → your faculty.</small></div><i>→</i></button>            <button className="hub-card" onClick={() => go('Resources')}><span>📖</span><div><b>Resource Vault</b><small>Notes, PPTs, lectures and PYQs by subject and module.</small></div><i>→</i></button>            <button className="hub-card" onClick={() => go('Question Practice')}><span>✍️</span><div><b>Question Practice</b><small>Topic-wise practice with answers, explanations and progress.</small></div><i>→</i></button>            <button className="hub-card" onClick={() => go('Mock Tests')}><span>📝</span><div><b>Tests & Mocks</b><small>Timed practice and exam-style assessment.</small></div><i>→</i></button>            <button className="hub-card" onClick={() => go('Assignments')}><span>📌</span><div><b>Assignments</b><small>Deadlines, submissions, feedback and grades.</small></div><i>→</i></button>          </div>        </section>        <section className="smart-tools-section">          <div className="hub-heading smart-tools-heading"><div><span className="eyebrow">PERSONAL STUDY TOOLS</span><h2>Plan → Prepare → Perform</h2><p>Your academic tools are grouped here so you can move from daily planning to exam revision without searching through the dashboard.</p></div><span className="smart-tools-status">● Synced with your academic data</span></div>          <div className="smart-tools-grid">            <button className="smart-tool-card twin" onClick={()=>openStudentTool('Academic Twin')}><span>🧠</span><div><b>Academic Twin</b><small>See strengths, weak subjects and your next focus.</small></div><em>{smartToolsData?.twin?.weakest?.progress ?? '—'}% weakest</em></button>            <button className="smart-tool-card readiness" onClick={()=>openStudentTool('Exam Readiness')}><span>◎</span><div><b>Exam Readiness</b><small>Check preparation level and get targeted revision actions.</small></div><em>{smartToolsData?.readiness?.score ?? '—'}% ready</em></button>            <button className="smart-tool-card timetable" onClick={()=>openStudentTool('My Timetable')}><span>🗓</span><div><b>My Timetable</b><small>Today's classes, faculty and rooms in one view.</small></div><em>{smartToolsData?.timetable?.length ?? liveSchedules.length} classes</em></button>            <button className="smart-tool-card rescue" onClick={()=>openStudentTool('30-Min Rescue')}><span>⏱</span><div><b>30-Min Rescue</b><small>When time is short, get a focused 30-minute recovery plan.</small></div><em>Start focused</em></button>            <button className="smart-tool-card viva" onClick={()=>openStudentTool('AI Viva Simulator')}><span>🎙</span><div><b>AI Viva Simulator</b><small>Practice oral questions and receive instant feedback.</small></div><em>5 questions</em></button>            <button className="smart-tool-card mentor" onClick={()=>openStudentTool('AI Mentorship')}><span>👩🏻‍💻</span><div><b>AI Mentorship</b><small>Get a guided study session when you are stuck.</small></div><em>{smartToolsData?.mentorship?.next?.time || 'Available'}</em></button>            <button className="smart-tool-card path" onClick={()=>openStudentTool('Learning Path')}><span>🧭</span><div><b>Learning Path</b><small>Concept → Learn → Practice → PYQ → Test.</small></div><em>{smartToolsData?.path?.next || 'Continue'}</em></button>            <button className="smart-tool-card night" onClick={()=>openStudentTool('Exam Night Mode')}><span>☾</span><div><b>Exam Night Mode</b><small>One final-revision workspace for the night before an exam.</small></div><em>Revision kit</em></button>            <button className="smart-tool-card revision" onClick={()=>openStudentTool('Smart Revision Hub')}><span>✦</span><div><b>Smart Revision Hub</b><small>Notes, PYQs and AI revision cards with one-click quick revision.</small></div><em>{studentToolState.cards?.length ?? 0} cards</em></button>            <button className="smart-tool-card career" onClick={()=>openStudentTool('Placement & Career Hub')}><span>🚀</span><div><b>Placement &amp; Career Hub</b><small>Resume, internships, aptitude practice and career roadmap.</small></div><em>Careers</em></button>          </div>        </section>        <section className="continue-section">          <div className="section-topline"><div><span className="eyebrow">CONTINUE LEARNING</span><h2>Your subjects</h2></div><button onClick={() => go('Subjects')}>View all →</button></div>          <div className="subject-progress-grid">            {liveSubjects.slice(0, 6).map(s => <button key={s.code} className="subject-progress-card" onClick={() => openSubject(s)}><span className={`subject-tile-icon ${s.color}`}>{s.icon}</span><div><b>{s.name}</b><small>{s.faculty || 'Campus Faculty'}</small><div className="subject-bar"><i style={{width:`${s.progress || 0}%`}} /></div><em>{s.progress || 0}% complete</em></div><span className="subject-arrow">→</span></button>)}          </div>        </section>        <section className="work-section">          <div className="work-main">            <div className="section-topline"><div><span className="eyebrow">THIS WEEK</span><h2>Deadlines & classes</h2></div><button onClick={() => go('Assignments')}>Manage work →</button></div>            <div className="work-grid">              <div className="clean-panel">                <div className="panel-mini-head"><div><b>Upcoming deadlines</b><small>Never miss your next submission.</small></div><span>⏰</span></div>                {(liveAssignments || []).slice(0,4).map((a,i)=><button className="deadline-row" key={a.id || a.title || i} onClick={() => go('Assignments')}><span className="deadline-dot">{i+1}</span><div><b>{a.title}</b><small>{a.subject} • {a.deadline}</small></div><em>{a.status || 'Open'}</em></button>)}              </div>              <div className="clean-panel">                <div className="panel-mini-head"><div><b>Today’s classes</b><small>Your live academic schedule.</small></div><span>🗓</span></div>                {liveSchedules.length ? liveSchedules.slice(0,4).map((c,i)=><div className="class-clean-row" key={c.id || i}><span>{c.time || 'Today'}</span><div><b>{c.title || 'Class'}</b><small>{c.detail || 'Semester I • CSE (IoT)'}</small></div></div>) : <div className="empty-mini">No class schedule synced yet. Check your faculty timetable for the next session.</div>}              </div>            </div>          </div>          <aside className="progress-panel">            <span className="eyebrow">YOUR PROGRESS</span><h3>Keep your semester moving</h3><div className="progress-big"><strong>{serverData?.stats?.progress ?? 0}%</strong><span>overall</span></div><div className="progress-line"><i style={{width:`${serverData?.stats?.progress ?? 0}%`}} /></div><div className="progress-points"><span>🔥 {serverData?.stats?.streak ?? 0}-day learning streak</span><span>✓ Practice and revision are tracked</span><span>→ Next: continue your weakest topic</span></div><button onClick={() => openDashboardFeature('Academic Twin')}>View progress insights →</button>          </aside>        </section>        <section className="community-home-card">          <div className="community-home-copy"><span className="eyebrow">CAMPUS COMMUNITY</span><h2>Learn with your classmates, not alone.</h2><p>Ask doubts, share useful notes, find study partners and discuss upcoming exams with your batch.</p><div className="community-pills"><span>💬 Doubt discussions</span><span>📚 Resource sharing</span><span>👥 Study groups</span><span>📢 Class updates</span></div></div>          <div className="community-home-action"><div><b>Student Community</b><small>60 CSE (IoT) learners</small></div><button onClick={() => { go('Community'); loadCommunity(); }}>Open Community →</button></div>        </section>        <section className="bottom-academic-row">          <button onClick={() => go('Academic Records')}><span>🎓</span><div><b>Academic Records</b><small>Attendance, performance and academic history</small></div><i>→</i></button>          <button onClick={() => go('Certificates')}><span>🏅</span><div><b>Certificates</b><small>View earned and available certificates</small></div><i>→</i></button>          <button onClick={() => go('Help & Support')}><span>🛟</span><div><b>Help & Support</b><small>Raise a support request when you need help</small></div><i>→</i></button>        </section>      </div>    );  };  /* ============================================================================     Student feature pages. Each one opens as its own premium page — colourful     gradient header, live stat chips, and content read from the CampusLMS     backend. The dashboard layout, sidebar and top bar stay exactly the same.     ========================================================================== */  const liveSubjects = () => serverData?.subjects || subjects;  const renderSubjectsPage = (subtitle) => {    const list = liveSubjects();    const configured = syllabusData?.configuredCourses || [];    const avg = list.length ? Math.round(list.reduce((n, s) => n + Number(s.progress || 0), 0) / list.length) : 0;    const ranked = [...list].sort((a, b) => Number(b.progress) - Number(a.progress));    const strongest = ranked[0];    const weakest = ranked[ranked.length - 1];    const vaultCount = (vaultData?.resources || serverData?.resources || filteredResources).length;    return (      <PremiumPage        tone="blue" icon="📚" eyebrow="MY LEARNING · CSE (IoT) · SEMESTER I" title="My Subjects"        subtitle={subtitle || "Every Semester I subject with live progress, mapped units and one-click entry into notes, practice and tests."}        badge="● Live backend" breadcrumb="Student / Learn / My Subjects"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Subjects", value: list.length, note: "Semester I" },          { label: "Average progress", value: `${avg}%`, note: "across all subjects" },          { label: "Strongest", value: strongest ? `${strongest.progress}%` : "—", note: strongest?.code },          { label: "Needs attention", value: weakest ? `${weakest.progress}%` : "—", note: weakest?.code },        ]}        actions={<>          <button className="secondary-button" onClick={() => { go('Syllabus'); loadSyllabus(); }}>Open Syllabus</button>          <button className="secondary-button" onClick={refreshDashboard}>↻ Refresh progress</button>        </>}      >        <div className="subject-grid px-subject-grid">          {list.map((s) => {            const units = (configured.find((c) => c.code === s.code)?.units || []).length;            return (              <div className="subject-card" key={s.code} onClick={() => openSubject(s)}>                <div className={`subject-icon ${s.color}`}>{s.icon}</div>                <div className="subject-info">                  <span>{s.code}</span>                  <h3>{s.name}</h3>                  <small>Faculty: {s.faculty || 'Campus Faculty'}</small>                  {units > 0 && <small className="px-subject-units">{units} units mapped</small>}                  <div className="progress-row"><div className="progress"><i style={{ width: `${s.progress}%` }} /></div><b>{s.progress}%</b></div>                </div>                <span className="arrow">→</span>              </div>            );          })}        </div>        <div className="px-split">          <div className="tool-panel">            <div className="panel-kicker">SUBJECT BREAKDOWN</div>            <div className="px-subject-table">              {list.map((s) => (                <div key={s.code}>                  <b>{s.name}</b>                  <div className="px-bar"><i style={{ width: `${s.progress}%` }} /></div>                  <span>{s.progress}%</span>                  <em className={`px-flag ${Number(s.progress) < 60 ? 'low' : Number(s.progress) < 75 ? 'mid' : 'high'}`}>{s.status || 'On track'}</em>                </div>              ))}            </div>          </div>          <div className="tool-panel">            <div className="panel-kicker">QUICK START</div>            <div className="px-quick-list">              {[                ['📖', 'Open the Resource Vault', `${vaultCount} notes, PPTs, lectures and PYQs`, () => go('Resources')],                ['✍️', 'Practise questions', 'BEU-aligned practice bank with saved accuracy', () => { go('Question Practice'); loadPracticeQuestions(practiceSubject); }],                ['📝', 'Take a mock test', 'Exam-style paper with a saved result', () => openStudentTool('Mock Tests')],                ['🎙', 'Run a viva round', 'Subjective questions with full AI Analysis', () => openStudentTool('AI Viva Simulator')],              ].map(([i, t, d, f]) => (                <button key={t} onClick={f}><span>{i}</span><div><b>{t}</b><small>{d}</small></div><em>→</em></button>              ))}            </div>          </div>        </div>      </PremiumPage>    );  };  const renderSyllabus = () => {    const configured = syllabusData?.configuredCourses || [];    const official = syllabusData?.officialCurriculum || [];    const open = syllabusOpenCourse;    const totalUnits = configured.reduce((n, c) => n + (c.units || []).length, 0);    const totalCredits = configured.reduce((n, c) => n + (Number(String(c.credits).split(' ')[0]) || 0), 0);    return (      <PremiumPage        tone="indigo" icon="🗂" eyebrow="BEU ACADEMIC CURRICULUM" title="Semester I Syllabus"        subtitle="B.Tech Computer Science & Engineering (IoT) • Government Engineering College Madhubani • session 2026–27. Open a course to read its unit-wise outline."        badge={syllabusData ? "● Synced" : "○ Loading…"} breadcrumb="Student / Learn / Syllabus"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Courses", value: configured.length, note: "mapped to Semester I" },          { label: "Units published", value: totalUnits, note: "topic-wise outlines" },          { label: "Credits", value: totalCredits || "—", note: "BEU credit structure" },          { label: "Reference courses", value: official.length, note: "BEU curriculum list" },        ]}        actions={<>          <button className="secondary-button" disabled={!syllabusData?.officialUrl} onClick={() => window.open(syllabusData?.officialUrl, '_blank')}>Official BEU Syllabus ↗</button>          <button className="secondary-button" disabled={!syllabusData?.regulationUrl} onClick={() => window.open(syllabusData?.regulationUrl, '_blank')}>BEU Regulations ↗</button>          <button className="solid-button" onClick={() => { go('Question Practice'); loadPracticeQuestions(practiceSubject); }}>Practise Questions</button>        </>}      >        <div className="syllabus-grid">          <section className="panel">            <div className="panel-heading"><div><h2>Your Semester I Courses</h2><p>Faculty mapping supplied for this prototype. Click a course to open its working topic outline.</p></div></div>            {configured.map((c) => (              <div className={`syllabus-row clickable ${open === c.code ? 'selected' : ''}`} key={c.code} onClick={() => setSyllabusOpenCourse(open === c.code ? null : c.code)}>                <div className="syllabus-code">{c.code}</div>                <div><strong>{c.name}</strong><span>Faculty: {c.faculty} • {c.status}</span>                  {open === c.code && <div className="syllabus-units">{(c.units || []).map((u, i) => <div key={u}><b>Unit {i + 1}</b><span>{u}</span></div>)}</div>}                </div>                <em>{c.credits} cr</em>              </div>            ))}            {!configured.length && <div className="empty-state">The syllabus is still loading from the backend. Use Refresh to try again.</div>}          </section>          <section className="panel">            <div className="panel-heading"><div><h2>BEU 2026–27 Curriculum Reference</h2><p>Course titles and credits from the university reference set. Always use the linked BEU PDF for the authoritative detailed syllabus.</p></div></div>            {official.map((c, i) => (              <div className="syllabus-row" key={c.name}><div className="syllabus-code">{String(i + 1).padStart(2, '0')}</div><div><strong>{c.name}</strong><span>{c.source || 'BEU 2026 curriculum portal'}</span></div><em>{c.credits} cr</em></div>            ))}            <div className="syllabus-note">BEU's 2026–27 regulations explicitly list CSE (IoT) as a B.Tech discipline. The detailed branch syllabus is maintained on BEU's official B.Tech syllabus portal.</div>          </section>        </div>        <section className="panel syllabus-rules">          <div className="panel-heading"><div><h2>Current BEU Academic Rules</h2><p>The rules that shape your 2026–27 first-year workflow.</p></div></div>          <div className="rules-grid">            <div><b>{syllabusData?.officialRules?.attendance || '75%'}</b><span>Attendance requirement</span></div>            <div><b>{syllabusData?.officialRules?.theory || '30 + 70'}</b><span>Theory assessment</span></div>            <div><b>{syllabusData?.officialRules?.practical || '20 + 30'}</b><span>Practical / sessionals</span></div>            <div><b>{syllabusData?.officialRules?.theoryPass || '35% overall'}</b><span>Theory passing rule</span></div>          </div>        </section>        <div className="syllabus-source"><b>Official sources:</b> Bihar Engineering University B.Tech syllabus portal and the BEU UG Regulation effective from Academic Session 2026–27 onward.</div>      </PremiumPage>    );  };  const renderQuestionPractice = () => {    const q = practiceQuestions[practiceIndex];    const accuracy = practiceStats.accuracy || 0;    return (      <PremiumPage        tone="teal" icon="✍️" eyebrow="PRACTICE & ASSESS" title="Question Practice"        subtitle="BEU-aligned practice questions for your actual Semester I subjects. Every attempt and your accuracy are saved in the backend."        badge={practiceLoading ? "○ Loading…" : "● Live bank"} breadcrumb="Student / Practice / Question Practice"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Accuracy", value: `${accuracy}%`, note: `${practiceStats.correct || 0} of ${practiceStats.total || 0} correct` },          { label: "Question", value: practiceQuestions.length ? `${practiceIndex + 1} / ${practiceQuestions.length}` : "—", note: practiceSubject.replace(/ \(.*\)/, "") },          { label: "Attempts logged", value: practiceStats.total || 0, note: "saved in the backend" },        ]}        actions={<label className="px-select">Subject          <select value={practiceSubject} onChange={(e) => { setPracticeSubject(e.target.value); loadPracticeQuestions(e.target.value); }}>            {['Introduction to AI', 'Programming for Problem Solving (PPS)', 'Engineering Physics', 'Basic Electrical & Electronics Engineering (BEEE)', 'Engineering Mathematics-I', 'Universal Human Values'].map((x) => <option key={x}>{x}</option>)}          </select>        </label>}      >        {practiceLoading ? <div className="panel"><div className="empty-state">Loading questions from the backend…</div></div>          : !q ? <div className="panel"><div className="empty-state">No questions are published for this subject yet.</div></div>          : <div className="practice-card">            <div className="practice-meta"><span>{q.unit}</span><b>Question {practiceIndex + 1} of {practiceQuestions.length}</b></div>            <h2>{q.question}</h2>            <div className="practice-options">{q.options.map((option, i) => <button key={option} disabled={!!practiceFeedback} className={`${practiceSelected === i ? 'selected' : ''} ${practiceFeedback && i === practiceFeedback.answer ? 'correct' : ''} ${practiceFeedback && practiceSelected === i && !practiceFeedback.correct ? 'wrong' : ''}`} onClick={() => setPracticeSelected(i)}><span>{String.fromCharCode(65 + i)}</span>{option}</button>)}</div>            {practiceFeedback && <div className={`practice-feedback ${practiceFeedback.correct ? 'good' : 'bad'}`}><strong>{practiceFeedback.correct ? '✓ Correct' : '✕ Not correct'}</strong><p>{practiceFeedback.explanation}</p><small>Answer: {String.fromCharCode(65 + practiceFeedback.answer)}</small></div>}            <div className="practice-actions">              {!practiceFeedback                ? <button className="solid-button" onClick={submitPracticeAnswer}>Submit Answer</button>                : <button className="solid-button" onClick={nextPracticeQuestion}>Next Question →</button>}              <button className="secondary-button" onClick={() => { setPracticeSelected(null); setPracticeFeedback(null); }}>Reset</button>            </div>          </div>}        <div className="panel practice-note"><b>Important:</b> this section uses a curated BEU-aligned Semester I engineering practice bank. It is not labelled as an official BEU previous-year question paper unless an official paper is available and verified.</div>      </PremiumPage>    );  };  const renderAcademicRecords = () => {    const rec = studentRecord || {};    const att = rec.attendance || serverData?.attendance || {};    const attPct = att.total ? Math.round((att.present * 100) / att.total) : 0;    return (      <PremiumPage        tone="blue" icon="🎓" eyebrow="ACADEMIC RECORDS" title="My Academic Record"        subtitle="Student identity, enrolment and attendance loaded live from the CampusLMS backend."        badge={recordLoaded ? "● Loaded" : "○ Loading…"} breadcrumb="Student / Campus / Academic Records"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Attendance", value: att.total ? `${attPct}%` : "—", note: att.total ? `${att.present} of ${att.total} present` : "not published" },          { label: "Semester", value: rec.semester || serverData?.stats?.semester || "I", note: rec.programme || "B.Tech CSE (IoT)" },          { label: "Overall progress", value: `${serverData?.stats?.progress ?? 0}%`, note: "this semester" },          { label: "Certificates", value: certificates.length, note: "on record" },        ]}        actions={<>          <button className="secondary-button" onClick={loadStudentRecord}>↻ Refresh</button>          <button className="secondary-button" onClick={() => go('Certificates')}>Open Certificates →</button>        </>}      >        <div className="syllabus-grid">          <section className="panel">            <div className="panel-heading"><div><h2>Student Profile</h2><p>Current registration details</p></div></div>            <div className="record-grid">              <div><span>Student ID</span><b>{rec.studentId || 'CSE26-001'}</b></div>              <div><span>Name</span><b>{rec.name || 'Satya Prakash'}</b></div>              <div><span>Programme</span><b>{rec.programme || 'B.Tech CSE (IoT)'}</b></div>              <div><span>Semester</span><b>{rec.semester || 'Semester I'}</b></div>              <div><span>Session</span><b>{rec.session || '2026–27'}</b></div>              <div><span>Status</span><b>{rec.enrollmentStatus || 'Enrolled'}</b></div>            </div>          </section>          <section className="panel">            <div className="panel-heading"><div><h2>Attendance Snapshot</h2><p>Current backend attendance record</p></div></div>            <div className="attendance-big"><strong>{attPct}%</strong><span>{att.present || 0} present out of {att.total || 0}</span></div>            <div className="px-note">BEU requires 75% attendance. You are currently {attPct >= 75 ? 'above' : 'below'} that requirement.</div>          </section>        </div>        <section className="panel">          <div className="panel-heading"><div><h2>Subject Performance</h2><p>Progress per subject from the live dashboard record</p></div></div>          <div className="px-subject-table">{liveSubjects().map((s) => <div key={s.code}><b>{s.name}</b><div className="px-bar"><i style={{ width: `${s.progress}%` }} /></div><span>{s.progress}%</span><em className={`px-flag ${Number(s.progress) < 60 ? 'low' : Number(s.progress) < 75 ? 'mid' : 'high'}`}>{s.status || 'On track'}</em></div>)}</div>        </section>      </PremiumPage>    );  };  const renderCertificates = () => (    <PremiumPage      tone="amber" icon="🏅" eyebrow="DOCUMENTS" title="Certificates"      subtitle="Every certificate record issued to this student profile, downloadable as a verifiable text record."      badge={certificatesLoaded ? "● Loaded" : "○ Loading…"} breadcrumb="Student / Campus / Certificates"      backLabel="Back to Dashboard" onBack={() => go('Dashboard')}      chips={[        { label: "Certificates", value: certificates.length, note: "on record" },        { label: "Issued", value: certificates.filter((c) => c.status === 'Issued').length, note: "already earned" },        { label: "In progress", value: certificates.filter((c) => c.status !== 'Issued').length, note: "awaiting award" },      ]}      actions={<button className="secondary-button" onClick={loadCertificates}>↻ Refresh</button>}    >      <div className="panel">        {certificates.length          ? <div className="workspace-list">{certificates.map((c) => <div key={c.id}><b>{c.title}</b><span>{c.status} • Issued {c.issuedOn}</span><button className="secondary-button" onClick={() => { const text = `CampusLMS Certificate Record\n\n${c.title}\nStudent: Satya Prakash\nID: CSE26-001\nStatus: ${c.status}\nIssued: ${c.issuedOn}`; const blob = new Blob([text], { type: 'text/plain' }); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = `${c.id}.txt`; a.click(); URL.revokeObjectURL(url); }}>Download Record</button></div>)}</div>          : <div className="empty-state">No certificate records are available yet.</div>}      </div>    </PremiumPage>  );  const renderSupport = () => {    const myTickets = (serverData?.tickets || []).filter((t) => t.raisedBy === 'CSE26-001');    return (      <PremiumPage        tone="rose" icon="🛟" eyebrow="STUDENT SUPPORT" title="Help & Support"        subtitle="Raise a trackable academic support ticket, then follow its status until a faculty member closes it."        badge={`● ${myTickets.length} ticket${myTickets.length === 1 ? '' : 's'}`} breadcrumb="Student / Support / Help & Support"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "My tickets", value: myTickets.length, note: "raised by you" },          { label: "Open", value: myTickets.filter((t) => t.status !== 'Resolved').length, note: "awaiting faculty" },          { label: "Resolved", value: myTickets.filter((t) => t.status === 'Resolved').length, note: "closed" },        ]}      >        <div className="px-split">          <div className="tool-panel">            <div className="panel-kicker">NEW SUPPORT TICKET</div>            <input className="workspace-answer" id="support-title" placeholder="What do you need help with?" />            <textarea className="workspace-answer" id="support-desc" rows="5" placeholder="Describe the issue or doubt"></textarea>            <div className="workspace-actions">              <button className="solid-button" onClick={async () => {                const title = document.getElementById('support-title')?.value?.trim();                const description = document.getElementById('support-desc')?.value?.trim();                if (!title) return showToast('Enter a support title.');                try { const r = await api('/api/tickets', { method: 'POST', body: JSON.stringify({ title, description, raisedBy: 'CSE26-001', role: 'Student' }) }); showToast(`Support ticket #${r.ticket.id} created.`); document.getElementById('support-title').value = ''; document.getElementById('support-desc').value = ''; refreshDashboard(); } catch (e) { showToast(e.message); }              }}>Create Support Ticket</button>              <button className="secondary-button" onClick={async () => { closeWorkspace(); setWorkspace({ title: 'AI → Faculty Handoff', action: 'faculty-handoff' }); }}>Send to Faculty via AI</button>            </div>          </div>          <div className="tool-panel">            <div className="panel-kicker">MY RECENT TICKETS</div>            {myTickets.length              ? <div className="workspace-list">{myTickets.map((t) => <div key={t.id}><b>#{t.id} • {t.status}</b><span>{t.title} • {t.description}</span></div>)}</div>              : <div className="empty-state">You have not raised any support ticket yet.</div>}            <div className="workspace-actions"><button className="secondary-button" onClick={refreshDashboard}>↻ Refresh</button></div>          </div>        </div>      </PremiumPage>    );  };  const renderResources = () => {    const all = vaultData?.resources || serverData?.resources || filteredResources;    const vaultResources = all.filter((r) => !selectedSubject || r.subject === selectedSubject.name).filter((r) => !search.trim() || `${r.title} ${r.type} ${r.subject} ${r.module}`.toLowerCase().includes(search.toLowerCase()));    const grouped = vaultResources.reduce((acc, r) => { const key = `${r.subject || 'General'} • ${r.module || 'Module 1'}`; (acc[key] ??= []).push(r); return acc; }, {});    const byType = (t) => all.filter((r) => r.type === t).length;    return (      <PremiumPage        tone="teal" icon="📖" eyebrow="STRUCTURED RESOURCE VAULT" title={selectedSubject ? selectedSubject.name : 'Academic Resources'}        subtitle="Department › Semester › Subject › Module › Lecture notes, PPTs, PYQs and recorded lectures — every item opens the real stored record."        badge="● Live backend" breadcrumb="Student / Learn / Resource Vault"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Resources", value: all.length, note: "in the vault" },          { label: "Notes", value: byType('Notes'), note: "lecture notes" },          { label: "PYQs", value: byType('PYQ'), note: "previous-year papers" },          { label: "Lectures", value: byType('Lecture'), note: "recorded sessions" },        ]}        actions={<>          <div className="search-box px-search">⌕ <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Search notes, PYQs, PPTs, lectures…" /></div>          <button className="secondary-button" onClick={() => { setSearch(''); setSelectedSubject(null); loadVault(); }}>Clear &amp; refresh</button>        </>}      >        {selectedSubject && <div className="module-banner"><div><span>Filtered subject</span><h2>{selectedSubject.name}</h2><small>{selectedSubject.code} • {selectedSubject.progress}% complete</small></div><button className="secondary-button" onClick={() => setSelectedSubject(null)}>Show all subjects</button></div>}        {Object.entries(grouped).map(([group, items]) => (          <section className="panel" key={group}>            <div className="panel-heading"><div><span className="eyebrow">{items[0]?.department || 'CSE (IoT)'} / {items[0]?.semester || 'Semester I'}</span><h2>{group}</h2><p>Open the actual stored resource record. Nothing here is a dead link.</p></div><span className="px-count">{items.length} item{items.length === 1 ? '' : 's'}</span></div>            <div className="resource-grid">{items.map((r, i) => <div className="resource-card" key={r.id || i}><div className="resource-file">{r.type === 'Lecture' ? '▶' : r.type === 'PYQ' ? 'Q' : r.type === 'PPT' ? 'P' : 'N'}</div><div className="resource-content"><span className="resource-type">{r.type}</span><h3>{r.title}</h3><p>{r.subject} • {r.module}</p><small>{r.size} • Backend resource ID {r.id}</small></div><button className="open-resource" onClick={() => openResource(r)}>Open →</button></div>)}</div>          </section>        ))}        {!vaultResources.length && <div className="empty-state">No resource matches this filter yet. Faculty can publish a new resource into the same hierarchy.</div>}      </PremiumPage>    );  };  const renderAssignments = () => {    const list = serverData?.assignments || assignments;    const pending = list.filter((a) => !((a.submittedBy || []).includes('CSE26-001'))).length;    const submittedCount = list.filter((a) => (a.submittedBy || []).includes('CSE26-001')).length;    return (      <PremiumPage        tone="orange" icon="📌" eyebrow="ASSIGNMENT EVALUATION ENGINE" title="Assignments"        subtitle="Deadline lockout • file preview • submission tracking • similarity checks • faculty grading — all against the live backend records."        badge="● Live deadlines" breadcrumb="Student / Practice / Assignments"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Assignments", value: list.length, note: "this semester" },          { label: "Pending", value: pending, note: "not submitted yet" },          { label: "Submitted", value: submittedCount, note: "recorded" },          { label: "Locked", value: list.filter((a) => a.locked).length, note: "deadline passed" },        ]}        actions={<>          <button className="secondary-button" onClick={refreshDashboard}>↻ Refresh</button>          <button className="secondary-button" onClick={() => go('Academic Records')}>View record →</button>        </>}      >        <div className="assignment-list">          {list.map((item, index) => {            const locked = Boolean(item.locked) || (item.deadline && new Date(`${item.deadline}T23:59:59+05:30`).getTime() < Date.now());            const mine = (item.submittedBy || []).includes('CSE26-001');            return (              <div className="large-assignment" key={item.id || index}>                <div className="large-assignment-icon">📝</div>                <div className="large-assignment-info"><span>{item.subject}</span><h2>{item.title}</h2><p>Deadline: <b>{item.deadline}</b> {locked ? <strong> • LOCKED</strong> : <span> • Open for submission</span>}</p><small>{item.submissions?.length || 0} submission(s) • Status: {item.status}</small></div>                <div className="assignment-action">                  <span className={`badge ${item.status === 'Submitted' ? 'done' : 'pending'}`}>{locked ? 'Locked' : item.status}</span>                  {mine ? <button className="secondary-button" onClick={() => showToast('Your submission is already recorded in the backend.')}>Submitted ✓</button>                    : locked ? <button className="secondary-button" disabled>Submission Locked</button>                      : <label className="primary-small upload-label">Preview &amp; Submit<input type="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.txt" hidden onChange={(e) => e.target.files?.[0] && previewAssignmentFile(item, e.target.files[0])} /></label>}                </div>              </div>            );          })}        </div>        {submitted && <div className="success-message">✓ Submission saved. Faculty evaluation and similarity checks are available from the faculty dashboard.</div>}      </PremiumPage>    );  };  const renderCommunity = () => (    <PremiumPage      tone="violet" icon="♟" eyebrow="CAMPUS COMMUNITY" title="Student Community"      subtitle="One place for CSE (IoT) students to ask doubts, share useful notes, find study partners and stay updated."      badge="● Live feed" breadcrumb="Student / Campus / Community"      backLabel="Back to Dashboard" onBack={() => go('Dashboard')}      chips={[        { label: "Batch members", value: 60, note: "CSE (IoT) Sem I" },        { label: "Discussions", value: communityPosts.length, note: "live threads" },        { label: "Study groups", value: 12, note: "active spaces" },      ]}      actions={<>        <button className="secondary-button" onClick={loadCommunity}>↻ Refresh feed</button>        <button className="solid-button" onClick={() => { loadCommunity(); }}>Load latest posts</button>      </>}    >      <div className="community-page-grid community-enhanced-grid">        <div>          <div className="panel community-compose">            <div className="panel-heading"><div><h2>Start a discussion</h2><p>Ask a doubt, share a resource or help a classmate.</p></div><span className="community-compose-icon">💬</span></div>            <div className="community-topic-row"><span>Discussion</span><span>📚 Resource</span><span>❓ Doubt</span><span>👥 Study group</span></div>            <textarea className="full-input community-textarea" rows="5" value={communityText} onChange={(e) => setCommunityText(e.target.value)} placeholder="What would you like to discuss with your batch?"></textarea>            <button className="solid-button community-post-button" onClick={publishCommunityPost}>Publish to batch →</button>          </div>          <div className="panel community-groups">            <div className="panel-heading"><div><h2>Study spaces</h2><p>Find classmates around a common goal.</p></div></div>            <div className="study-group-grid">              <button onClick={() => { setCommunityText('Anyone joining a Maths revision group for Integration and Definite Integrals?'); }}><span>∑</span><b>Maths Revision</b><small>Integration • 18 members</small></button>              <button onClick={() => { setCommunityText('Looking for PPS practice partners — pointers and recursion this week.'); }}><span>&lt;/&gt;</span><b>PPS Practice</b><small>C basics • 14 members</small></button>              <button onClick={() => { setCommunityText('Physics lab record help — anyone done the optics experiment write-up?'); }}><span>⚛</span><b>Physics Lab Help</b><small>Lab records • 11 members</small></button>            </div>          </div>        </div>        <div className="panel community-feed">          <div className="panel-heading"><div><h2>Latest discussions</h2><p>Recent conversations from your campus.</p></div><span className="live-feed">● Live</span></div>          <div className="community-posts">            {communityPosts.length              ? communityPosts.map((post) => <div className="community-post" key={post.id}>                <div className="avatar">{String(post.author || 'S').slice(0, 1)}</div>                <div className="community-post-body">                  <div className="post-meta"><strong>{post.author}</strong><small>{post.role} • {new Date(post.createdAt).toLocaleString()}</small></div>                  <p>{post.text}</p>                  <div className="post-actions">                    <button onClick={async () => { try { const r = await api(`/api/community/posts/${post.id}/like`, { method: 'POST', body: JSON.stringify({ userId: 'CSE26-001', role }) }); setCommunityPosts((items) => items.map((x) => x.id === r.post.id ? r.post : x)); } catch (e) { showToast(e.message); } }}>♥ {post.likes || 0}</button>                    <button onClick={async () => { const text = window.prompt('Write a comment'); if (!text?.trim()) return; try { const r = await api(`/api/community/posts/${post.id}/comments`, { method: 'POST', body: JSON.stringify({ author: role === 'Faculty' ? (serverData?.user?.name || facultyDirectory.find((f) => f.id === facultyId)?.name || 'Faculty') : 'Satya Prakash', role, text }) }); setCommunityPosts((items) => items.map((x) => x.id === r.post.id ? r.post : x)); } catch (e) { showToast(e.message); } }}>💬 {post.comments?.length || 0}</button>                  </div>                  {post.comments?.slice(-3).map((c) => <div className="community-comment" key={c.id}><b>{c.author}</b><span>{c.text}</span></div>)}                </div>              </div>)              : <div className="empty-state">No discussions yet. Start the first conversation for your batch.</div>}          </div>        </div>      </div>    </PremiumPage>  );  const renderFaculty = () => <><div className="page-title"><div><div className="eyebrow">FACULTY WORKSPACE</div><h1>Faculty Dashboard</h1><p>Manage resources, assignments and student submissions.</p></div></div><div className="stats-grid"><div className="stat-card"><div className="stat-icon blue-bg">👥</div><div><span>Students</span><strong>60</strong><small>Enrolled</small></div></div><div className="stat-card"><div className="stat-icon orange-bg">📝</div><div><span>Submissions</span><strong>48</strong><small>Received</small></div></div><div className="stat-card"><div className="stat-icon green-bg">✓</div><div><span>Evaluated</span><strong>36</strong><small>60% completed</small></div></div><div className="stat-card"><div className="stat-icon purple-bg">📚</div><div><span>Resources</span><strong>42</strong><small>Published</small></div></div></div><div className="panel faculty-panel"><div className="panel-heading"><div><h2>Recent Assignment Submissions</h2><p>Review and evaluate student work</p></div><button className="primary-small" onClick={() => runAction("New assignment form opened.")}>+ New Assignment</button></div>{["Rahul Kumar","Priya Singh","Aman Jha","Neha Sharma"].map(name=><div className="submission-row" key={name}><div className="avatar">{name.charAt(0)}</div><div><strong>{name}</strong><span>Programming Assignment 02 • Submitted today</span></div><button className="secondary-button" onClick={() => runAction(`Reviewing ${name}'s PDF.`)}>Review PDF</button></div>)}</div></>;  const renderCR = () => <><div className="page-title"><div><div className="eyebrow">CLASS REPRESENTATIVE</div><h1>CR Dashboard</h1><p>Keep your class informed and connected.</p></div></div><div className="two-columns"><div className="panel"><div className="panel-heading"><div><h2>Class Announcements</h2><p>Share important updates</p></div></div><input className="full-input" placeholder="Announcement title"/><textarea className="full-input" rows="4" placeholder="Write your class announcement..." value={announcement} onChange={(e)=>setAnnouncement(e.target.value)}/><button className="login-button" onClick={()=>{if(announcement.trim()){publishAnnouncement("Class Announcement", announcement);setAnnouncement("");}}}>Publish Announcement</button>{announcements.map((a,i)=><div className="update" key={i}><div className="update-dot blue-dot">📢</div><div><strong>{a.title || a}</strong><span>Just now</span></div></div>)}</div><div className="panel"><div className="panel-heading"><div><h2>Upcoming</h2><p>Important class events</p></div></div><div className="update"><div className="update-dot blue-dot">📅</div><div><strong>Internal Assessment</strong><span>30 September</span></div></div><div className="update"><div className="update-dot orange-dot">📝</div><div><strong>Assignment submissions</strong><span>28 September</span></div></div></div></div></>;  const renderAI = () => <PremiumPage    tone="blue" icon="✦" eyebrow="CAMPUSLMS INTELLIGENCE" title="AI Academic Assistant"    subtitle="Ask about your subjects, resources, assignments, study plans and exams. CampusAI answers with the same live data your dashboard uses."    badge="● CampusAI online" breadcrumb="Student / Campus / AI Assistant"    backLabel="Back to Dashboard" onBack={() => go('Dashboard')}    chips={[      { label: "Messages", value: aiMessages.length, note: "in this thread" },      { label: "Subjects", value: (serverData?.subjects || subjects).length, note: "in context" },      { label: "Pending work", value: serverData?.stats?.pendingAssignments ?? 0, note: "assignments" },    ]}  >    <div className="ai-chat px-ai-chat">      <div className="ai-thread">{aiMessages.map((m,i)=><div className={`ai-message ${m.role === "user" ? "user" : "bot"}`} key={i}><span className="ai-avatar">{m.role === "user" ? "SP" : "✦"}</span><div><strong>{m.role === "user" ? "You" : "CampusAI"}</strong><p>{m.text}</p>{m.data?.items && <div className="ai-data">{m.data.items.map((x,j)=><span key={j}>{x}</span>)}</div>}</div></div>)}</div>      <div className="suggestions"><button onClick={()=>setAiInput("Show my pending assignments")}>📋 Pending assignments</button><button onClick={()=>setAiInput("Make me a 30 minute study plan")}>⏱ 30-minute plan</button><button onClick={()=>setAiInput("What should I study next?")}>🧭 What next?</button><button onClick={()=>askAI("Explain my weakest subject and give me a revision plan")}>🎯 Weakest subject</button></div>      <div className="ai-composer"><input value={aiInput} onChange={e=>setAiInput(e.target.value)} onKeyDown={e=>e.key==='Enter'&&askAI()} placeholder="Ask CampusAI anything about your academics..."/><button onClick={askAI}>Send →</button></div>    </div>  </PremiumPage>;  const renderStudentToolBody = (tool) => {    const rescueSteps = ['Review your current weak topic','Practice 5 targeted questions','Complete a PYQ set','Take a mini test'];    const examChecklist = ['Open AI Summary','Review important formulas','Attempt PYQ rapid test','Take quick mock test','Start a 10-minute focus session'];    if (tool==='Academic Twin') {      const a=studentToolState.analysis || smartToolsData?.twin || {};      const profile=a.profile || subjects.map(s=>({name:s.name,progress:s.progress,status:s.status}));      return <div className="tool-page smart-tool-page">        <div className="tool-hero twin-hero"><span className="tool-icon">🧠</span><div><div className="eyebrow">PERSONAL LEARNING PROFILE</div><h1>Academic Twin</h1><p>A living academic snapshot built from your subject progress, attendance, practice and assignment activity.</p></div><div className="twin-status"><span>●</span> Live profile</div></div>        <div className="twin-grid">          <div className="tool-panel twin-main"><div className="panel-kicker">AT A GLANCE</div><div className="twin-score-row"><div className="twin-score"><strong>{a.avg ?? '—'}%</strong><span>academic progress</span></div><div><b>{a.risk || 'On track'}</b><p>{a.recommendation || 'Refresh your analysis to calculate your next focus.'}</p></div></div>            <div className="twin-metrics"><div><b>{a.attendance?.percentage ?? a.attendancePct ?? '—'}%</b><span>Attendance</span></div><div><b>{a.assignmentCompletion ?? '—'}%</b><span>Assignments</span></div><div><b>{a.practiceAccuracy ?? '—'}%</b><span>Practice accuracy</span></div><div><b>{a.consistency ?? '—'}%</b><span>Study consistency</span></div></div>          </div>          <div className="tool-panel twin-focus"><div className="panel-kicker">NEXT BEST ACTION</div><h3>{a.weakest?.name || 'Choose a subject'}</h3><p>{a.weakest?.progress ?? '—'}% progress • {a.weakest?.status || 'Needs focus'}</p><div className="focus-list">{(a.focusPlan||['Refresh analysis to get a personalised focus plan.']).map((x,i)=><div key={i}><span>{i+1}</span>{x}</div>)}</div></div>        </div>        <div className="tool-panel twin-subjects"><div className="panel-kicker">SUBJECT MAP</div><div className="workspace-list">{profile.map(x=><div key={x.name}><b>{x.name}</b><span>{x.progress}% • {x.status} • {x.faculty||'Faculty mapped'}</span><i style={{width:`${x.progress}%`}} /></div>)}</div><div className="workspace-actions"><button className="solid-button" onClick={async()=>{const r=await api('/api/student-dashboard/academic-twin');await saveStudentTool('Academic Twin',{analysis:r,updatedAt:new Date().toISOString()});setStudentToolState(v=>({...v,analysis:r}));showToast('Academic Twin refreshed from your latest academic data.');}}>Refresh My Twin</button><button className="secondary-button" onClick={()=>openStudentTool('Learning Path')}>Build My Next Path →</button></div></div>      </div>;    }    if (tool==='Learning Path') {      const states=studentToolState.steps || [false,false,false,false]; const labels=['Review current weak topic','Practice 5 targeted questions','Complete a PYQ set','Take a mini test']; const done=states.filter(Boolean).length;      return <div className="tool-page"><span className="tool-icon">🧭</span><div className="eyebrow">LEARNING PATH</div><h1>Learning Path</h1><p>Concept → Learn → Practice → PYQ → Test, with progress stored in the backend.</p><div className="tool-panel"><div className="workflow-progress"><div><strong>{done}/4</strong><span>steps completed</span></div><div className="workflow-bar"><i style={{width:`${done*25}%`}}/></div></div><div className="workspace-list">{labels.map((x,i)=><button key={x} className={`workflow-step ${states[i]?'done':''} ${!states[i]&&i===done?'current':''}`} disabled={states[i]||i!==done} onClick={async()=>{await api(`/api/workflows/${i}`,{method:'PATCH',body:JSON.stringify({done:true})});setStudentToolState(v=>({...v,steps:[...(v.steps||[false,false,false,false]).map((z,j)=>j===i?true:z)]}));showToast(`Step ${i+1} completed and saved.`);}}><b>{states[i]?'✓':i+1}</b><span>{x}</span>{i===done&&!states[i]&&<em>Complete</em>}</button>)}</div>{done===4&&<div className="success-message">✓ Learning Path completed and saved.</div>}</div></div>;    }    if (tool==='30-Min Rescue') {      const done = Number(studentToolState.step || 0);      const phaseLabel = pomo.phase === 'focus' ? 'Focus' : 'Break';      return <div className="tool-page smart-tool-page">        <div className="tool-hero rescue-hero"><span className="tool-icon">⏱</span><div><div className="eyebrow">LIVE WORKSPACE</div><h1>30-Min Rescue</h1><p>Run a real focus block with a Pomodoro timer, then finish the four-stage rescue plan.</p></div><span className="live-chip">● {minutesToday} min today</span></div>        <div className="rescue-layout">          <div className="tool-panel pomo-panel">            <div className="panel-kicker">FOCUS SESSION</div>            <div className="pomo-ring-wrap"><div className={`pomo-ring ${pomo.phase} ${pomo.running?'running':''}`} style={{'--elapsed':`${Math.min(100, Math.round((pomoElapsed / Math.max(1, pomoTotal)) * 100))}%`}}><strong>{pomoClock}</strong><span>{phaseLabel}</span></div></div>            <div className="pomo-controls"><button className="solid-button" onClick={()=>setPomo(v=>({...v,running:!v.running}))}>{pomo.running?'❚❚ Pause':'▶ Start focus'}</button><button className="secondary-button" onClick={()=>setPomo(v=>({...v,running:false,remaining:v.remaining}))} onDoubleClick={()=>setPomo(v=>({...v,running:false,completed:null,remaining:v.focusLength*60,phase:'focus'}))}>↺ Reset</button><button className="secondary-button" disabled={pomo.running} onClick={()=>logFocusSession(Math.max(1, Math.round((pomoTotal - pomo.remaining)/60)) || 1, 'Manual focus session')}>✓ Log session</button></div>            <div className="pomo-lengths">{[15,25,45].map(m=><button key={m} className={pomo.focusLength===m?'active':''} disabled={pomo.running} onClick={()=>setPomo(v=>({...v,focusLength:m,remaining:m*60,phase:'focus'}))}>{m} min</button>)}</div>            <p className="muted">Leaving this tool pauses the timer so your session is never left running unattended.</p>          </div>          <div className="rescue-side">            <div className="tool-panel daily-target"><div className="panel-kicker">DAILY STUDY TARGET</div><div className="target-head"><strong>{minutesToday}</strong><span>/ {dailyTarget} min today</span></div><div className="target-bar"><i style={{width:`${targetPct}%`}} /></div><small>{targetPct>=100?'✓ Daily target reached — great work.':`${Math.max(0,dailyTarget-minutesToday)} minutes to go to hit today's target.`}</small><label className="target-input">Daily target (minutes)<input type="number" min="15" step="15" value={dailyTarget} onChange={async e=>{const v=Math.max(15,Number(e.target.value)||15);setPomo(x=>({...x}));await saveStudentTool('30-Min Rescue',{...rescueStore(studentToolState),dailyTarget:v});}}/></label></div>            <div className="tool-panel session-log"><div className="panel-kicker">FOCUS SESSION LOG</div>{(rescueState.sessions||[]).length?<div className="workspace-list">{(rescueState.sessions||[]).map((s,i)=><div key={s.at||i}><b>{s.minutes} min</b><span>{s.label} • {new Date(s.at).toLocaleString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}</span></div>)}</div>:<div className="empty-state">No focus sessions logged yet. Start the timer or log a completed block.</div>}</div>          </div>        </div>        <div className="tool-panel rescue-steps"><h2>Smart Academic Workflow</h2><p>Complete the four stages in order. Your progress remains saved after refresh.</p><div className="workflow-progress"><div><strong>{Math.min(done,4)}/4</strong><span>steps completed</span></div><div className="workflow-bar"><i style={{width:`${Math.min(done,4)*25}%`}}/></div></div><div className="workspace-list">{rescueSteps.map((x,i)=><button key={x} className={`workflow-step ${i<done?'done':''} ${i===done?'current':''}`} disabled={i!==done} onClick={async()=>{const next=i+1;await saveStudentTool('30-Min Rescue',{...rescueStore(studentToolState),step:next});showToast(`Step ${next} completed and saved.`);}}><b>{i<done?'✓':i+1}</b><span>{x}</span>{i===done&&<em>Complete</em>}</button>)}</div>{done>=4?<div className="success-message">✓ 30-Min Rescue completed. Your progress is saved.</div>:<p className="muted">Next: {rescueSteps[done]}</p>}</div>      </div>;    }    if (tool==='Smart Revision Hub') {      const cards = studentToolState.cards || [];      const notes = resources.filter(r=>r.type==='Notes'), pyqs = resources.filter(r=>r.type==='PYQ');      const quickRevise = async (subject) => {        setToolBusy(true);        try {          const r = await api('/api/ai/chat',{method:'POST',body:JSON.stringify({role,message:`Create a fast one-page revision card for ${subject}: 5 must-know points, 3 formulas or key definitions, and 3 self-test questions.`})});          const card = {id:`RC-${Date.now()}`,subject,body:r.reply,createdAt:new Date().toISOString()};          await saveStudentTool('Smart Revision Hub',{cards:[card,...cards].slice(0,8)});          showToast(`Revision card ready for ${subject}.`);        } catch(e){ showToast(e.message); } finally { setToolBusy(false); }      };      return <div className="tool-page smart-tool-page">        <div className="tool-hero revision-hero"><span className="tool-icon">✦</span><div><div className="eyebrow">ONE-CLICK REVISION</div><h1>Smart Revision Hub</h1><p>Notes, PYQs and AI revision cards in one place. Pick a subject and revise without hunting through modules.</p></div><span className="live-chip">● {cards.length} cards</span></div>        <div className="revision-grid">          {revisionSubjects.map(s=>{            const hasNotes=notes.some(n=>n.subject.includes(s.code.slice(0,3))||n.subject===s.name), hasPyq=pyqs.some(p=>p.subject.includes(s.code.slice(0,3))||p.subject===s.name);            const card = cards.find(c=>c.subject===s.name);            return <div className="revision-card" key={s.code}><div className="revision-card-head"><b>{s.name}</b><span>{s.code}</span></div><p>{s.focus}</p><div className="revision-tags"><span className={hasNotes?'ok':''}>Notes {hasNotes?'✓':'—'}</span><span className={hasPyq?'ok':''}>PYQs {hasPyq?'✓':'—'}</span></div><div className="workspace-actions"><button className="solid-button" disabled={toolBusy} onClick={()=>quickRevise(s.name)}>{toolBusy?'Working…':'Quick Revise'}</button><button className="secondary-button" onClick={()=>{openStudentTool('AI Summary');setTimeout(()=>{},0);}}>Notes →</button></div>{card&&<div className="revision-card-body"><b>Saved card</b><p>{card.body}</p><button className="secondary-button" onClick={()=>speakText(card.body)}>🔊 Read aloud</button></div>}</div>;          })}        </div>        <div className="tool-panel revision-lib"><div className="panel-kicker">NOTES & PYQS IN YOUR VAULT</div><div className="revision-lib-grid"><div><h3>Notes</h3>{notes.length?notes.map(n=><button className="deadline-row" key={n.title} onClick={()=>openStudentTool('AI Summary')}><span className="deadline-dot">📖</span><div><b>{n.title}</b><small>{n.subject} • {n.size}</small></div><em>Revise</em></button>):<div className="empty-state">No notes in your vault yet.</div>}</div><div><h3>Previous Year Questions</h3>{pyqs.length?pyqs.map(p=><button className="deadline-row" key={p.title} onClick={()=>openStudentTool('Mock Tests')}><span className="deadline-dot">✍️</span><div><b>{p.title}</b><small>{p.subject} • {p.size}</small></div><em>Practice</em></button>):<div className="empty-state">No PYQs in your vault yet.</div>}</div></div></div>      </div>;    }    if (tool==='Placement & Career Hub') {      const career = studentToolState || {};      const resume = resumeDraft || career.resume || { name: 'Satya Prakash', email: 'satya.prakash@gec.edu.in', branch: 'B.Tech Computer Science & Engineering — Semester I', cgpa: '8.4', skills: 'C, Python, DBMS, MS Office', projects: 'No major project yet — add your first semester project.', objective: 'To secure a software engineering internship while strengthening my DSA and core engineering subjects.' };      const interests = career.interests || [];      const roadmap = career.roadmap || {};      const aptitudeAttempts = career.aptitude || [];      const q = aptitudeQuestions[aptIndex] || aptitudeQuestions[0];      const aptitudeScore = aptitudeAttempts.length ? Math.round((aptitudeAttempts.filter(x=>x.correct).length / aptitudeAttempts.length) * 100) : 0;      const pick = (k, v) => setResumeDraft({ ...resume, [k]: v });      const saveResume = async () => { await saveStudentTool('Placement & Career Hub', { ...career, resume }); showToast('Resume saved to the backend.'); };      const checkAptitude = async () => {        if (!aptPicked) return showToast('Choose an option first.');        const correct = aptPicked === q.answer;        const attempt = { id: q.id, section: q.section, picked: aptPicked, correct, at: new Date().toISOString() };        const next = [...aptitudeAttempts, attempt];        await saveStudentTool('Placement & Career Hub', { ...career, aptitude: next });        setAptResult({ correct, answer: q.answer });        showToast(correct ? 'Correct — logged to your aptitude record.' : `Not quite. The answer is ${q.answer}.`);      };      return <div className="tool-page smart-tool-page">        <div className="tool-hero career-hero"><span className="tool-icon">🚀</span><div><div className="eyebrow">PLACEMENT & CAREER</div><h1>Placement &amp; Career Hub</h1><p>Resume, internships, aptitude practice and a semester-by-semester career roadmap — saved in your student workspace.</p></div><span className="live-chip">● Aptitude {aptitudeScore}%</span></div>        <div className="career-grid">          <div className="tool-panel resume-panel">            <div className="panel-kicker">RESUME</div>            <label>Full name<input value={resume.name} onChange={e=>pick('name',e.target.value)} /></label>            <label>Email<input value={resume.email} onChange={e=>pick('email',e.target.value)} /></label>            <label>Branch &amp; semester<input value={resume.branch} onChange={e=>pick('branch',e.target.value)} /></label>            <label>CGPA<input value={resume.cgpa} onChange={e=>pick('cgpa',e.target.value)} /></label>            <label>Skills<input value={resume.skills} onChange={e=>pick('skills',e.target.value)} /></label>            <label>Projects<textarea rows="3" value={resume.projects} onChange={e=>pick('projects',e.target.value)} /></label>            <label>Objective<textarea rows="3" value={resume.objective} onChange={e=>pick('objective',e.target.value)} /></label>            <div className="workspace-actions"><button className="solid-button" onClick={saveResume}>Save Resume</button><button className="secondary-button" disabled={toolBusy} onClick={async()=>{setToolBusy(true);try{const r=await api('/api/ai/chat',{method:'POST',body:JSON.stringify({role,message:`Improve this student resume for software engineering placements. Give 5 specific fixes, then a polished rewrite.\nName: ${resume.name}\nBranch: ${resume.branch}\nCGPA: ${resume.cgpa}\nSkills: ${resume.skills}\nProjects: ${resume.projects}\nObjective: ${resume.objective}`})});await saveStudentTool('Placement & Career Hub',{...career,resumeFeedback:r.reply});showToast('Resume feedback generated and saved.');}catch(e){showToast(e.message)}finally{setToolBusy(false)}}}>{toolBusy?'Reviewing…':'AI Resume Review'}</button></div>            {career.resumeFeedback&&<div className="ai-result"><h3>AI Resume Feedback</h3><p>{career.resumeFeedback}</p></div>}          </div>          <div className="career-side">            <div className="tool-panel"><div className="panel-kicker">INTERNSHIP OPPORTUNITIES</div><div className="workspace-list">{internshipOpportunities.map(o=>{const marked=interests.includes(o.id);return <div key={o.id}><b>{o.role} — {o.company}</b><span>{o.mode} • {o.duration} • {o.stipend} • {o.skills} • closes {o.closes}</span><button className={marked?'career-tag on':'career-tag'} onClick={async()=>{const next=marked?interests.filter(x=>x!==o.id):[...interests,o.id];await saveStudentTool('Placement & Career Hub',{...career,interests:next});showToast(marked?'Removed from your shortlist.':'Added to your internship shortlist.');}}>{marked?'✓ Shortlisted':'Shortlist'}</button></div>;})}</div></div>            <div className="tool-panel"><div className="panel-kicker">APTITUDE PRACTICE</div><div className="apt-head"><span>{q.section}</span><b>Question {aptIndex+1} of {aptitudeQuestions.length}</b></div><p className="apt-question">{q.question}</p><div className="apt-options">{q.options.map(o=><label key={o} className={aptPicked===o?'picked':''}><input type="radio" name="apt" checked={aptPicked===o} onChange={()=>{setAptPicked(o);setAptResult(null);}} />{o}</label>)}</div><div className="workspace-actions"><button className="solid-button" onClick={checkAptitude}>Check Answer</button><button className="secondary-button" onClick={()=>{setAptIndex((aptIndex+1)%aptitudeQuestions.length);setAptPicked(null);setAptResult(null);}}>Next Question →</button></div>{aptResult&&<div className={`success-message ${aptResult.correct?'':'wrong'}`}>{aptResult.correct?'✓ Correct answer.':'✗ Correct answer: '+aptResult.answer}</div>}<small className="muted">Attempted {aptitudeAttempts.length} • Accuracy {aptitudeScore}%</small></div>            <div className="tool-panel"><div className="panel-kicker">CAREER ROADMAP</div><div className="workspace-list">{careerStages.map(s=>{const st=roadmap[s.id]||s.status;return <button key={s.id} className={`career-stage ${st}`} onClick={async()=>{const nxt=st==='done'?'next':'done';await saveStudentTool('Placement & Career Hub',{...career,roadmap:{...roadmap,[s.id]:nxt}});showToast(`${s.title} marked as ${nxt}.`);}}><b>{s.stage}</b><span>{s.title} — {s.detail}</span><em>{st}</em></button>;})}</div></div>          </div>        </div>      </div>;    }    if (tool==='Mock Tests') {      const paper = mockPaper || [];      const current = paper[mockIndex] || null;      const answered = Object.keys(mockPicks).length;      const MOCK_SUBJECTS = ['Introduction to AI','Programming for Problem Solving (PPS)','Engineering Physics','Basic Electrical & Electronics Engineering (BEEE)','Engineering Mathematics-I','Universal Human Values'];      const loadMockPaper = async (minutes = 10) => {        setMockBusy(true);        try {          // Draw questions across the whole Semester I bank, not just one subject.          const collected = [];          for (const subject of MOCK_SUBJECTS) {            if (collected.length >= 8) break;            const r = await api(`/api/question-bank?subject=${encodeURIComponent(subject)}`).catch(() => null);            (r?.questions || []).slice(0, 2).forEach((q) => collected.push({ ...q, subject }));          }          if (!collected.length) { setPracticeSubject(practiceSubject); await loadPracticeQuestions(practiceSubject); showToast('Loaded the practice bank — press Start test to build a paper.'); return; }          setMockPaper(collected.slice(0, 8));          setMockPicks({}); setMockIndex(0); setMockResult(null);          setMockSeconds(minutes * 60); setMockRunning(true);          showToast(`${Math.min(8, collected.length)}-question paper ready. Timer started.`);        } catch (e) { showToast(e.message); }        finally { setMockBusy(false); }      };      const submitMock = async () => {        if (!paper.length) return;        const correct = paper.filter((q) => mockPicks[q.id] === q.answer).length;        const score = Math.round((correct / paper.length) * 100);        const result = { score, correct, total: paper.length, subject: mockPaper[0]?.subject || 'Mixed', at: new Date().toISOString() };        setMockResult(result); setMockRunning(false);        try { await saveStudentTool('Mock Tests', { lastResult: result, attempts: (studentToolState.attempts || 0) + 1, score }); } catch {}        showToast(`Mock submitted — ${correct} of ${paper.length} correct (${score}%).`);      };      const history = studentToolState.lastResult;      const mm = String(Math.floor(mockSeconds / 60)).padStart(2, '0'), ss = String(mockSeconds % 60).padStart(2, '0');      return <PremiumPage        tone="indigo" icon="📝" eyebrow="TESTS & MOCKS · EXAM PRACTICE" title="Tests & Mocks"        subtitle="Build a timed paper from the Semester I question bank, attempt every question, then get an instant score that is saved to the backend."        badge={mockRunning ? "● Test in progress" : mockResult ? "● Submitted" : "● Ready"} breadcrumb="Student / Practice / Tests & Mocks"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Questions", value: paper.length || 8, note: "drawn from the bank" },          { label: "Answered", value: answered, note: `of ${paper.length || 8}` },          { label: "Time left", value: `${mm}:${ss}`, note: mockRunning ? "counting down" : "paused" },          { label: "Last score", value: history ? `${history.score}%` : "—", note: history ? `${history.correct}/${history.total} correct` : "no attempt yet" },        ]}        actions={<>          <button className="solid-button" disabled={mockBusy || mockRunning} onClick={() => loadMockPaper(10)}>{mockBusy ? 'Building paper…' : paper.length ? 'New 10-minute test' : 'Start 10-minute test'}</button>          <button className="secondary-button" onClick={() => { setMockRunning(false); setMockPaper(null); setMockPicks({}); setMockResult(null); setMockSeconds(600); }}>Reset</button>        </>}      >        {!paper.length && <div className="tool-panel">          <div className="panel-kicker">HOW THE MOCK WORKS</div>          <div className="px-quick-list">            {[              ['📚', 'Questions come from the live bank', 'Eight questions are drawn across your six Semester I subjects.', null],              ['⏱', 'Ten minutes on the clock', 'The timer starts with the paper and stops when you submit.', null],              ['✓', 'Instant scoring', 'Your score, correct count and the attempt are saved to the backend.', null],              ['🎯', 'Use it to find weak spots', 'Revisit every subject you got wrong with Question Practice.', () => { go('Question Practice'); loadPracticeQuestions(practiceSubject); }],            ].map(([i, t, d, f]) => <button key={t} onClick={f || undefined} style={f ? undefined : { cursor: 'default' }}><span>{i}</span><div><b>{t}</b><small>{d}</small></div>{f ? <em>→</em> : <em />}</button>)}          </div>        </div>}        {paper.length > 0 && !mockResult && <>          <div className="tool-panel mock-card">            <div className="practice-meta"><span>{current?.subject} • {current?.unit}</span><b>Question {mockIndex + 1} of {paper.length}</b></div>            <h2>{current?.question}</h2>            <div className="practice-options">{(current?.options || []).map((o, i) => <button key={o} className={mockPicks[current.id] === i ? 'selected' : ''} onClick={() => { setMockPicks((p) => ({ ...p, [current.id]: i })); if (mockIndex < paper.length - 1) setMockIndex((v) => v + 1); }}><span>{String.fromCharCode(65 + i)}</span>{o}</button>)}</div>            <div className="practice-actions">              <button className="secondary-button" disabled={mockIndex === 0} onClick={() => setMockIndex((v) => Math.max(0, v - 1))}>← Previous</button>              {mockIndex < paper.length - 1                ? <button className="solid-button" onClick={() => setMockIndex((v) => Math.min(paper.length - 1, v + 1))}>Next →</button>                : <button className="solid-button" onClick={submitMock}>Submit paper</button>}              <button className="secondary-button" onClick={submitMock}>Finish early</button>            </div>            <div className="mock-progress">{paper.map((q, i) => <i key={q.id} className={`${i === mockIndex ? 'now' : ''} ${mockPicks[q.id] != null ? 'done' : ''}`} />)}</div>          </div>          <div className="tool-panel">            <div className="panel-kicker">ANSWER SHEET</div>            <div className="px-subject-table">{paper.map((q, i) => <div key={q.id}><b>{i + 1}. {q.question.slice(0, 46)}{q.question.length > 46 ? '…' : ''}</b><div className="px-bar"><i style={{ width: `${mockPicks[q.id] != null ? 100 : 0}%` }} /></div><span>{mockPicks[q.id] != null ? String.fromCharCode(65 + mockPicks[q.id]) : '—'}</span><button className="secondary-button" onClick={() => setMockIndex(i)}>Open</button></div>)}</div>          </div>        </>}        {mockResult && <div className="tool-panel">          <div className="panel-kicker">RESULT · {mockResult.subject}</div>          <div className="attendance-big"><strong>{mockResult.score}%</strong><span>{mockResult.correct} of {mockResult.total} correct · submitted {new Date(mockResult.at).toLocaleString()}</span></div>          <div className="px-subject-table">{paper.map((q, i) => { const ok = mockPicks[q.id] === q.answer; return <div key={q.id}><b>{i + 1}. {q.question.slice(0, 46)}{q.question.length > 46 ? '…' : ''}</b><div className="px-bar"><i style={{ width: `${ok ? 100 : 12}%`, background: ok ? 'linear-gradient(90deg,#12a06a,#57c98a)' : 'linear-gradient(90deg,#e0574f,#f2726f)' }} /></div><span>{String.fromCharCode(65 + q.answer)}</span><em className={`px-flag ${ok ? 'high' : 'low'}`}>{ok ? 'Correct' : 'Missed'}</em></div>; })}</div>          <div className="workspace-actions">            <button className="solid-button" onClick={() => loadMockPaper(10)}>Take another test →</button>            <button className="secondary-button" onClick={() => { go('Question Practice'); loadPracticeQuestions(practiceSubject); }}>Practise the missed topics</button>            <button className="secondary-button" onClick={async () => { const text = paper.map((q, i) => `${i + 1}. ${q.question}\nAnswer: ${String.fromCharCode(65 + q.answer)}`).join('\n\n'); const blob = new Blob([`CampusLMS Mock Test Result\n\nScore: ${mockResult.score}% (${mockResult.correct}/${mockResult.total})\n\n${text}`], { type: 'text/plain' }); const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = 'campuslms-mock-result.txt'; a.click(); URL.revokeObjectURL(url); }}>Download result</button>          </div>        </div>}      </PremiumPage>;    }    if (tool==='Exam Night Mode') {      const checked = studentToolState.checked || [];      const toggleCheck = (i) => { const next = checked.includes(i) ? checked.filter((x) => x !== i) : [...checked, i]; setStudentToolState((v) => ({ ...v, checked: next })); saveStudentTool('Exam Night Mode', { checked: next }).catch(() => {}); };      const nightResources = resources;      return <PremiumPage        tone="rose" icon="☾" eyebrow="FINAL REVISION · EXAM MODE" title="Exam Night Mode"        subtitle="Everything you need in the last night before an exam: a summary, formulas and PYQs, two tests and one focused study session."        badge="● Exam mode" breadcrumb="Student / Study Tools / Exam Night Mode"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Checklist", value: `${checked.length} / ${examChecklist.length}`, note: "stages finished" },          { label: "Pending work", value: serverData?.stats?.pendingAssignments ?? 0, note: "assignments left" },          { label: "Vault items", value: nightResources.length, note: "notes and PYQs" },        ]}        actions={<>          <button className="solid-button" onClick={() => openStudentTool('AI Summary')}>✦ Generate AI Summary</button>          <button className="secondary-button" onClick={() => openStudentTool('Mock Tests')}>Start a mock test →</button>        </>}      >        <div className="px-split">          <div className="tool-panel">            <div className="panel-kicker">TONIGHT'S CHECKLIST</div>            <div className="px-checklist">{examChecklist.map((x, i) => <button key={x} className={checked.includes(i) ? 'done' : ''} onClick={() => toggleCheck(i)}><b>{checked.includes(i) ? '✓' : i + 1}</b><span>{x}</span></button>)}</div>            <div className="workspace-actions">              <button className="secondary-button" onClick={() => openStudentTool('30-Min Rescue')}>⏱ Start a focus session</button>              <button className="secondary-button" onClick={() => { go('Resources'); }}>📖 Open the Resource Vault</button>            </div>          </div>          <div className="tool-panel">            <div className="panel-kicker">QUICK REVISION</div>            <div className="px-quick-list">              {[                ['✦', 'AI Summary', 'Turn your notes into a one-page revision sheet', () => openStudentTool('AI Summary')],                ['📝', 'PYQ Rapid Test', 'Short previous-year style practice set', () => openStudentTool('Mock Tests')],                ['📖', 'Formula Sheet', 'Notes and PPTs already in your vault', () => go('Resources')],                ['🎙', 'Viva Round', 'Rehearse the questions your examiner will ask', () => openStudentTool('AI Viva Simulator')],              ].map(([i, t, d, f]) => <button key={t} onClick={f}><span>{i}</span><div><b>{t}</b><small>{d}</small></div><em>→</em></button>)}            </div>          </div>        </div>        <div className="tool-panel">          <div className="panel-kicker">REVISION MATERIAL IN YOUR VAULT</div>          <div className="px-subject-table">{nightResources.map((r, i) => <div key={`${r.title}-${i}`}><b>{r.title}</b><div className="px-bar"><i style={{ width: `${[88, 72, 64, 55, 48, 40][i % 6]}%` }} /></div><span>{r.type}</span><button className="secondary-button" onClick={async () => { try { const res = await api(`/api/resources/${encodeURIComponent(r.id || r.title)}`); setWorkspace({ title: r.title, action: 'resource', resource: res.resource || res }); } catch (e) { showToast(e.message); } }}>Open</button></div>)}</div>        </div>      </PremiumPage>;    }    if (tool==='My Timetable') {      const timetable = smartToolsData?.timetable || [];      const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];      const dayOf = (c) => {        const raw = `${c.day || ''} ${c.detail || ''} ${c.title || ''}`;        return days.find((d) => raw.toLowerCase().includes(d.toLowerCase().slice(0, 3))) || days[0];      };      const grouped = days.reduce((acc, d) => { acc[d] = timetable.filter((c) => dayOf(c) === d); return acc; }, {});      const totalHours = timetable.length;      const syncTimetable = async () => {        try { const r = await api('/api/student-dashboard/timetable'); setSmartToolsData((v) => ({ ...v, timetable: r.timetable || [] })); await saveStudentTool('My Timetable', { lastSyncedAt: new Date().toISOString(), classes: r.timetable || [] }); showToast('Timetable synced and saved.'); }        catch (e) { showToast(e.message); }      };      return <PremiumPage        tone="blue" icon="🗓" eyebrow="SMART SCHEDULE · SEMESTER I" title="My Timetable"        subtitle="Your complete weekly class schedule, synced from the CampusLMS backend and grouped by day so you always know what is next."        badge="● Live schedule" breadcrumb="Student / Study Tools / My Timetable"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Classes", value: totalHours, note: "this week" },          { label: "Days covered", value: days.filter((d) => grouped[d].length).length, note: "of 6" },          { label: "Semester", value: "I", note: "CSE (IoT)" },        ]}        actions={<>          <button className="solid-button" onClick={syncTimetable}>↻ Sync &amp; save</button>          <button className="secondary-button" onClick={() => openStudentTool('30-Min Rescue')}>Plan study time →</button>        </>}      >        {timetable.length ? <>          <div className="timetable-grid">            {days.map((d) => (              <div className={`tool-panel timetable-day ${grouped[d].length ? '' : 'empty'}`} key={d}>                <div className="panel-kicker">{d}</div>                {grouped[d].length ? grouped[d].map((c, i) => <div className="timetable-row" key={c.id || i}><span className="timetable-time">{c.time || '—'}</span><div><b>{c.title || 'Class'}</b><small>{c.faculty || c.detail || 'CSE (IoT) • Semester I'}</small></div></div>) : <span className="muted">No class</span>}              </div>            ))}          </div>          <div className="tool-panel">            <div className="panel-kicker">FULL SCHEDULE</div>            <div className="workspace-list">{timetable.map((c, i) => <div key={c.id || i}><b>{c.time || '—'}</b><span><strong>{c.title || 'Class'}</strong> • {dayOf(c)} • {c.detail || 'CSE (IoT) • Semester I'}</span></div>)}</div>          </div>        </> : <div className="tool-panel"><div className="empty-state">No timetable is published yet. Use “Sync &amp; save” to load it from the backend.</div></div>}      </PremiumPage>;    }    if (tool==='AI Summary') {      const input = studentToolState.input || '';      const run = async () => {        const text = input.trim();        if (!text) return showToast('Enter notes or a topic first.');        setToolBusy(true);        try {          const r = await api('/api/ai/chat', { method: 'POST', body: JSON.stringify({ role, message: `Create a concise exam revision summary with key points, formulas/examples and 5 quick questions for: ${text}` }) });          await saveStudentTool('AI Summary', { input: text, summary: r.reply, at: new Date().toISOString() });          setStudentToolState((v) => ({ ...v, input: text, summary: r.reply }));          showToast('Revision summary generated and saved.');        } catch (e) { showToast(e.message); }        finally { setToolBusy(false); }      };      return <PremiumPage        tone="teal" icon="✦" eyebrow="AI STUDY TOOL" title="AI Summary"        subtitle="Paste your notes or pick a subject, and CampusAI turns them into a concise, exam-ready revision summary that is saved to the backend."        badge="● CampusAI ready" breadcrumb="Student / Study Tools / AI Summary"        backLabel="Back to Dashboard" onBack={() => go('Dashboard')}        chips={[          { label: "Saved summaries", value: studentToolState.summary ? 1 : 0, note: "stored in the backend" },          { label: "Input length", value: `${input.trim() ? input.trim().split(/\s+/).length : 0} words`, note: "notes pasted" },        ]}        actions={<button className="secondary-button" onClick={() => { speakText(studentToolState.summary || 'Generate a summary first.'); }}>🔊 Read the summary aloud</button>}      >        <div className="px-split">          <div className="tool-panel">            <div className="panel-kicker">YOUR NOTES OR TOPIC</div>            <textarea className="workspace-answer" rows="9" value={input} onChange={(e) => setStudentToolState((v) => ({ ...v, input: e.target.value }))} placeholder="Paste your notes or type a topic, e.g. Integration by parts and its applications…" />            <div className="workspace-actions">              <button className="solid-button" disabled={toolBusy} onClick={run}>{toolBusy ? 'Generating…' : 'Generate Summary & Save'}</button>              <button className="secondary-button" onClick={() => { setStudentToolState((v) => ({ ...v, input: '', summary: '' })); }}>Clear</button>            </div>          </div>          <div className="tool-panel">            <div className="panel-kicker">QUICK START FROM A SUBJECT</div>            <div className="px-quick-list">              {revisionSubjects.map((s) => <button key={s.code} onClick={() => setStudentToolState((v) => ({ ...v, input: `${s.name} — ${s.focus}` }))}><span>{s.icon}</span><div><b>{s.name}</b><small>{s.focus}</small></div><em>→</em></button>)}            </div>          </div>        </div>        {studentToolState.summary && <div className="tool-panel"><div className="panel-kicker">SAVED REVISION SUMMARY</div><div className="ai-result" style={{ marginTop: 0 }}><h3>Revision Summary</h3><p>{studentToolState.summary}</p></div></div>}      </PremiumPage>;    }    if (tool==='AI Viva Simulator') {      const subjectOptions=['Introduction to AI','Programming for Problem Solving (PPS)','Engineering Physics','Basic Electrical & Electronics Engineering (BEEE)','Engineering Mathematics-I','Universal Human Values'];      const deck = VIVA_DECK[vivaSubject] || [];      /* One subjective question per chapter. Chapters are the deck topics,         de-duplicated so a topic used twice cannot appear twice in the dropdown. */      const chapterList = deck.reduce((acc, d, i) => { if (!acc.some((c) => c.name === d.topic)) acc.push({ name: d.topic, index: i }); return acc; }, []);      const active = chapterList.find((c) => c.index === vivaIndex) || chapterList[0] || null;      const vivaChapter = active ? active.name : '';      const item = deck[vivaIndex] || null;      const q = item ? item.question : 'Select a subject and a chapter to generate your viva question.';      const log = Array.isArray(studentToolState.vivaLog) ? studentToolState.vivaLog : [];      const avgScore = log.length ? Math.round((log.reduce((n, x) => n + Number(x.score || 0), 0) / log.length) * 10) / 10 : 0;      const answerWords = vivaAnswer.trim() ? vivaAnswer.trim().split(/\s+/).filter(Boolean).length : 0;      const resetViva = () => { setVivaAnswer(''); setVivaFeedback(''); setVivaResult(null); setVivaInputMode('text'); setVivaFileName(''); };      /* Chapters and subjects only change what is displayed; the existing viva         endpoints stay exactly as they are. */      const syncVivaQuestions = (subject) => api(`/api/student-dashboard/viva/questions?subject=${encodeURIComponent(subject)}`)        .then((r) => setVivaQuestions(r.questions || [])).catch(() => {});      const pickSubject = (subject) => { setVivaSubject(subject); setVivaIndex(0); resetViva(); syncVivaQuestions(subject); };      const pickChapter = (name) => {        const c = chapterList.find((x) => x.name === name);        if (!c) return;        setVivaIndex(c.index);        resetViva();      };      const submitViva = async () => {        const text = vivaAnswer.trim();        if (!text) return showToast('Type, upload or speak an answer first.');        if (!item) return showToast('Select a subject and a chapter first.');        setToolBusy(true);        try {          const result = evaluateViva(item, text);          setVivaResult(result);          setVivaFeedback(`${result.verdict} — ${result.band}, ${result.score} out of 10. ${result.correctAnswer} ${result.tips.join(' ')}`);          const attempt = { id: `VIVA-${Date.now()}`, subject: vivaSubject, chapter: vivaChapter, topic: item.topic, question: q, answer: text, score: result.score, band: result.band, mode: vivaInputMode, at: new Date().toISOString() };          // Persist the attempt through the existing backend endpoint (unchanged),          // and keep a local session log so recent answers are always correct          // even if the network save is unavailable.          const next = [attempt, ...log].slice(0, 25);          setStudentToolState((v) => ({ ...v, vivaLog: next }));          saveStudentTool('AI Viva Simulator', { vivaLog: next }).catch(() => {});          try { await api('/api/student-dashboard/viva/evaluate', { method: 'POST', body: JSON.stringify({ studentId: 'CSE26-001', subject: vivaSubject, question: q, answer: text, mode: vivaInputMode }) }); } catch {}          showToast(`${result.verdict} — ${result.score}/10. AI Analysis is ready.`);        } finally { setToolBusy(false); }      };      /* One mic, three ways in: typing, a file upload, or speech. All three land         in the same answer area, so the evaluator sees one identical answer. */      const onVivaMic = () => startSpeechCapture((text) => {        if (!text) return;        setVivaInputMode('voice');        setVivaAnswer((prev) => (prev ? `${prev} ${text}` : text));        setVivaResult(null);      }, setVivaListening);      const onVivaUpload = (event) => {        const file = event.target.files?.[0];        event.target.value = '';        if (!file) return;        if (file.size > 1024 * 1024) return showToast('Please upload a text file under 1 MB.');        const reader = new FileReader();        reader.onload = () => {          const text = String(reader.result || '').replace(/\s+/g, ' ').trim();          // Reject anything that produced no readable prose rather than sending          // binary noise to the evaluator.          if (text.replace(/[^a-z]/gi, '').length < 40) return showToast('No readable text found in that file. Type the answer or use the voice mic.');          setVivaFileName(file.name);          setVivaInputMode('upload');          setVivaAnswer(text);          setVivaResult(null);          showToast(`${file.name} loaded into the answer area.`);        };        reader.onerror = () => showToast('Could not read that file. Type the answer or use the voice mic.');        reader.readAsText(file);      };      return <PremiumPage        tone="violet"        icon="🎙"        eyebrow="AI VIVA SIMULATOR · SUBJECTIVE MODE"        title="AI Viva Simulator"        subtitle="One AI-generated subjective question. Answer it by typing, uploading your answer, or speaking into the mic — then read the AI Analysis."        badge="● AI examiner live"        breadcrumb="Student / Study Tools / AI Viva Simulator"        backLabel="Back to Dashboard"        onBack={() => go('Dashboard')}        chips={[          { label: "Subject", value: vivaSubject.replace(/ \(.*\)/, ""), note: vivaSubject.includes('(') ? 'semester subject' : 'core subject' },          { label: "Chapter", value: vivaChapter || '—', note: "one question per chapter" },          { label: "Answered", value: log.length, note: "saved attempts" },          { label: "Average score", value: `${avgScore}/10`, note: log.length ? "this session" : "not started" },        ]}        actions={<>          <label className="px-select">Select Subject            <select value={vivaSubject} onChange={(e) => pickSubject(e.target.value)}>{subjectOptions.map((x) => <option key={x}>{x}</option>)}</select>          </label>          <label className="px-select">Select Chapter            <select value={vivaChapter} onChange={(e) => pickChapter(e.target.value)} disabled={!chapterList.length}>              {chapterList.length ? chapterList.map((c) => <option key={c.name} value={c.name}>{c.name}</option>) : <option>No chapters</option>}            </select>          </label>        </>}      >        <div className="viva-studio">          <section className="viva-stage">            <div className="viva-qcard">              <div className="viva-qcard-top">                <span className="question-badge">SUBJECTIVE QUESTION</span>                <span className="viva-qcard-chapter">{vivaChapter || 'No chapter selected'}</span>                <button className="voice-circle" onClick={() => speakText(q)} aria-label="Hear the question">🔊</button>              </div>              <h2>{q}</h2>              <p className="viva-qcard-hint">Answer in your own words — definition first, then the reason, then one example.</p>            </div>            <div className="viva-compose">              <div className="viva-compose-head">                <b>Your Answer</b>                <div className="viva-compose-tools">                  {vivaFileName && <em className="viva-uploaded">📄 {vivaFileName}</em>}                  <label className="viva-upload">                    <input type="file" accept=".txt,.md,.csv,.text,text/plain,text/markdown,application/pdf" onChange={onVivaUpload} />                    <span>⬆ Upload Answer</span>                  </label>                </div>              </div>              <textarea                className="viva-answer-area"                value={vivaAnswer}                onChange={(e) => { setVivaAnswer(e.target.value); setVivaResult(null); setVivaInputMode('text'); }}                placeholder="Type your answer here, or upload a file, or speak it with the mic below…"              />              <div className="viva-compose-foot">                <div className="viva-wordcount"><i style={{ width: `${Math.min(100, (answerWords / 60) * 100)}%` }} /><span>{answerWords} words · a strong viva answer runs 30–60 words</span></div>                <div className="viva-modes">                  <span className={vivaInputMode === 'text' ? 'on' : ''}>⌨ Typed</span>                  <span className={vivaInputMode === 'voice' ? 'on' : ''}>🎤 Spoken</span>                  <span className={vivaInputMode === 'upload' ? 'on' : ''}>⬆ Uploaded</span>                </div>              </div>            </div>            <div className="viva-orb-row">              <div className={`viva-orb ${vivaListening ? 'listening' : ''}`}>                <span className="viva-orb-ring r1"></span>                <span className="viva-orb-ring r2"></span>                <span className="viva-orb-ring r3"></span>                <span className="viva-orb-halo"></span>                <button className="viva-orb-btn" onClick={onVivaMic} aria-pressed={vivaListening} aria-label="Answer by voice">                  <span className="viva-orb-core"></span>                  <span className="viva-orb-face">                    {vivaListening                      ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2.5" fill="currentColor"/></svg>                      : <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2.5" width="6" height="11" rx="3" fill="currentColor"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21.5M8.5 21.5h7" fill="none" stroke="currentColor" strokeWidth="2.1" strokeLinecap="round"/></svg>}                  </span>                </button>              </div>              <b className="viva-orb-cta">{vivaListening ? 'Listening — speak your answer…' : 'Tap the mic to answer by voice'}</b>              <p className="viva-orb-hint">Your speech is converted to text in the answer area above, so you can edit it before you submit.</p>            </div>            <div className="workspace-actions viva-submit">              {!vivaResult                ? <><button className="solid-button" disabled={toolBusy || !item || !vivaAnswer.trim()} onClick={submitViva}>{toolBusy ? 'Analysing…' : 'Submit for AI Analysis'}</button><button className="secondary-button" onClick={resetViva}>Clear</button></>                : <><button className="secondary-button" onClick={() => speakText(vivaFeedback)}>🔊 Hear the analysis</button><button className="secondary-button" onClick={resetViva}>Answer again</button></>}            </div>            {vivaResult && (              <div className="ai-result viva-analysis">                <div className="viva-analysis-head">                  <span className="feedback-label">AI ANALYSIS</span>                  <span className={`viva-verdict ${vivaResult.correct ? 'good' : 'bad'}`}>{vivaResult.correct ? '✔ ' : '✖ '}{vivaResult.verdict}</span>                </div>                <div className="viva-score-card">                  <div className="viva-score-ring" style={{ '--p': `${vivaResult.score * 10}%` }}><strong>{vivaResult.score}</strong><span>/10</span></div>                  <div className="viva-score-meta">                    <b>Score</b>                    <span>{vivaResult.band}</span>                    <small>Concept coverage {vivaResult.stats.coverage}% · {vivaResult.stats.words} words · {vivaResult.stats.sentences} sentences</small>                  </div>                </div>                <div className="viva-analysis-block"><b>Correct Answer</b><p>{vivaResult.correctAnswer}</p></div>                <div className="viva-analysis-block"><b>Concept Mistakes</b><ul>{vivaResult.conceptMistakes.map((m, i) => <li key={i}>{m}</li>)}</ul></div>                <div className="viva-analysis-block"><b>Improvement Tips</b><ul>{vivaResult.tips.map((t, i) => <li key={i}>{t}</li>)}</ul></div>              </div>            )}          </section>          <aside className="viva-side viva-side-slim">            <div className="tool-panel">              <div className="panel-kicker">RECENT ANSWERS</div>              {log.length ? <div className="viva-log">{log.slice(0, 6).map((l) => <div key={l.id}><b>{l.chapter || l.topic}</b><span className={`viva-log-score ${l.score >= 7 ? 'good' : 'low'}`}>{l.score}/10</span><small>{l.subject} · {l.mode === 'voice' ? 'spoken' : l.mode === 'upload' ? 'uploaded' : 'typed'}</small></div>)}</div> : <div className="empty-state">Your submitted answers appear here with a score and how you answered.</div>}            </div>            <div className="tool-panel viva-tips-panel">              <div className="panel-kicker">HOW TO SCORE WELL</div>              <ul><li>Start with a one-line definition of the idea.</li><li>Explain the reason or the contrast, not only the fact.</li><li>Give one concrete example — real or classroom.</li><li>Keep the whole answer under 40 spoken seconds.</li></ul>            </div>          </aside>        </div>      </PremiumPage>;    }    if (tool==='AI Assistant') return null;    if (tool==='Exam Readiness') {      const r=studentToolState.readiness || smartToolsData?.readiness || {score:0,weakTopics:[],recommended:[]};      const twin=studentToolState.analysis || smartToolsData?.twin || {};      const subjectRows=(twin.profile || []).map(s=>({...s, flag:(s.progress||0)<60?'Weak':(s.progress||0)<75?'Watch':'Strong'}));      const quizPct=Number(twin.practiceAccuracy ?? 0), attPct=Number(twin.attendance?.percentage ?? twin.attendancePct ?? 0), asgPct=Number(twin.assignmentCompletion ?? 0);      const drivers=[{key:'Quiz & practice',value:quizPct,note:`${twin.practiceAccuracy!=null?`${quizPct}% accuracy`:'Run practice to score'}`,tone:'blue'},{key:'Attendance',value:attPct,note:`${attPct?`${attPct}% present`:'Not synced'}`,tone:'green'},{key:'Assignments',value:asgPct,note:`${asgPct?`${asgPct}% submitted`:'Not synced'}`,tone:'purple'}];      return <div className="tool-page smart-tool-page"><div className="tool-hero readiness-hero"><span className="tool-icon">◎</span><div><div className="eyebrow">PERSONAL PREPARATION METER</div><h1>Exam Readiness</h1><p>A preparation score built from subject progress, practice, assignments and attendance.</p></div><span className="live-chip">● Live score</span></div><div className="readiness-premium"><div className="readiness-ring-wrap"><div className="readiness-ring" style={{'--score':`${r.score}%`}}><strong>{r.score}%</strong><span>ready</span></div><b>{r.score>=80?'Strong position':r.score>=65?'Building momentum':'Needs focused revision'}</b></div><div className="readiness-details"><div className="readiness-stat-row"><span>Weak focus</span><b>{r.weakTopics?.[0]||'Refresh analysis'}</b></div>{(r.recommended||[]).map((x,i)=><div className="readiness-action" key={i}><span>{i+1}</span><p>{x}</p></div>)}<div className="workspace-actions"><button className="solid-button" onClick={async()=>{const smart=await api('/api/student-dashboard/smart-tools');setStudentToolState(v=>({...v,readiness:smart.readiness}));await saveStudentTool('Exam Readiness',{readiness:smart.readiness,checkedAt:new Date().toISOString()});showToast('Readiness recalculated from your latest data.');}}>Recalculate</button><button className="secondary-button" onClick={()=>openStudentTool('Learning Path')}>Open Learning Path →</button></div></div></div>        <div className="tool-panel readiness-drivers"><div className="panel-kicker">WHAT IS DRIVING YOUR SCORE</div><div className="driver-grid">{drivers.map(d=><div className={`driver-card ${d.tone}`} key={d.key}><div className="driver-head"><b>{d.key}</b><span>{d.value?`${d.value}%`:'—'}</span></div><div className="driver-bar"><i style={{width:`${Math.min(100,d.value)}%`}} /></div><small>{d.note}</small></div>)}</div></div>        <div className="tool-panel readiness-weak"><div className="panel-kicker">WEAK SUBJECT ANALYSIS</div><div className="workspace-list">{subjectRows.length?subjectRows.map(s=><div key={s.name}><b>{s.name}</b><span className={`weak-flag ${s.flag.toLowerCase()}`}>{s.flag} • {s.progress}%</span><i style={{width:`${s.progress||0}%`}} /></div>):<div className="empty-state">Subject progress is not synced yet. Recalculate to build the weak-subject map.</div>}</div></div>      </div>;    }    if (tool==='AI Mentorship') {      const aarTools=[        {k:AAR_CHAT_TAB,ctx:'general',i:'💬',d:'Talk it through, anytime',c:'blue'},        {k:'Mood Check',ctx:'moodcheck',i:'🌤️',d:'Name how you feel today',c:'amber'},        {k:'Calm Mode',ctx:'calm',i:'🌿',d:'Breathe and settle down',c:'green'},        {k:'Study Recovery',ctx:'recovery',i:'📚',d:'Rebuild your study rhythm',c:'violet'},        {k:'Hope Journal',ctx:'journal',i:'✍️',d:'Write down what is going well',c:'rose'},        {k:'Trusted Circle',ctx:'circle',i:'🤝',d:'Reach a person you trust',c:'teal'},        {k:'Life Timeline',ctx:'timeline',i:'🌱',d:'See your progress so far',c:'indigo'},        {k:'Smart Suggestions',ctx:'suggestions',i:'💡',d:'Small steps for right now',c:'orange'},      ];      const aarMoods=[        {k:'Great',e:'😄',c:'#4fbfa0',v:92},{k:'Good',e:'🙂',c:'#5b9bf0',v:80},{k:'Okay',e:'😐',c:'#f0a94a',v:68},        {k:'Low',e:'😔',c:'#dd7f9a',v:48},{k:'Rough',e:'😣',c:'#c76ae0',v:38},{k:'Anxious',e:'😰',c:'#7b6ae8',v:44},      ];      const aarSuggest=[        {t:'Emotional Support',ctx:'emotional',i:'💙',d:'Feeling low, anxious or overwhelmed',c:'#e8ecff',b:'#4f5fd7'},        {t:'Academic Help',ctx:'academic',i:'📘',d:'Plan studies and clear weak subjects',c:'#ece9ff',b:'#6b5ce0'},        {t:'Skill Development',ctx:'career',i:'🚀',d:'Projects, career and new skills',c:'#f4ecff',b:'#8a5ce0'},      ];      /* Right-rail "Questions & Answers" — the same personal student topics, one         per card, each opening the tool that best matches and pre-filling the         question so the student sends it from the VIDYA input. */      const aarQA=[        {t:'Emotional Support',ctx:'emotional',i:'💙',d:'Feeling low, anxious or overwhelmed',tool:'Calm Mode',q:'I feel overwhelmed and could use a calm space',c:'#e8ecff',b:'#4f5fd7'},        {t:'Academic Help',ctx:'academic',i:'📘',d:'Plan studies and clear weak subjects',tool:'Study Recovery',q:'Help me plan my studies for this week',c:'#ece9ff',b:'#6b5ce0'},        {t:'Sleep & Anxiety',ctx:'sleep',i:'😴',d:'Restless nights and a racing mind',tool:'Calm Mode',q:'I keep losing sleep because my mind races at night',c:'#e6f0ff',b:'#3f7fd0'},        {t:'Stress & Burnout',ctx:'burnout',i:'🔥',d:'Too much pressure, no energy left',tool:'Study Recovery',q:'I am burnt out and everything feels like too much pressure',c:'#ffeae4',b:'#d1683f'},        {t:'Loneliness',ctx:'lonely',i:'🫧',d:'Surrounded by people, still alone',tool:'Trusted Circle',q:'I feel lonely even though there are people around me',c:'#e4f6f1',b:'#2f9c86'},        {t:'Family Problems',ctx:'family',i:'🏠',d:'Home tension affecting your studies',tool:'Mood Check',q:'There is tension at home and it is affecting my studies',c:'#fdeaf3',b:'#c2558c'},        {t:'Career Confusion',ctx:'career',i:'🎯',d:'Not sure which path fits you',tool:'Life Timeline',q:'I am confused about which career path actually fits me',c:'#f4ecff',b:'#8a5ce0'},        {t:'Motivation',ctx:'motivation',i:'🌟',d:'Lost the drive and cannot focus',tool:'Hope Journal',q:'I have lost my motivation and cannot focus on anything',c:'#fff4dd',b:'#c99022'},      ];      /* Context-aware suggestions: the active context's own chips until the         student has spoken, then chips drawn from the rest of the page. */      const activeCtx = VIDYA_CONTEXTS[vidyaCtx] || VIDYA_CONTEXTS.general;      const aarLiveSuggest = mentorMessages.some((m) => m.role === 'user') ? aarQA : aarSuggest;      const AAR_MOOD_V = Object.fromEntries(aarMoods.map(m=>[m.k,m.v]));      const AAR_INFO={        private:{t:'Private by default',b:'Your check-ins, journal and chats stay on this device. Nothing is shared with your college or classmates.'},        judgement:{t:'No judgement',b:`You can say anything, repeat yourself, or change your mind. ${VIDYA.name} never scores or ranks you.`},        anytime:{t:'Anytime',b:`Open ${VIDYA.name} whenever you need — late night, between classes, or before an exam. There is no schedule.`},      };      const AAR_BREATH=['Breathe in','Hold','Breathe out','Rest'];      const AAR_RECOVERY=[        {k:'Set one 25-minute focus block',d:'Phone face down, one subject only.'},        {k:'Take a 10-minute screen break',d:'Walk, stretch, look away from the desk.'},        {k:'Review yesterday in 3 bullet points',d:'What you finished, what carried over.'},        {k:'Write tomorrow’s first task',d:'One line is enough to lower anxiety.'},      ];      const AAR_CIRCLE=[        {n:'Priya — Classmate',r:'Studies · same batch'},{n:'Dr. Rao — Subject Faculty',r:'Academic guidance'},        {n:'Hostel Warden',r:'Campus support'},{n:'Campus Counsellor',r:'Confidential · booked slots'},      ];      const AAR_SUGGESTIONS=[        {k:'Take a 5-minute Calm Mode break',d:'Short reset before your next class.'},        {k:'Log one thing that went well today',d:'Hope Journal · about 2 minutes.'},        {k:'Check in with your mood',d:'Takes one tap and updates your week.'},        {k:'Try one 25-minute focus block',d:'Smallest useful unit of study.'},      ];      const AAR_BASE_WEEK=[58,66,52,70,64,78];      // Mock history — local only, no AI or backend calls.      const AAR_MOOD_HISTORY=[{d:'Mon',m:'Okay'},{d:'Tue',m:'Good'},{d:'Wed',m:'Low'},{d:'Thu',m:'Okay'},{d:'Fri',m:'Good'},{d:'Sat',m:'Great'},{d:'Sun',m:aarMood}];      // Snapshot reacts to chat volume and the latest mood check.      const chatBoost=Math.min(5,mentorMessages.length);      const aarScore=aarMood?Math.min(97,Math.round(72*0.4+AAR_MOOD_V[aarMood]*0.6)+chatBoost):Math.min(97,72+chatBoost);      const aarWeek=[...AAR_BASE_WEEK,aarScore];      const aarSummary=!aarMood&&!mentorMessages.length&&!aarJournal.length        ? 'Sleep dipped midweek, mood recovered by Sunday.'        : aarMood          ? `Feeling ${aarMood.toLowerCase()} today${mentorMessages.length?` · ${mentorMessages.length} message${mentorMessages.length===1?'':'s'} shared`:''}${aarJournal.length?` · ${aarJournal.length} journal entr${aarJournal.length===1?'y':'ies'}`:''}.`          : `${mentorMessages.length} message${mentorMessages.length===1?'':'s'} shared with ${VIDYA.name}${aarJournal.length?`, ${aarJournal.length} journal entr${aarJournal.length===1?'y':'ies'}`:''}.`;      const aarHead=aarScore>=78?'Steady week.':aarScore>=58?'Holding steady.':'Tough week — be kind to yourself.';      // Recent chats are the real remembered threads, one per context the      // student has actually opened this session.      const aarThreads=Object.entries(vidyaSessions)        .filter(([,m])=>m&&m.length)        .map(([id,m])=>{          const c=VIDYA_CONTEXTS[id]||VIDYA_CONTEXTS.general;          const last=m[m.length-1];          return {t:c.label,ctx:id,m:'Just now',n:m.filter((x)=>x.role==='user').length,u:id!==vidyaCtx,p:String(last?.message||'').slice(0,44)};        });      if(aarJournal.length)aarThreads.push({t:'Hope Journal',ctx:'journal',m:'Today',n:aarJournal.length,u:false,p:aarJournal[0].text.slice(0,44)});      if(aarRecovery.length)aarThreads.push({t:'Study Recovery',ctx:'recovery',m:'Today',n:aarRecovery.length,u:false,p:`${aarRecovery.length} step${aarRecovery.length===1?'':'s'} done`});      if(aarMood&&!aarThreads.some((t)=>t.ctx==='moodcheck'))aarThreads.push({t:'Mood Check',ctx:'moodcheck',m:'Today',n:1,u:false,p:`Logged as ${aarMood}`});      if(aarCircle)aarThreads.push({t:'Trusted Circle',ctx:'circle',m:'Today',n:1,u:false,p:`Reached out to ${aarCircle.split(' — ')[0]}`});      const aarToolPanel=()=>{        if(aarTool==='Mood Check')return <div className="aar-panel">          <div className="aar-panel-head"><b>Your check-in history</b><span>This week</span></div>          <div className="aar-moodhist">{AAR_MOOD_HISTORY.map((h,i)=>{const mm=aarMoods.find(x=>x.k===h.m);return <div key={i} className={i===6?'now':''}><span>{h.d}</span><i style={{'--mc':mm?mm.c:'#c9d2e6'}}>{mm?mm.e:'·'}</i><b>{h.m||'—'}</b></div>})}</div>          <p className="aar-panel-note">{aarMood?`Today is logged as <b>${aarMood}</b>. You can change it with the cards above.`:'No check-in yet today. Use the mood cards in Today’s Check-in to log one — your week updates instantly.'}</p>          <button className="aar-mini-btn" onClick={()=>openVidyaContext('moodcheck')}>Talk it through with {VIDYA.name} →</button>        </div>;        if(aarTool==='Calm Mode')return <div className="aar-panel">          <div className="aar-panel-head"><b>Calm Mode</b><span>{aarCalmRounds} round{aarCalmRounds===1?'':'s'} completed</span></div>          <div className={`aar-breathe ${aarCalm?'on':''}`}><div className="aar-breath-orb"><span>{aarCalm?AAR_BREATH[aarCalmStep]:'🌿'}</span></div><p>{aarCalm?`${AAR_BREATH[aarCalmStep]} · follow the circle`:'A slow 4–4–6 breathing circle. Nothing is sent anywhere.'}</p></div>          <button className="aar-mini-btn solid" onClick={()=>{setAarCalm(v=>!v);setAarCalmStep(0);if(!aarCalm)openVidyaContext('calm');}}>{aarCalm?'Stop':'Start Calm Mode'}</button>        </div>;        if(aarTool==='Study Recovery')return <div className="aar-panel">          <div className="aar-panel-head"><b>Rebuild your study rhythm</b><span>{aarRecovery.length} of {AAR_RECOVERY.length} done</span></div>          <div className="aar-progress"><i style={{width:`${(aarRecovery.length/AAR_RECOVERY.length)*100}%`}}></i></div>          <div className="aar-checks">{AAR_RECOVERY.map(s=>{const on=aarRecovery.includes(s.k);return <button key={s.k} className={on?'on':''} onClick={()=>setAarRecovery(v=>on?v.filter(x=>x!==s.k):[...v,s.k])}><i>{on?'✓':''}</i><div><b>{s.k}</b><small>{s.d}</small></div></button>})}</div>        </div>;        if(aarTool==='Hope Journal')return <div className="aar-panel">          <div className="aar-panel-head"><b>Hope Journal</b><span>{aarJournal.length} entr{aarJournal.length===1?'y':'ies'}</span></div>          <div className="aar-journal-add"><textarea rows="2" value={aarDraft} onChange={e=>setAarDraft(e.target.value)} placeholder="One thing that went well today…"/><button className="aar-mini-btn solid" disabled={!aarDraft.trim()} onClick={()=>{setAarJournal(v=>[{text:aarDraft.trim(),at:new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})},...v]);setAarDraft('');}}>Save</button></div>          {aarJournal.length?<div className="aar-journal-list">{aarJournal.map((e,i)=><div key={i}><b>{e.text}</b><small>{e.at}</small></div>)}</div>:<p className="aar-panel-note">Nothing saved yet. Even a small win counts — name it.</p>}        </div>;        if(aarTool==='Trusted Circle')return <div className="aar-panel">          <div className="aar-panel-head"><b>Your Trusted Circle</b><span>{aarCircle?`Reached out to ${aarCircle.split(' — ')[0]}`:'Nobody contacted yet'}</span></div>          <div className="aar-circle-list">{AAR_CIRCLE.map(c=><button key={c.n} className={aarCircle===c.n?'on':''} onClick={()=>setAarCircle(v=>v===c.n?null:c.n)}><span>{c.n.split(' ')[0][0]}</span><div><b>{c.n}</b><small>{c.r}</small></div><em>{aarCircle===c.n?'Reached out':'Reach out'}</em></button>)}</div>          <p className="aar-panel-note">A demo list stored on this device. A real campus directory is not connected yet.</p>        </div>;        if(aarTool==='Life Timeline')return <div className="aar-panel">          <div className="aar-panel-head"><b>Your journey so far</b><span>{3+aarTimeline.length} milestones</span></div>          <div className="aar-timeline">            {[['Aug 2026','Started CSE (IoT)','enrolled'],['Sep 2026','First assignment submitted','done'],['This week',`Reached out to ${VIDYA.name}`,'now'],...aarTimeline.map(t=>[t.at,t.text,'new'])].map(([d,txt,kind],i)=><div key={i} className={kind==='now'?'now':''}><i></i><div><b>{txt}</b><small>{d}</small></div></div>)}          </div>          <button className="aar-mini-btn" onClick={()=>setAarTimeline(v=>[{at:'Today',text:'Checked in with my mood'},...v])}>+ Mark today</button>        </div>;        if(aarTool==='Smart Suggestions')return <div className="aar-panel">          <div className="aar-panel-head"><b>Small steps for right now</b><span>{aarDone.length} of {AAR_SUGGESTIONS.length} applied</span></div>          <div className="aar-sugg-list">{AAR_SUGGESTIONS.map(s=>{const on=aarDone.includes(s.k);return <button key={s.k} className={on?'on':''} onClick={()=>setAarDone(v=>on?v.filter(x=>x!==s.k):[...v,s.k])}><span>💡</span><div><b>{s.k}</b><small>{s.d}</small></div><em>{on?'Applied':'Apply'}</em></button>})}</div>        </div>;        return null;      };      return <div className="tool-page aar-page">        <section className="aar-hero">          <div className="aar-id">            <span className="aar-id-av"><img src="/images/vidya-avatar.jpg" alt={VIDYA.name}/><i className="aar-online"></i></span>            <div><b>{VIDYA.name}</b><small><i className="aar-dot"></i>Online now</small></div>          </div>          <div className="aar-hero-copy"><span className="aar-eyebrow">WELLBEING &amp; MENTORSHIP</span><h1>Your space to feel better</h1><div className="aar-hero-chips">{[['private','🔒','Private by default'],['judgement','💬','No judgement'],['anytime','🕓','Anytime']].map(([k,i,l])=><span className="aar-chip-wrap" key={k}><button className={`aar-chip ${aarInfo===k?'on':''}`} onClick={()=>setAarInfo(v=>v===k?null:k)} aria-expanded={aarInfo===k}>{i} {l} <em>?</em></button>{aarInfo===k&&<span className="aar-chip-pop">{AAR_INFO[k].t} — {AAR_INFO[k].b}</span>}</span>)}</div></div>          <div className="aar-hero-right">            <div className="aar-snap">              <div className="aar-ring sm" style={{'--p':`${aarScore}%`}}><strong>{aarScore}</strong></div>              <div className="aar-snap-txt"><div className="aar-mini-chart sm">{aarWeek.map((h,i)=><i key={i} style={{height:`${h}%`}} className={i===6?'now':''}></i>)}</div><p><b>{aarHead}</b> {aarSummary}</p></div>            </div>            <div className="aar-checkin">              <div className="aar-card-head"><h2>Today’s Check-in</h2><small>How are you feeling today?</small></div>              <div className="aar-moods">{aarMoods.map(m=><button key={m.k} className={aarMood===m.k?'active':''} style={{'--mc':m.c}} onClick={()=>{setAarMood(m.k);openVidyaContext('moodcheck');}}><span>{m.e}</span><b>{m.k}</b></button>)}</div>              {aarMood ? <p className="aar-mood-note">Thanks for checking in. Feeling <b>{aarMood.toLowerCase()}</b> is a real signal, not a problem. {VIDYA.name} is here to help with the next small step.</p> : <p className="aar-mood-note muted">Pick how you feel — this stays on your screen and is not shared.</p>}            </div>          </div>        </section>        <section className="aar-tools">{aarTools.map(t=><button key={t.k} className={`aar-tool ${t.c} ${aarTool===t.k?'active':''} ${vidyaCtx===t.ctx?'on-context':''}`} onClick={()=>{setAarTool(t.k);openVidyaContext(t.ctx);}}><span className="aar-tool-ic">{t.i}</span><b>{t.k}</b><small>{t.d}</small></button>)}</section>        <section className="aar-main">          <aside className="aar-card aar-recent">            <div className="aar-card-head"><h2>Conversation History</h2><small>{aarThreads.length} threads</small></div>            <div className="aar-thread-list">{aarThreads.length?aarThreads.map((t)=><button key={t.ctx} className={t.ctx===vidyaCtx?'active':''} onClick={()=>openVidyaContext(t.ctx)}><div><b>{t.t}</b><small>{t.p||t.m}</small></div><em className={t.u?'unread':''}>{t.n}</em></button>):<div className="empty-state">Every card you open starts a new thread, and it is remembered here.</div>}</div>            {aarThreads.length>0&&<button className="aar-ghost-btn" onClick={()=>{setVidyaSessions({});openVidyaContext('general');showToast('Conversation history cleared.');}}>Clear history</button>}          </aside>          <div className="aar-center">            <div className="aar-card aar-voice">              <div className="aar-voice-glow"></div>              <div className="aar-voice-top">                <span className="aar-voice-av"><img src="/images/vidya-avatar.jpg" alt={VIDYA.name}/><i className="aar-online"></i></span>                <div className="aar-voice-id"><b>{VIDYA.name}</b><small><i className="aar-dot"></i>Online now</small></div>                <button className="aar-voice-act" onClick={()=>speakText('I am here to listen. Tell me how your day has been, and we will take it one step at a time.')} aria-label={`Play a greeting from ${VIDYA.name}`}>🔊</button>              </div>              <div className="aar-voice-core">                <div className={`aar-mic-stage ${aarVoice==='live'?'live':''} ${aarSpeaking?'speaking':''}`}>                  <span className="aar-mic-ring r1"></span>                  <span className="aar-mic-ring r2"></span>                  <span className="aar-mic-ring r3"></span>                  <span className="aar-mic-halo"></span>                  <button className="aar-voice-mic" onClick={toggleAarVoice} aria-pressed={aarVoice==='live'} aria-label={aarVoice==='live'?`Stop talking to ${VIDYA.name}`:`Tap to Talk to ${VIDYA.name}`}>                    <span className="aar-mic-core"></span>                    <span className="aar-mic-face">                      {aarVoice==='live'                        ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2.5" fill="currentColor"/></svg>                        : <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2.5" width="6" height="11" rx="3" fill="currentColor"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21.5M8.5 21.5h7" fill="none" stroke="currentColor" strokeWidth="2.1" strokeLinecap="round"/></svg>}                    </span>                  </button>                  <span className="aar-mic-tip">{aarVoice==='live'?'Listening':'Tap to Talk'}</span>                </div>                <div className="aar-mic-copy">                  <b className="aar-voice-cta">{aarSpeaking?`${VIDYA.name} is speaking…`:aarVoice==='live'?(aarHeard?'Listening — keep going…':'Listening — speak now'):`Talk to ${VIDYA.name}`}</b>                  <p className="aar-voice-status">{aarSpeaking?`${VIDYA.name} is answering`:aarVoice==='live'?(aarHeard?'We heard you — she is replying':'Your microphone is open'):mentorBusy?`${VIDYA.name} is thinking…`:'Ready to help'}</p>                  {aarVoice==='live'&&aarHeard&&<p className="aar-voice-heard" aria-live="polite"><i>“</i>{aarHeard}<i>”</i></p>}                </div>              </div>              <div className="aar-ctx-bar">                <span className="aar-ctx-chip" style={{ '--ctx-b': activeCtx.tint, '--ctx-bg': activeCtx.bg }}>{activeCtx.icon} {activeCtx.label}</span>                <span className="aar-ctx-note">VIDYA is answering as {activeCtx.label} · {mentorMessages.filter((m) => m.role === 'user').length} message{mentorMessages.filter((m) => m.role === 'user').length === 1 ? '' : 's'} in this thread</span>                <div className="aar-ctx-suggest">{aarLiveSuggest.slice(0, 3).map((s) => <button key={s.t} onClick={() => { setMentorInput(s.q); openVidyaContext(s.ctx); }}>{s.i} {s.t}</button>)}</div>              </div>              <div className="aar-voice-chips">                {aarSuggest.map(s=><button key={s.t} style={{'--bg':s.c,'--bd':s.b}} className={vidyaCtx===s.ctx?'on':''} onClick={()=>openVidyaContext(s.ctx)}><span className="aar-chip-ic">{s.i}</span><span className="aar-chip-tx"><b>{s.t}</b><small>{s.d}</small></span></button>)}              </div>              {aarTool!==AAR_CHAT_TAB&&<div className="aar-voice-log tool">{aarToolPanel()}</div>}              {(aarTool===AAR_CHAT_TAB&&mentorMessages.length>0)&&<div className="aar-voice-log">                {mentorMessages.map((m,i)=><div key={m.id||i} className={`aar-bub-row ${m.role==='user'?'mine':''}`}><div className="aar-bub"><p>{m.message||m.reply}</p>{m.plan?.length?<div className="mentor-plan">{m.plan.map((x,j)=><span key={j}>{j+1}. {x}</span>)}</div>:null}{m.pressure&&<em className="pressure-badge">Priority support · campus counsellor</em>}</div></div>)}                {vidyaTyping&&<div className="aar-bub-row"><div className="aar-bub aar-typing"><i></i><i></i><i></i><span>{VIDYA.name} is typing</span></div></div>}              </div>}              <div className="aar-composer">                <input value={mentorInput} onChange={e=>setMentorInput(e.target.value)} onKeyDown={e=>e.key==='Enter'&&sendMentorMessage()} placeholder={`Or type a message to ${VIDYA.name}…`}/>                <button className="aar-send" disabled={mentorBusy||!mentorInput.trim()} onClick={()=>sendMentorMessage()} aria-label="Send message">{mentorBusy?'…':'➤'}</button>              </div>            </div>          </div>          <aside className="aar-card aar-suggest">            <div className="aar-card-head"><h2>Questions &amp; Answers</h2><small>Pick a topic to ask {VIDYA.name}</small></div>            <div className="aar-suggest-list">{aarQA.map(s=><button key={s.t} style={{'--bg':s.c,'--bd':s.b}} className={vidyaCtx===s.ctx?'on':''} onClick={()=>{setAarTool(s.tool);setMentorInput(s.q);openVidyaContext(s.ctx);}}><span>{s.i}</span><div><b>{s.t}</b><small>{s.d}</small></div><em>→</em></button>)}</div>          </aside>        </section>      </div>;    }    return renderSimpleTool(tool, 'Continue your academic workflow with saved progress.', '✦', 'This feature is connected to the CampusLMS backend.');  };  /* ---------------------------------------------------------------------------     Smart-tool pages (Academic Twin, Exam Readiness, Timetable, Mock Tests, …)     each get the same premium header. The page bodies above are unchanged, so     the existing content, actions and styling keep working; only the frame     around them is upgraded. AI Mentorship is deliberately excluded so that     page stays exactly as it is.     --------------------------------------------------------------------------- */  const STUDENT_TOOL_META = {    "Academic Twin": { tone: "violet", icon: "🧠", eyebrow: "PERSONAL LEARNING PROFILE", badge: "● Live profile", breadcrumb: "Student / Study Tools / Academic Twin", title: "Academic Twin", subtitle: "A living academic snapshot built from your subject progress, attendance, practice and assignment activity." },    "Exam Readiness": { tone: "cyan", icon: "◎", eyebrow: "PERSONAL PREPARATION METER", badge: "● Live score", breadcrumb: "Student / Study Tools / Exam Readiness", title: "Exam Readiness", subtitle: "A preparation score built from subject progress, practice accuracy, assignments and attendance." },    "My Timetable": { tone: "blue", icon: "🗓", eyebrow: "SMART SCHEDULE", badge: "● Live schedule", breadcrumb: "Student / Study Tools / My Timetable", title: "My Timetable", subtitle: "Your complete Semester I class schedule, synced from the CampusLMS backend and grouped by day." },    "30-Min Rescue": { tone: "crimson", icon: "⏱", eyebrow: "LIVE WORKSPACE", badge: "● Focus timer running", breadcrumb: "Student / Study Tools / 30-Min Rescue", title: "30-Min Rescue", subtitle: "A focused emergency plan when time is short: a real Pomodoro timer, a daily target and a four-stage workflow." },    "Smart Revision Hub": { tone: "amber", icon: "✦", eyebrow: "ONE-CLICK REVISION", badge: "● AI revision cards", breadcrumb: "Student / Study Tools / Smart Revision Hub", title: "Smart Revision Hub", subtitle: "Generate a one-page revision card for any subject from the notes and PYQs already in your vault." },    "Placement & Career Hub": { tone: "indigo", icon: "🚀", eyebrow: "PLACEMENT & CAREER", badge: "● Profile saved", breadcrumb: "Student / Campus / Placement & Career Hub", title: "Placement & Career Hub", subtitle: "Build your resume, review live internship openings, practise aptitude and follow a stage-by-stage career roadmap." },    "Exam Night Mode": { tone: "rose", icon: "☾", eyebrow: "FINAL REVISION", badge: "● Exam mode", breadcrumb: "Student / Study Tools / Exam Night Mode", title: "Exam Night Mode", subtitle: "Your final revision kit in one place: summary, formulas, PYQ test, mock test and a focus session." },    "AI Summary": { tone: "teal", icon: "✦", eyebrow: "AI STUDY TOOL", badge: "● CampusAI ready", breadcrumb: "Student / Study Tools / AI Summary", title: "AI Summary", subtitle: "Paste notes or enter a topic and CampusAI turns it into a concise, exam-ready revision summary." },    "Mock Tests": { tone: "indigo", icon: "📝", eyebrow: "EXAM PRACTICE", badge: "● Timed practice", breadcrumb: "Student / Practice / Tests & Mocks", title: "Tests & Mocks", subtitle: "Attempt an exam-style paper under real conditions, get the result instantly and save it to the backend." },    "Learning Path": { tone: "blue", icon: "🧭", eyebrow: "LEARNING PATH", badge: "● Progress saved", breadcrumb: "Student / Study Tools / Learning Path", title: "Learning Path", subtitle: "Concept → Learn → Practice → PYQ → Test, with every completed stage stored in the backend." },  };  const studentToolChips = (tool) => {    const att = serverData?.attendance || {};    const attPct = att.total ? Math.round((att.present * 100) / att.total) : null;    const twin = studentToolState.analysis || smartToolsData?.twin || {};    const readiness = studentToolState.readiness || smartToolsData?.readiness || {};    const timetable = smartToolsData?.timetable || [];    const career = studentToolState || {};    if (tool === "Academic Twin") return [      { label: "Overall progress", value: twin.avg == null ? "—" : `${twin.avg}%`, note: "academic average" },      { label: "Risk level", value: twin.risk || "On track", note: "computed from live data" },      { label: "Attendance", value: twin.attendance?.percentage ?? twin.attendancePct ?? (attPct == null ? "—" : `${attPct}%`), note: "current record" },      { label: "Weakest subject", value: twin.weakest?.name || "—", note: twin.weakest?.progress == null ? "focus area" : `${twin.weakest.progress}% complete` },    ];    if (tool === "Exam Readiness") return [      { label: "Readiness", value: `${readiness.score ?? 0}%`, note: readiness.score >= 80 ? "strong position" : readiness.score >= 65 ? "building momentum" : "needs revision" },      { label: "Weak focus", value: readiness.weakTopics?.[0] || "—", note: "next topic to fix" },      { label: "Assignments done", value: twin.assignmentCompletion == null ? "—" : `${twin.assignmentCompletion}%`, note: "submission rate" },      { label: "Practice accuracy", value: twin.practiceAccuracy == null ? "—" : `${twin.practiceAccuracy}%`, note: "question bank" },    ];    if (tool === "My Timetable") return [      { label: "Classes", value: timetable.length, note: "this week" },      { label: "Subjects covered", value: new Set(timetable.map((c) => c.title).filter(Boolean)).size, note: "distinct sessions" },      { label: "Semester", value: "I", note: "CSE (IoT)" },    ];    if (tool === "30-Min Rescue") return [      { label: "Timer", value: pomoClock, note: `${pomo.phase} block` },      { label: "Today", value: `${minutesToday} min`, note: `of ${dailyTarget} min target` },      { label: "Target", value: `${targetPct}%`, note: "daily goal reached" },      { label: "Sessions", value: (rescueState.sessions || []).length, note: "logged" },    ];    if (tool === "Smart Revision Hub") return [      { label: "Revision cards", value: (studentToolState.cards || []).length, note: "generated & saved" },      { label: "Subjects covered", value: revisionSubjects.length, note: "one-click cards" },      { label: "Notes in vault", value: resources.filter((r) => r.type === 'Notes').length, note: "source material" },    ];    if (tool === "Placement & Career Hub") return [      { label: "Aptitude score", value: `${career.aptitude?.length ? Math.round((career.aptitude.filter((x) => x.correct).length / career.aptitude.length) * 100) : 0}%`, note: `${career.aptitude?.length || 0} attempts` },      { label: "Openings", value: internshipOpportunities.length, note: "live internships" },      { label: "Resume", value: career.resume ? "Saved" : "Draft", note: "stored in the backend" },      { label: "Roadmap stages", value: careerStages.length, note: "year by year" },    ];    if (tool === "Exam Night Mode") return [      { label: "Checklist", value: "5 steps", note: "summary → formulas → PYQ → mock → focus" },      { label: "Pending work", value: serverData?.stats?.pendingAssignments ?? 0, note: "assignments left" },      { label: "Days to exam", value: "—", note: "no exam published" },    ];    if (tool === "AI Summary") return [      { label: "Saved summaries", value: studentToolState.summary ? 1 : 0, note: "stored in the backend" },      { label: "Subject", value: practiceSubject.replace(/ \(.*\)/, ""), note: "current practice subject" },    ];    if (tool === "Mock Tests") return [      { label: "Last score", value: studentToolState.score == null ? "—" : `${studentToolState.score}%`, note: "saved result" },      { label: "Attempts", value: studentToolState.attempts || 0, note: "recorded" },    ];    if (tool === "Learning Path") return [      { label: "Stage", value: `${(studentToolState.steps || []).filter(Boolean).length}/4`, note: "steps completed" },      { label: "Next stage", value: ['Review weak topic', 'Practise 5 questions', 'Complete a PYQ set', 'Take a mini test'][(studentToolState.steps || []).filter(Boolean).length], note: "in order" },    ];    if (tool === "AI Viva Simulator") {      const deck = VIVA_DECK[vivaSubject] || [];      const log = Array.isArray(studentToolState.vivaLog) ? studentToolState.vivaLog : [];      return [        { label: "Question", value: `${Math.min(vivaIndex + 1, Math.max(1, deck.length))} / ${Math.max(1, deck.length)}`, note: vivaSubject.replace(/ \(.*\)/, "") },        { label: "Answered", value: log.length, note: "saved attempts" },        { label: "Mode", value: vivaInputMode === 'voice' ? "🎤 Voice" : "⌨ Typed", note: vivaListening ? "listening…" : "mic ready" },      ];    }    return [      { label: "Subjects", value: (serverData?.subjects || subjects).length, note: "Semester I" },      { label: "Pending work", value: serverData?.stats?.pendingAssignments ?? 0, note: "assignments" },      { label: "Attendance", value: attPct == null ? "—" : `${attPct}%`, note: "live record" },    ];  };  const renderStudentTool = (tool) => {    /* AI Mentorship keeps its own dedicated layout, and the AI Viva Simulator       already renders its own premium page — both are returned untouched. */    if (tool === "AI Mentorship") return renderStudentToolBody(tool);    const body = renderStudentToolBody(tool);    if (body === null) return null;    const meta = STUDENT_TOOL_META[tool];    if (!meta) return body;    const { title, ...rest } = meta;    return (      <PremiumPage        {...rest}        title={title}        backLabel="Back to Dashboard"        onBack={() => go('Dashboard')}        chips={studentToolChips(tool)}      >{body}</PremiumPage>    );  };  const renderSimpleTool = (title, subtitle, icon, body, buttonText = "Start Now →") => <div className="tool-page"><span className="tool-icon">{icon}</span><div className="eyebrow">CAMPUSLMS SMART TOOL</div><h1>{title}</h1><p>{subtitle}</p><div className="tool-panel"><h2>{body}</h2><p>This interactive demo is connected to your student workspace. Use the action below to continue.</p><button className="solid-button" onClick={()=>runAction(`${title} started for Satya.`)}>{buttonText}</button></div></div>;  const renderFacultyDashboard = () => {    const faculty = serverData?.user?.role === 'Faculty' ? serverData.user : facultyDirectory.find(f=>f.id===facultyId) || facultyDirectory[0];    const facultySubjects = faculty?.subjects || [];    const facultyCourseLabel = facultySubjects.length ? facultySubjects.join(' • ') : 'No Semester-I student course assigned in this prototype';    const quick = [      ['📄','Create Assignment'],['📝','Question Paper Generator'],['📅','Schedule Class'],      ['📢','Send Announcement'],['👥','Attendance'],['📊','Class Analytics'],      ['🎯','Remedial Session Planner'],['🤖','Faculty AI Assistant'],      ['♨','AI Doubt Heatmap'],['🚨','AI Concept Rescue'],      ['👨‍👩‍👧','AI Parent Connect'],['🎯','AI Personalized Learning']    ];    const facultyOpen = async (title) => {      const resolved = title === 'Content Recommendations' ? 'AI Personalized Learning' : title;      if (resolved === 'At-Risk Students') { setWorkspace({title:'Real AI Risk',action:'Real AI Risk',data:facultyIntel}); return; }      if (['AI Doubt Heatmap','AI Concept Rescue','AI Parent Connect','AI Personalized Learning'].includes(resolved)) { setWorkspace({title:resolved,action:resolved,data:facultyIntel}); return; }      if (resolved === 'Class Analytics' || resolved === 'AI Reports') { try { const r=await api(`/api/faculty/analytics?facultyId=${encodeURIComponent(facultyId)}`); setWorkspace({title:resolved,action:resolved,data:{...r,courses:(r.courses||[]).map(c=>({...c,average:facultyIntel.subjectMetrics.find(m=>m.name===c.name)?.progress??c.average,derived:true})),intel:facultyIntel}}); } catch(e){showToast(e.message);} return; }      if (resolved === 'Doubt Tickets') { let r = null; try { r = await api('/api/doubt-tickets'); } catch(e) { r = null; } setWorkspace({title:resolved,action:resolved,data:r||{tickets:facultyIntel.tickets,intel:facultyIntel}}); return; }      if (resolved === 'Attendance') { try { const r=await api('/api/attendance'); setWorkspace({title:resolved,action:resolved,data:{...r,intel:facultyIntel}}); } catch(e){showToast(e.message);} return; }      if (resolved === 'Schedule Class') { try { const r=await api('/api/schedules'); setWorkspace({title:resolved,action:resolved,data:r}); } catch(e){showToast(e.message);} return; }      if (resolved === 'My Courses') setWorkspace({title:resolved,action:resolved,data:{courses:facultySubjects,intel:facultyIntel}});      else if (resolved === 'Assessments') setWorkspace({title:resolved,action:resolved,data:{assignments:(serverData?.assignments||[]).filter(a=>!facultySubjects.length||facultySubjects.includes(a.subject)),intel:facultyIntel}});      else if (resolved === 'Resources' || resolved === 'Open Resources') setWorkspace({title:'Resources',action:'Faculty Resources',data:{resources:(serverData?.resources||[]).filter(r=>!facultySubjects.length||facultySubjects.includes(r.subject)),intel:facultyIntel}});      else if (resolved === 'Announcements') setWorkspace({title:resolved,action:resolved,data:{announcements:serverData?.announcements||[]}});      else if (resolved === 'Feedback & Surveys') setWorkspace({title:resolved,action:resolved,data:{polls:serverData?.polls||[]}});      else if (resolved === 'Notification Center') await openNotifications();      else if (resolved === 'Create Practice') openRoleWorkspace('Question Paper Generator',{area:'Faculty Dashboard'});      else openRoleWorkspace(resolved, {area:'Faculty Dashboard'});    };    return <div className={`faculty-page ${dark ? 'role-dark' : ''}`}>      <div className="faculty-layout">        <RailNav          role="Faculty"          tagline="Teach. Inspire. Transform."          user={{ initials: faculty.short || faculty.name?.split(' ').map((x) => x[0]).join('').slice(0, 3), name: faculty.name, sub: faculty.department }}          items={railItems('Faculty', {            active,            moduleOpen: Boolean(workspace),            openPage: (t) => { if (t === 'Dashboard') { setWorkspace(null); setActive('Dashboard'); return; } facultyOpen(t); },            onSearch: () => window.setTimeout(() => document.querySelector('.faculty-search input')?.focus(), 0),          })}          onSettings={() => runAction('Settings panel opened.')}          onSignOut={logout}        />        <main className="faculty-main">          <header className="faculty-topbar"><div className="faculty-search">⌕ <input placeholder="Search students, assignments, questions, resources..."/><kbd>Ctrl K</kbd></div><div className="faculty-actions"><button onClick={()=>setDark(v=>!v)}>{dark?'☀':'☼'}</button><button className="faculty-bell" onClick={openNotifications}>♧<b>{notifications}</b></button><div className="faculty-profile"><span className="faculty-avatar">{faculty.short || faculty.name?.split(' ').map(x=>x[0]).join('').slice(0,3)}</span><div><strong>{faculty.name}</strong><small>{faculty.department}</small></div><button className="faculty-top-logout" onClick={logout}>Logout</button></div></div></header>          <div className="faculty-content">            {workspace ? renderWorkspace() : <>            <section className="faculty-hero"><div><span className="faculty-eyebrow">FACULTY WORKSPACE</span><h1>Good Morning, {faculty.name}! 👋</h1><p>{faculty.department} • {facultyCourseLabel}</p><div className="faculty-quote">“A teacher doesn’t just deliver content,<br/>they build futures.”<small>— CampusLMS</small></div></div><div className="faculty-sem-wrap"><div className="faculty-sem-label">SEMESTER SCOPE</div><div className="faculty-sem-switch" role="tablist" aria-label="Semester switcher">{FACULTY_V16.semesters.map((s)=><button key={s} role="tab" aria-selected={facultySemester===s} className={facultySemester===s?'active':''} onClick={()=>{setFacultySemester(s);v16Persist({});}}>{s.replace('Semester ','S')}</button>)}</div><div className="faculty-sem-note">All risk, heatmap and personalized-learning views recalculate for <b>{facultySemester}</b>. Progress, attendance and assignment figures are read live from the CampusLMS backend.</div></div><div className="faculty-hero-message"><b>Track<br/>Understand<br/>Support<br/>Make an Impact</b><div><small>Cohort Recorded Today</small><strong>{facultyIntel.attendance.present} / {facultyIntel.attendance.total}</strong><span>{facultyIntel.attendancePct==null?'Attendance not published':`${facultyIntel.attendancePct}% attendance · ${facultyIntel.cohort} enrolled`}</span></div></div></section>            <section className="faculty-stats">{[['📖','My Courses',String(facultySubjects.length),facultySubjects.slice(0,2).join(' • ') || 'College faculty / support role'],['👥','IoT Cohort',String(facultyIntel.cohort||0),'Backend enrolment record'],['📝','Pending Evaluations',facultyIntel.pendingEvaluations==null?'—':String(facultyIntel.pendingEvaluations),'Submitted assignments awaiting review'],['📊','Avg Subject Progress',facultyIntel.avgProgress==null?'—':`${facultyIntel.avgProgress}%`,'Live from subjects profile'],['❓','Doubt Queries',String(facultyIntel.tickets.length),'Backend tickets']].map(([i,t,n,s])=><div className="faculty-stat" key={t}><span>{i}</span><div><small>{t}</small><strong>{n}</strong><em>{s}</em></div></div>)}</section>            <section className="faculty-grid faculty-grid-top"><div className="faculty-panel performance analytics-panel">              <div className="faculty-panel-head">                <div><h2>Class Performance Analytics</h2><p>Semester-wise class performance, plus every class you teach with its live attendance, assignment and test outcomes.</p></div>                <button onClick={()=>facultyOpen('Class Analytics')}>View Details →</button>              </div>              <div className="anx-top">                <div className="anx-kpis">                  {[                    ['◎','Overall average',classAnalytics.overall,facultyIntel.scope.length?`across ${facultyIntel.scope.length} class${facultyIntel.scope.length===1?'':'es'}`:'no classes mapped'],                    ['▤','Avg performance',classAnalytics.avgPerformance,'subject progress profile'],                    ['✓','Avg attendance',classAnalytics.avgAttendance,facultyIntel.attendancePct==null?'not published':'cohort register'],                    ['▧','Avg assignments',classAnalytics.avgCompletion,classAnalytics.avgCompletion==null?'no submissions yet':'submissions ÷ expected'],                    ['✦','Avg test score',classAnalytics.avgTest,facultyAnalytics?.courses?.length?'faculty analytics record':'analytics not synced'],                  ].map(([i,k,v,note])=><div className="anx-kpi" key={k}><span>{i}</span><div><small>{k}</small><strong>{v==null?'—':`${v}%`}</strong><em>{note}</em></div></div>)}                </div>              </div>              <div className="anx-sem-head"><b>Semester-wise average class performance</b><span>{classAnalytics.liveSemesters} of {FACULTY_SEM_SPAN.length} semesters have a published cohort record</span></div>              <div className="anx-sem" role="img" aria-label="Average class performance by semester, semesters one to eight">                <div className="anx-sem-grid"><i style={{bottom:'100%'}} /><i style={{bottom:'75%'}} /><i style={{bottom:'50%'}} /><i style={{bottom:'25%'}} /></div>                {semesterAnalytics.map((s)=>(                  <div className={`anx-sem-col ${s.live?'':'idle'}`} key={s.sem} title={s.live?`${s.sem}: ${s.avg}% average across ${s.classes} class${s.classes===1?'':'es'}`:`${s.sem}: no cohort record published yet`}>                    <div className="anx-sem-value" style={s.live?{color:s.color}:undefined}>{s.avg==null?'—':`${s.avg}%`}</div>                    <div className="anx-sem-track"><i className="anx-sem-bar" style={s.live?{height:`${s.avg}%`,background:`linear-gradient(180deg,${s.color},${s.color}bb)`}:undefined}/></div>                    <div className="anx-sem-label">{s.short}</div>                    <div className="anx-sem-meta">{s.live?`${s.classes} class${s.classes===1?'':'es'}`:'not started'}</div>                  </div>                ))}              </div>              <div className="anx-axis"><span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span></div>              <div className="anx-classes">                <div className="anx-classes-head">                  <span>Class you teach</span><span>Performance</span><span>Attendance</span><span>Assignments</span><span>Test avg</span>                </div>                {classAnalytics.rows.length ? classAnalytics.rows.map((r)=>(                  <div className="anx-class" key={r.name}>                    <div className="anx-class-name"><b>{r.name}</b><small>{r.assignments} assignment{r.assignments===1?'':'s'} • {r.resources} resource{r.resources===1?'':'s'}</small></div>                    <div className="anx-metric">                      <b className={r.performance==null?'':r.performance>=70?'good':r.performance>=50?'mid':'low'}>{r.performance==null?'—':`${r.performance}%`}</b>                      <div className="anx-mini"><i style={{width:`${r.performance||0}%`}}/></div>                    </div>                    <div className="anx-metric">                      <b className={r.attendance==null?'':r.attendance>=75?'good':'mid'}>{r.attendance==null?'—':`${r.attendance}%`}</b>                      <small>{facultyIntel.attendancePct==null?'not published':`${facultyIntel.attendance.present}/${facultyIntel.attendance.total}`}</small>                    </div>                    <div className="anx-metric">                      <b className={r.completion==null?'':r.completion>=70?'good':r.completion>=40?'mid':'low'}>{r.completion==null?'—':`${r.completion}%`}</b>                      <small>{r.completion==null?'no submissions yet':`${r.submitted} submitted`}</small>                    </div>                    <div className="anx-metric">                      <b className={r.testAverage==null?'':r.testAverage>=70?'good':r.testAverage>=50?'mid':'low'}>{r.testAverage==null?'—':`${r.testAverage}%`}</b>                      <small>{r.testAverage==null?'no test record':'class average'}</small>                    </div>                  </div>                )) : <div className="empty-state">No classes are mapped to this faculty account yet.</div>}              </div>              <div className="perf-foot"><span>▤ {facultyIntel.resourceCount} resources mapped</span><span>▧ {facultyIntel.scope.length} subjects</span><span>◎ {facultyIntel.attendancePct==null?'—':`${facultyIntel.attendancePct}%`} attendance</span><span>✦ {classAnalytics.liveSemesters}/8 semesters published</span></div>            </div>              <div className="faculty-panel risk"><div className="faculty-panel-head"><div><h2>Real AI Risk</h2><p>Exposure computed from live subject, attendance and assignment records</p></div><button onClick={()=>facultyOpen('At-Risk Students')}>View Details →</button></div>{facultyIntel.exposure==null ? <div className="empty-state">No risk signal is available yet — publish subject progress or attendance to activate this model.</div> : <><div className="risk-body"><div className="risk-ring" style={{'--ring':`${Math.max(4,Math.min(100,facultyIntel.exposure))}`}}><strong>{facultyIntel.exposure}</strong><small>Exposure</small><span>{FACULTY_V16.riskBands.find(b=>b.key===facultyIntel.band(facultyIntel.exposure))?.label}</span></div><div className="risk-list">{facultyIntel.bands.filter(b=>b.count!=null&&b.count>0).map((b)=><p key={b.key}><i style={{background:b.color}}></i><b>{b.label}</b><strong>{b.count}</strong></p>)}{facultyIntel.bands.filter(b=>b.count!=null&&b.count>0).length===0&&<p><i style={{background:'#30a46c'}}></i><b>All clear</b><strong>0</strong></p>}</div></div><div className="risk-drivers">{facultyIntel.drivers.filter(d=>d.value!=null).map(d=><div className="risk-driver" key={d.label}><div><b>{d.label}</b><small>{d.source}</small></div><div className="risk-driver-bar"><i style={{width:`${Math.min(100,d.value)}%`}}></i></div><strong>{d.value}%</strong></div>)}</div><div className="risk-alert">⚠ {facultyIntel.atRiskCohort==null?'No':facultyIntel.atRiskCohort} of {facultyIntel.cohort} enrolled students sit above the attention threshold. <button onClick={()=>facultyOpen('Remedial Session Planner')}>Plan Support →</button></div></>}</div>              <div className="faculty-panel quick-actions"><div className="faculty-panel-head"><h2>Quick Actions</h2><p>Start a complete workflow</p></div><div className="faculty-actions-grid">{quick.map(([i,t])=><button key={t} onClick={()=>facultyOpen(t)}><span>{i}</span>{t}</button>)}</div></div></section>            <section className="faculty-grid faculty-grid-mid"><div className="faculty-panel insights"><div className="faculty-panel-head"><div><h2>Teaching Focus</h2><p>Course-focused actions for your assigned Semester I subjects.</p></div></div>{(facultySubjects.length?facultySubjects.map((subject,idx)=>['🧠',`${subject} focus area`,`${subject} is currently mapped to your CampusLMS teaching workspace. Use Question Paper Generator and Resources to build course-specific material.`,idx===0?'Create Practice':'Open Resources']):[['ℹ','College faculty profile','No Semester I student course is assigned to this login. This account is retained for important college-faculty access.','View Profile']]).map(([i,t,d,a])=><div className="insight-row" key={t}><span>{i}</span><div><b>{t}</b><p>{d}</p></div><button onClick={()=>facultyOpen(a)}>{a}</button></div>)}</div>              <div className="faculty-panel classes upcoming">                <div className="faculty-panel-head">                  <div><h2>📅 Upcoming Classes</h2><p>Live status across Today, Tomorrow and the next 7 days, from the stored Semester I timetable.</p></div>                  <button onClick={()=>facultyOpen('Schedule Class')}>View Full Timetable →</button>                </div>                {facultyUpcoming.total ? <>                  {[['Today',facultyUpcoming.today],['Tomorrow',facultyUpcoming.tomorrow],['Next 7 Days',facultyUpcoming.later]].map(([label,rows])=>{                    const open=!!ucOpen[label];                    const dayKeys=[...new Set(rows.map((c)=>c.dateKey))];                    return <div className="uc-group" key={label}>                      <button className={`uc-group-head ${rows.length?'':'muted'}`} onClick={()=>setUcOpen(v=>({...v,[label]:!v[label]}))} aria-expanded={open}>                        <i className={open?'open':''}></i><b>{label}</b>                        <span>{rows.length} class{rows.length===1?'':'es'}{label==='Next 7 Days'?` · ${dayKeys.length} day${dayKeys.length===1?'':'s'}`:''}</span>                        <em>{open?'−':'+'}</em>                      </button>                      {open && rows.length > 0 && <div className="uc-list">                        {dayKeys.map((k)=>{                          const day=rows.filter((c)=>c.dateKey===k);                          return <Fragment key={k}>                            {label==='Next 7 Days'&&<div className="uc-day-head"><b>{day[0].dayLabel}</b><span>{day[0].dateLabel}</span></div>}                            {day.map((c)=><div className={`uc-row ${c.status.toLowerCase()}`} key={c.key}>                              <span className="uc-time">{c.time}</span>                              <div className="uc-body">                                <strong>{c.subject}</strong>                                <small>Semester I · {c.faculty}</small>                              </div>                              <em className="uc-room">{c.room}</em>                              <b className={`uc-status ${c.status.toLowerCase()}`}>{c.status==='Live'?'● ':''}{c.status}</b>                            </div>)}                          </Fragment>;                        })}                      </div>}                    </div>;                  })}                </> : <div className="empty-state">No timetable is stored for this faculty account yet.</div>}              </div>              <div className="faculty-panel tickets"><div className="faculty-panel-head"><h2>🎟 Recent Doubt Tickets</h2><button onClick={()=>facultyOpen('Doubt Tickets')}>View All →</button></div>{(serverData?.tickets||[]).length?(serverData.tickets.slice(0,3).map(t=><div className="ticket-row" key={t.id}><span>?</span><div><strong>{t.title}</strong><small>{t.description||'Faculty follow-up requested'}</small></div><time>{new Date(t.createdAt).toLocaleDateString()}</time><em className={String(t.status||'Open').toLowerCase()}>{t.status}</em></div>)):<div className="empty-state">No new doubt tickets for this faculty workspace.</div>}</div></section>            <section className="faculty-grid faculty-grid-ai"><div className="faculty-panel heat heat-premium"><div className="faculty-panel-head"><div><h2>🔥 AI Doubt Heatmap</h2><p>Concept-level heat built from subject progress gaps, live doubt tickets and evaluation backlog — one card per subject.</p></div><button onClick={()=>facultyOpen('AI Doubt Heatmap')}>Open Heatmap →</button></div>              {facultyDoubtBoard.cells.length ? <>                <div className="heat-legend heat-legend-lg"><span>Calm</span><i className="heat-scale"></i><span>Critical</span><em>{facultyIntel.tickets.length?`${facultyIntel.tickets.length} live doubt ticket${facultyIntel.tickets.length===1?'':'s'} folded in`:'No doubt tickets recorded — heat reflects the progress gap only'}</em></div>                <div className="heat-cells">                  {facultyDoubtBoard.cells.map((c)=><button key={`${c.subject}-${c.concept}`} className={`heat-cell ${c.heat==null?'':`band-${c.heat>=70?'critical':c.heat>=45?'high':c.heat>=25?'warm':'calm'}`}`} title={`${c.subject} · ${c.concept} — heat ${c.heat==null?'not published':`${c.heat}%`}`} onClick={()=>facultyOpen('AI Concept Rescue')}><span>{c.concept.split(' ')[0]}</span>{c.heat!=null&&<b>{c.heat}</b>}{c.doubts>0&&<i>❓{c.doubts}</i>}</button>)}                </div>                <div className="doubt-cards">                  {facultyDoubtBoard.cards.map((c)=><button key={c.name} className={`doubt-card band-${c.band}`} onClick={()=>facultyOpen('AI Concept Rescue')}>                    <div className="doubt-card-top"><b>{c.short}</b><em className={`doubt-band ${c.band}`}>{c.heat==null?'No data':c.band==='critical'?'Critical':c.band==='high'?'High':c.band==='warm'?'Warm':'Calm'}</em></div>                    <div className="doubt-meter"><i style={{width:`${c.heat??0}%`}}></i></div>                    <div className="doubt-stats"><span><small>Heat</small><b>{c.heat==null?'—':`${c.heat}%`}</b></span><span><small>Doubts</small><b>{c.doubts}</b></span><span><small>Concepts</small><b>{c.concepts}</b></span></div>                    <p>{c.top?`Hottest: ${c.top.concept}${c.top.gap!=null?` · mastery gap ${c.top.gap}%`:''}`:'No concept data is published for this subject yet.'}</p>                  </button>)}                </div>              </> : <div className="empty-state">Assign a course to generate the concept heatmap.</div>}            </div>              <div className="faculty-panel ai-launch ai-launch-lg"><div className="faculty-panel-head"><div><h2>✨ AI Assistance Suite</h2><p>Four working assistants, each generated from the same live records as this dashboard.</p></div></div><div className="ai-launch-grid">{[['🤖','AI Concept Rescue','Generate a rescue explanation for a weak concept and publish it straight to your class.','Mastery gap'],['👨‍👩‍👧','AI Parent Connect','Compose a grounded progress update for guardians from real attendance and submission data.','Guardian brief'],['🎯','AI Personalized Learning','Build per-topic remediation plans from each course’s measured progress gap.','Remediation plan'],['♨','AI Doubt Heatmap','Trace every hot concept back to the record that produced it.','Concept drill-down']].map(([i,t,d,tag])=><button key={t} onClick={()=>facultyOpen(t)}><span className="ai-launch-ic">{i}</span><em className="ai-launch-tag">{tag}</em><b>{t}</b><small>{d}</small><i className="ai-launch-go">→</i></button>)}</div></div></section>            <section className="faculty-grid faculty-grid-bottom"><div className="faculty-panel dept"><h2>🏢 CSE Department Snapshot</h2><div className="dept-stats"><div><b>60</b><span>CSE (IoT) annual intake</span></div><div><b>4</b><span>Computer labs</span></div><div><b>175+</b><span>Computers</span></div><div><b>100 Mbps</b><span>Internet lease line</span></div></div></div><div className="faculty-panel notices notices-lg"><div className="faculty-panel-head"><h2>📢 Important Notifications</h2><button onClick={()=>facultyOpen('Announcements')}>View All →</button></div>                {facultyNotices.length ? <div className="notice-cards">{facultyNotices.slice(0,3).map((a,i)=><button key={a.id||a.title} className="notice-card" onClick={()=>facultyOpen('Announcements')}><span className={`notice-dot t${i}`}></span><div><strong>{a.title}</strong>{a.body?<small>{a.body}</small>:null}</div><em>{a.createdAt?new Date(a.createdAt).toLocaleDateString(undefined,{day:'2-digit',month:'short'}):'Recent'}</em></button>)}</div> : <div className="empty-state">No announcements are published for this department yet.</div>}              </div><div className="faculty-panel build-card"><div>🏆</div><h2>Together We Build<br/>Better Learners</h2><p>Guide · Support · Empower</p></div></section>            </>}          </div>        </main>      </div>    </div>;  };  const renderCRDashboard = () => {    const crAnnouncements = announcements.length ? announcements.slice(0,4) : [      {title:'End-Sem Exam Schedule Released',body:'Check dates and syllabus.'},      {title:'Lab Manual Updated',body:'For all first year students.'},      {title:'IoT Workshop',body:'Registration open now!'}    ];    const issues = serverData?.issues || [];    const polls = serverData?.polls || [];    const crOpen = async (title) => {      const resolved = title === 'My Class' ? 'Student Manager'        : title === 'Class Updates' ? 'Class Analytics'        : title === 'Class Schedule' ? 'Timetable & Events'        : title;      if (['AI Class Command Center','Anonymous Issue Box','Smart Announcement Generator','Class Analytics','Student Manager','Timetable & Events'].includes(resolved)) { setWorkspace({title:resolved,action:resolved,data:crIntel}); return; }      if (resolved === 'Notification Center') return openNotifications();      if (resolved === 'Open Issues') { try { const r = await api('/api/issues'); setWorkspace({title:'Open Issues',action:'Anonymous Issue Box',data:{...r,intel:crIntel}}); } catch(e){ setWorkspace({title:'Open Issues',action:'Anonymous Issue Box',data:{issues:crIntel.issues,intel:crIntel}}); } return; }      if (resolved === 'Announcements') { try { const r = await api('/api/announcements'); setWorkspace({title:'Announcements',action:'Smart Announcement Generator',data:{...r,intel:crIntel}}); } catch(e){ setWorkspace({title:'Announcements',action:'Smart Announcement Generator',data:{announcements:crIntel.recentAnnouncements,intel:crIntel}}); } return; }      if (resolved === 'Attendance') { try { const r = await api('/api/attendance'); setWorkspace({title:'Attendance',action:'Class Analytics',data:{...r,intel:crIntel}}); } catch(e){ showToast(e.message); } return; }      if (resolved === 'Assignments') { setWorkspace({title:'Assignments',action:'Student Manager',data:{intel:crIntel}}); return; }      openRoleWorkspace(resolved, {area:'CR Dashboard'});    };    return <div className={`cr-page ${dark ? 'role-dark' : ''}`}>      <div className="cr-layout">        <RailNav          role="CR"          tagline="Learn. Lead. Together."          user={{ initials: 'SP', name: 'Satya Prakash', sub: 'CR | CSE Sem 1' }}          items={railItems('CR', {            active,            moduleOpen: Boolean(workspace),            openPage: (t) => { if (t === 'Dashboard') { setWorkspace(null); setActive('Dashboard'); return; } crOpen(t); },            onSearch: () => window.setTimeout(() => document.querySelector('.cr-search input')?.focus(), 0),          })}          onSettings={() => runAction('Settings panel opened.')}          onSignOut={logout}        />        <main className="cr-main">          <header className="cr-topbar"><div className="cr-search">⌕ <input placeholder="Search students, announcements, assignments..."/></div><div className="cr-actions"><button onClick={()=>setDark(v=>!v)}>{dark?'☀':'☼'}</button><button onClick={() => setNotifications(0)} className="cr-bell">♧<b>{notifications || 0}</b></button><div className="cr-profile"><span className="cr-avatar">SP</span><div><strong>Satya Prakash</strong><small>Class Representative</small></div><button className="cr-top-logout" onClick={logout}>Logout</button></div></div></header>          <div className="cr-content">            {workspace ? renderWorkspace() : <>            <section className="cr-hero"><div className="cr-hero-copy"><h1>Good Morning, Satya! 👋</h1><p>Lead. Coordinate. Support.</p><div className="cr-quote">“A good CR isn’t just informed, but involved.”<small>— CampusLMS</small></div></div><div className="cr-hero-message"><strong>Same Class<br/>Stronger Together</strong><span>CSE<br/><b>Sem 1</b></span></div></section>            <section className="cr-stats">{[['👥','Total Students',serverData?.stats?.students || 62,''],['✓','Present Today',serverData?.stats?.present || 54,`${Math.round(((serverData?.stats?.present || 54)/(serverData?.stats?.students || 62))*100)}% Attendance`],['▤','Pending Submissions',serverData?.stats?.pendingSubmissions || 0,'Assignments & Labs'],['!','Open Issues',serverData?.stats?.openIssues || 0,'Need Attention']].map(([i,t,n,s]) => <div className="cr-stat" key={t}><span>{i}</span><div><small>{t}</small><strong>{n}</strong><em>{s}</em></div></div>)}</section>            <section className="cr-grid">              <div className="cr-panel schedule"><div className="cr-panel-head"><h2>▣ Semester I Schedule</h2><button onClick={()=>crOpen('Timetable & Events')}>View All →</button></div>{crIntel.schedules.length ? crIntel.schedules.slice(0,4).map((c,i)=><div className="cr-schedule-row" key={c.id}><b className={['green','blue','purple','orange'][i%4]}>{c.time}</b><div><strong>{c.title}</strong><small>{c.detail}</small></div></div>) : <div className="empty-state">No timetable published yet.</div>}</div>              <div className="cr-panel"><div className="cr-panel-head"><h2>⚡ Quick Actions</h2><small>Actions that update your class data</small></div><div className="cr-actions-grid"><button onClick={()=>document.querySelector('.cr-publish')?.scrollIntoView({behavior:'smooth'})}><span>📢</span>Make<br/>Announcement</button><button onClick={()=>crOpen('Share with Class')}><span>👥</span>Share with<br/>Class</button><button onClick={createPoll}><span>▤</span>Create<br/>Poll / Feedback</button><button onClick={raiseIssue}><span>!</span>Raise<br/>an Issue</button></div></div>              <div className="cr-panel announcements-panel"><div className="cr-panel-head"><h2>📢 Recent Announcements</h2><button onClick={()=>crOpen('Announcements')}>View All →</button></div>{crAnnouncements.map((a,i)=><div className="cr-announcement" key={`${a.id || a.title}-${i}`}><span>{i===0?'▤':i===1?'▣':'👥'}</span><div><strong>{a.title || a}</strong><small>{a.createdAt ? new Date(a.createdAt).toLocaleDateString() : 'Recent'}</small><p>{a.body || ''}</p></div></div>)}</div>            </section>            <section className="cr-command">              <div className="cr-panel cr-command-panel"><div className="cr-panel-head"><div><h2>🤖 AI Class Command Center</h2><small>Today’s priority queue, built from live class records.</small></div><button onClick={()=>crOpen('AI Class Command Center')}>Open →</button></div><div className="cr-queue">{crIntel.queue.slice(0,4).map(q=><button key={q.key} className={`cr-queue-item ${q.level}`} onClick={()=>crOpen(q.to)}><i></i><div><b>{q.label}</b><small>{q.detail}</small></div><span>›</span></button>)}</div><div className="cr-command-actions"><button className="cr-primary" disabled={crBusy==='brief'} onClick={()=>crAsk('brief',`Give the class representative a short morning briefing. Real data: ${crIntel.openIssues.length} open issues, ${crIntel.byStatus('Pending')} assignments pending submission, attendance ${crIntel.present} of ${crIntel.cohort} (${crIntel.attendancePct}%), average subject progress ${crIntel.avgProgress}%, weakest subject ${crIntel.weakest[0]?.name||'none'}, ${crIntel.polls.length} active polls. Give 3 prioritised actions in 4 short sentences.`)}>{crBusy==='brief'?'Briefing…':'Generate today’s briefing'}</button><button className="cr-ghost" onClick={()=>crOpen('Anonymous Issue Box')}>🕶 Issue Box ({crIntel.openIssues.length})</button><button className="cr-ghost" onClick={()=>crOpen('Timetable & Events')}>🗓 Events ({crEvents.length})</button></div>{crOut&&<pre className="cr-ai-out">{crOut}</pre>}</div>              <div className="cr-panel cr-events-panel"><div className="cr-panel-head"><div><h2>🗓 Upcoming Events</h2><small>Events you manage as CR.</small></div><button onClick={()=>crOpen('Timetable & Events')}>Manage →</button></div>{crEvents.length ? <div className="cr-event-list">{crEvents.slice(0,4).map(e=><div className="cr-event" key={e.id}><time>{e.date||'TBD'}</time><div><b>{e.title}</b><small>{e.type} • {e.venue||'Campus'}</small></div></div>)}</div> : <div className="empty-state">No events yet. Add one from Timetable &amp; Events.</div>}</div>            </section>            <section className="cr-bottom-grid">              <div className="cr-panel cr-publish"><div className="cr-panel-head"><div><h2>Make an Announcement</h2><small>Publish it to the backend and class feed.</small></div><button className="cr-ai-gen" disabled={crBusy==='gen'} onClick={async()=>{const t=await crAsk('gen',`Write a short class announcement for CSE Semester I. Real situation: ${crIntel.byStatus('Pending')} assignments pending submission, attendance ${crIntel.attendancePct}%, weakest subject ${crIntel.weakest[0]?.name||'none'}. Reply with exactly two lines: a TITLE line starting with "TITLE: " and a BODY line starting with "BODY: ". Keep the body under 60 words and end with one clear ask.`);if(!t)return;const m=t.match(/TITLE:\s*(.+)\n[\s\S]*?BODY:\s*([\s\S]+)/i);const title=m?m[1].trim().split('\n')[0]:'Class Update — Reminder';const body=m?m[2].trim():t;setAnnouncement(body);const el=document.getElementById('cr-title');if(el)el.value=title;showToast('AI draft ready — review and publish.');setCrOut('');}}>{crBusy==='gen'?'✦ Generating…':'✨ Generate with AI'}</button></div><input className="cr-input" id="cr-title" placeholder="Announcement title"/><textarea className="cr-input" rows="3" placeholder="Write your class announcement..." value={announcement} onChange={e => setAnnouncement(e.target.value)} /><button className="cr-primary" onClick={async()=>{const title=document.getElementById('cr-title')?.value?.trim() || 'Class Announcement';if(!announcement.trim())return showToast('Write an announcement first.');await publishAnnouncement(title,announcement.trim());setAnnouncement('');document.getElementById('cr-title').value='';}}>Publish to Class →</button></div>              <div className="cr-panel cr-upcoming"><div className="cr-panel-head"><h2>Class Data</h2><small>Live backend records</small></div><div className="cr-item"><span>📊</span><div><strong>{polls.length} Active Polls</strong><small>Create and collect class feedback.</small></div></div><div className="cr-item"><span>!</span><div><strong>{issues.length} Issues Raised</strong><small>{issues.filter(i=>i.status==='Open').length} currently open.</small></div></div><div className="cr-item"><span>📢</span><div><strong>{announcements.length} Announcements</strong><small>Stored in the class feed.</small></div></div></div>            </section>            <section className="cr-banner"><span>🌱</span><strong>Together We Make a Better Class.</strong><em>“Student Voice. Stronger Campus.”</em></section>            </>}          </div>        </main>      </div>    </div>;  };  let content = renderDashboard();  if (active === "Resources") content = renderResources();  else if (active === "Syllabus") { if (!syllabusData) loadSyllabus(); content = renderSyllabus(); }  else if (active === "Assignments") content = renderAssignments();  else if (active === "Question Practice") content = renderQuestionPractice();  else if (active === "Academic Records") content = renderAcademicRecords();  else if (active === "Certificates") content = renderCertificates();  else if (active === "Help & Support") content = renderSupport();  else if (active === "Community") content = renderCommunity();  else if (active === "Faculty") content = renderFaculty();  else if (active === "CR") content = renderCR();  else if (active === "AI Assistant") content = renderAI();  else if (["Academic Twin","Exam Readiness","30-Min Rescue","Exam Night Mode","AI Summary","AI Viva Simulator","Learning Path","AI Mentorship","My Timetable","Mock Tests","Subjects","Smart Revision Hub","Placement & Career Hub"].includes(active)) {    const data = {      "Academic Twin": ["Academic Twin", "Your personal learning profile and weak-topic map.", "🧠", "Programming is currently your strongest area. Integration in Engineering Mathematics needs attention."],      "Exam Readiness": ["Exam Readiness", "Know how prepared you are before exam day.", "◎", "Overall readiness: 78%. Recommended next step: revise Integration and solve 10 PYQs."],      "30-Min Rescue": ["30-Min Rescue", "A focused emergency plan when time is short.", "⏱", "10 min formulas + 10 min PYQs + 10 min self-test. Stay focused and avoid distractions."],      "Smart Revision Hub": ["Smart Revision Hub", "Notes, PYQs and AI revision cards in one place.", "✦", "Pick a subject and generate a one-page revision card instantly."],      "Placement & Career Hub": ["Placement & Career Hub", "Resume, internships, aptitude and roadmap.", "🚀", "Build your placement profile and practise aptitude rounds."],      "Exam Night Mode": ["Exam Night Mode", "Your final revision kit in one place.", "☾", "AI summary, formulas, PYQs, mock test and focus timer are ready."],      "AI Summary": ["AI Summary", "Turn long notes into quick revision material.", "✦", "Choose a resource and CampusAI will prepare a concise revision outline in this demo."],      "AI Viva Simulator": ["AI Viva Simulator", "Subjective viva practice with voice and text answers.", "🎙", "5 descriptive questions per subject • voice or typed answer • full AI Analysis."],      "Learning Path": ["Learning Path", "Follow Concept → Learn → Practice → PYQ → Test.", "🧭", "Your next recommended step is Practice: solve 10 Programming questions before moving to PYQs."],      "AI Mentorship": ["Live AI Mentorship", "Get guidance when you are stuck.", "👩🏻‍💻", "Next session: Today, 5:00 PM — DSA Problem Solving."],      "Mock Tests": ["Mock Tests", "Practice under exam-like conditions.", "📝", "Your Engineering Mathematics mini mock is ready with 20 questions."],      "Subjects": ["My Subjects", "Six active subjects for Semester 1.", "▦", "Select a subject below to open its resources."]    }[active];    content = active === "Subjects" ? renderSubjectsPage(data[1]) : renderStudentTool(active);  }  // A dashboard feature (Academic Twin, Syllabus shortcuts, notifications, …) or a  // Faculty/CR module opens as its own premium page inside the same layout.  if (workspace) content = renderWorkspace();  const saveAssignmentFromWorkspace = async () => {    const title = document.getElementById('ws-title')?.value?.trim();    const subject = document.getElementById('ws-subject')?.value?.trim() || 'Programming';    const deadline = document.getElementById('ws-deadline')?.value || '2026-10-05';    if (!title) return showToast('Assignment title is required.');    try { const r=await api('/api/assignments',{method:'POST',body:JSON.stringify({title,subject,deadline,role:'Faculty'})}); await refreshDashboard(); closeWorkspace(); showToast(`Assignment '${r.assignment.title}' saved successfully.`); } catch(e){showToast(e.message);}  };  const generateQuestionPaper = async () => {    const subject=document.getElementById('qp-subject')?.value || 'Programming';    const count=Number(document.getElementById('qp-count')?.value || 10);    const difficulty=document.getElementById('qp-level')?.value || 'Mixed';    try { const r=await api('/api/question-papers',{method:'POST',body:JSON.stringify({subject,count,difficulty,role:'Faculty'})}); setWorkspace(w=>({...w,generatedPaper:r.paper})); showToast('Question paper generated and saved.'); } catch(e){showToast(e.message);}  };  const downloadResource = (resource) => {    const text=`CampusLMS Resource\n\n${resource.title}\nSubject: ${resource.subject}\nType: ${resource.type}\n\n${resource.content || 'Resource content available in CampusLMS.'}`;    const blob=new Blob([text],{type:'text/plain;charset=utf-8'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=`${resource.title.replace(/[^a-z0-9]+/gi,'_')}.txt`; a.click(); URL.revokeObjectURL(url); showToast('Resource downloaded successfully.');  };  const updateWorkflowStep = async (step) => {    try { const done = workflowStep === step ? true : step < workflowStep; await api(`/api/workflows/${step}`,{method:'PATCH',body:JSON.stringify({done:true})}); setWorkflowStep(Math.max(workflowStep,step+1)); showToast(`Step ${step+1} completed and saved.`); } catch(e){showToast(e.message);}  };  /* ---------------------------------------------------------------------------     Module identity for the premium page header. Every Faculty/CR/Student     workspace module maps to a tone, an icon and a one-line explanation so the     header always describes the module the user actually opened. Chips below     are built from live backend numbers, never from hardcoded values.     --------------------------------------------------------------------------- */  const workspaceModuleMeta = (a, title) => {    const table = [      [/Notification Center/i, "indigo", "🔔", "DELIVERY CENTER", "Live notification outbox, webhook bridges and database health.", "● Live records", "Communication", "Back to Dashboard"],      [/Create Assignment|New assignment/i, "orange", "📄", "ASSESSMENT AUTHORING", "Create, publish and track an assignment across the whole class.", "● Publishing", "Course Management", "Back to Dashboard"],      [/^Assessments$|Evaluation Engine/i, "orange", "🧾", "ASSESSMENT EVALUATION", "Review submissions, similarity flags and save faculty grades.", "● Evaluation queue", "Course Management", "Back to Dashboard"],      [/Question Paper/i, "violet", "🧠", "QUESTION PAPER GENERATOR", "Generate a full question paper with unit-wise coverage and save it.", "● AI assisted", "Course Management", "Back to Dashboard"],      [/Assignment Evaluation|assignment-preview/i, "orange", "📝", "SUBMISSION REVIEW", "Preview the submitted file, compare answers and record a grade.", "● Under review", "Assessments", "Back to Assessments"],      [/^Resources$|Faculty Resources|^resource$/i, "teal", "📚", "RESOURCE VAULT", "Publish and open notes, PPTs, lectures and PYQs by department and module.", "● Live vault", "Course Management", "Back to Dashboard"],      [/^My Courses$/i, "blue", "▣", "MY COURSES", "Every course mapped to your faculty account this semester.", "● Scoped to you", "Course Management", "Back to Dashboard"],      [/Attendance/i, "green", "✓", "ATTENDANCE REGISTER", "Mark and publish the live attendance record for your class.", "● Live record", "Student Monitoring", "Back to Dashboard"],      [/Class Analytics|AI Reports/i, "blue", "📊", "CLASS ANALYTICS", "Course performance computed from the live backend records.", "● Computed live", "Student Monitoring", "Back to Dashboard"],      [/At-Risk Students|Real AI Risk/i, "crimson", "⚠", "REAL AI RISK", "Cohort exposure, risk bands and the drivers behind them.", "● Live exposure", "Student Monitoring", "Back to Dashboard"],      [/Doubt Tickets/i, "amber", "🎟", "DOUBT TICKETS", "Every doubt raised by students, with its current status.", "● Student raised", "Student Monitoring", "Back to Dashboard"],      [/AI Doubt Heatmap/i, "orange", "♨", "CONCEPT HEATMAP", "Concept-level heat from real mastery gaps, tickets and pending reviews.", "● AI generated", "Smart Tools", "Back to Dashboard"],      [/AI Concept Rescue/i, "rose", "🚨", "CONCEPT RESCUE", "Generate a plain-language rescue explanation and publish it to the class.", "● Draft & publish", "Smart Tools", "Back to Dashboard"],      [/AI Parent Connect/i, "indigo", "👨‍👩‍👧", "GUARDIAN UPDATE", "Turn live attendance and progress numbers into a warm guardian message.", "● Facts verified", "Communication", "Back to Dashboard"],      [/AI Personalized Learning|Content Recommendations/i, "violet", "🎯", "PERSONALISED PLANS", "A remediation plan for each course, built from the measured mastery gap.", "● Per-course plan", "Smart Tools", "Back to Dashboard"],      [/Remedial Session/i, "teal", "🩺", "REMEDIAL PLANNER", "Schedule a targeted support session for a student or group.", "● Saveable plan", "Communication", "Back to Dashboard"],      [/Smart Grading|Review PDF/i, "green", "✓", "SMART GRADING", "Record grades and written feedback as a backend record.", "● One-click save", "Smart Tools", "Back to Dashboard"],      [/Faculty AI|AI Assistant|AI-powered/i, "violet", "✦", "FACULTY AI ASSISTANT", "Ask CampusAI to draft, explain or restructure anything for your class.", "● CampusAI ready", "Smart Tools", "Back to Dashboard"],      [/Announcement/i, "cyan", "📢", "ANNOUNCEMENTS", "Publish to the class feed and keep every notice in one archive.", "● Class-wide", "Communication", "Back to Dashboard"],      [/Feedback|Survey|Poll/i, "amber", "✓", "FEEDBACK & SURVEYS", "Create a poll, collect real responses and read the class pulse.", "● Live responses", "Communication", "Back to Dashboard"],      [/Schedule Class|Class Schedule|Timetable/i, "blue", "📅", "SCHEDULE & TIMETABLE", "The live weekly schedule and the classes you have added.", "● Backend schedule", "Student Monitoring", "Back to Dashboard"],      [/AI Class Command Center/i, "violet", "🤖", "CLASS COMMAND CENTER", "One decision surface for the CR, built from the real class situation.", "● Prioritised", "Student Support", "Back to Dashboard"],      [/Anonymous Issue Box/i, "indigo", "🕶", "ANONYMOUS ISSUE BOX", "Issues stored without the raiser's identity, threaded behind a stable code.", "● Identity protected", "Student Support", "Back to Dashboard"],      [/Smart Announcement Generator/i, "cyan", "✨", "SMART ANNOUNCEMENT", "CampusAI drafts the notice from the real class data; you approve it.", "● Draft first", "Communication", "Back to Dashboard"],      [/Class Updates/i, "blue", "📊", "CLASS UPDATES", "Cohort progress, attendance and assignment status side by side.", "● Aggregated live", "Student Support", "Back to Dashboard"],      [/Student Manager|My Class|Student Support/i, "teal", "👥", "STUDENT MANAGER", "Cohort roster and per-subject status for your class.", "● Roster view", "Student Support", "Back to Dashboard"],      [/Timetable & Events/i, "blue", "🗓", "TIMETABLE & EVENTS", "Weekly timetable plus the events you manage as class representative.", "● Events saved", "Student Support", "Back to Dashboard"],      [/Open Issues/i, "crimson", "!", "OPEN ISSUES", "Track, respond to and close every issue raised by the class.", "● Live queue", "Student Support", "Back to Dashboard"],      [/Share with Class/i, "cyan", "👥", "SHARE WITH CLASS", "Send one update to every student of CSE Semester I.", "● One-tap send", "Communication", "Back to Dashboard"],      [/academic-twin/i, "violet", "🧠", "ACADEMIC TWIN", "Your live learning profile: strongest subject, weakest topic and the next step.", "● Live analysis", "Study Hub", "Back to Dashboard"],      [/academic-insights/i, "blue", "💡", "ACADEMIC INSIGHTS", "Recommendations computed from your attendance, progress and submissions.", "● Live insights", "Study Hub", "Back to Dashboard"],      [/student-subjects/i, "teal", "📚", "MY SUBJECTS", "Every subject with its live progress and status from the backend.", "● Live records", "Study Hub", "Back to Dashboard"],      [/student-assignments-summary/i, "orange", "📌", "PENDING ASSIGNMENTS", "Everything that still needs a submission, with its deadline.", "● Deadline aware", "Study Hub", "Back to Dashboard"],      [/student-progress/i, "green", "📈", "LEARNING PROGRESS", "Subject-wise progress and your overall semester standing.", "● Live progress", "Study Hub", "Back to Dashboard"],      [/student-exams/i, "crimson", "🗓", "UPCOMING EXAMS", "Scheduled examinations with dates and subjects from the backend.", "● Exam calendar", "Study Hub", "Back to Dashboard"],      [/student-timetable/i, "blue", "🗓", "UPCOMING CLASSES", "Your live class schedule for this semester.", "● Live schedule", "Study Hub", "Back to Dashboard"],      [/mentorship/i, "violet", "👩🏻‍💻", "AI MENTORSHIP SESSIONS", "Join or book a live mentorship session record.", "● Session record", "Wellbeing", "Back to Dashboard"],      [/faculty-handoff/i, "amber", "🤝", "FACULTY HANDOFF", "Raise a real support ticket so a faculty member follows it up.", "● Creates a ticket", "Support", "Back to Dashboard"],      [/^Viva/i, "violet", "🎙", "AI VIVA SIMULATOR", "Answer the viva question and get AI feedback on your response.", "● Voice or text", "Study Tools", "Back to Dashboard"],      [/Mock/i, "indigo", "📝", "MOCK TEST", "Complete the paper under exam-like conditions and save the result.", "● Timed practice", "Practice", "Back to Dashboard"],    ];    const hit = table.find(([re]) => re.test(a));    if (hit) return { tone: hit[1], icon: hit[2], eyebrow: hit[3], subtitle: hit[4], badge: hit[5], group: hit[6], back: hit[7] };    return { tone: "blue", icon: "✦", eyebrow: (role === "Faculty" ? "FACULTY" : role === "CR" ? "CLASS REPRESENTATIVE" : "STUDENT") + " MODULE", subtitle: "A complete CampusLMS workspace connected to the live backend.", badge: "● Live backend", group: role === "Faculty" ? "Faculty Workspace" : role === "CR" ? "CR Workspace" : "Student Workspace", back: "Back to Dashboard" };  };  const workspaceModuleChips = () => {    const chips = [];    const att = serverData?.attendance || {};    if (role === "Faculty") {      chips.push({ label: "Cohort", value: facultyIntel.cohort ?? "—", note: facultySemester });      chips.push({ label: "Avg progress", value: facultyIntel.avgProgress == null ? "—" : `${facultyIntel.avgProgress}%`, note: "across mapped courses" });      chips.push({ label: "Attendance", value: facultyIntel.attendancePct == null ? "—" : `${facultyIntel.attendancePct}%`, note: "live record" });      chips.push({ label: "Doubt tickets", value: facultyIntel.tickets.length, note: "open from students" });    } else if (role === "CR") {      chips.push({ label: "Cohort", value: crIntel.cohort || "—", note: "CSE (IoT) Sem I" });      chips.push({ label: "Present today", value: crIntel.present, note: crIntel.attendancePct == null ? "not synced" : `${crIntel.attendancePct}%` });      chips.push({ label: "Open issues", value: crIntel.openIssues.length, note: "awaiting response" });      chips.push({ label: "Pending work", value: crIntel.byStatus('Pending'), note: "assignments" });    } else {      chips.push({ label: "Subjects", value: (serverData?.subjects || subjects).length, note: "Semester I" });      chips.push({ label: "Pending work", value: serverData?.stats?.pendingAssignments ?? 0, note: "assignments" });      chips.push({ label: "Attendance", value: att.total ? `${Math.round((att.present * 100) / att.total)}%` : "—", note: att.total ? `${att.present}/${att.total} present` : "not synced" });      chips.push({ label: "Overall progress", value: `${serverData?.stats?.progress ?? 0}%`, note: "this semester" });    }    return chips;  };  const renderWorkspace = () => {    if (!workspace) return null;    const a = workspace.action || workspace.title || "";    const isAssignment = role === 'Faculty' && /assignment/i.test(a) && !/submit/i.test(a);    const isCRAssignment = role === 'CR' && /assignment/i.test(a);    const isSchedule = /schedule|timetable/i.test(a) || a === 'My Class Schedule';    const isAttendance = role === 'Faculty' && /attendance/i.test(a);    const isCRAttendance = role === 'CR' && /attendance/i.test(a);    const isQuestion = /question paper/i.test(a);    const isResource = a === "resource";    const isAssignmentPreview = a === 'assignment-preview';    const isAssignmentEvaluation = a === 'assignment-evaluation';    const isNotifications = a === 'Notification Center';    const isAcademicTwin = a === 'academic-twin';    const isStudentSubjects = a === 'student-subjects';    const isStudentAssignmentsSummary = a === 'student-assignments-summary';    const isStudentProgress = a === 'student-progress';    const isStudentExams = a === 'student-exams';    const isAcademicInsights = a === 'academic-insights';    const isStudentTimetable = a === 'student-timetable';    const isMentorship = a === 'mentorship';    const isFacultyHandoff = a === 'faculty-handoff';    const isFacultyAnalytics = /Class Analytics|AI Reports/i.test(a);    const isFacultyRisk = /Real AI Risk|At-Risk Students/i.test(a);    const isV16Heat = a === 'AI Doubt Heatmap';    const isV16Rescue = a === 'AI Concept Rescue';    const isV16Parent = a === 'AI Parent Connect';    const isV16Plans = /AI Personalized Learning|Content Recommendations/i.test(a);    const isCrCommand = a === 'AI Class Command Center';    const isCrIssueBox = a === 'Anonymous Issue Box';    const isCrAnnounce = a === 'Smart Announcement Generator';    const isCrAnalytics = a === 'Class Analytics';    const isCrStudents = a === 'Student Manager';    const isCrEvents = a === 'Timetable & Events';    const isFacultyTickets = /Doubt Tickets/i.test(a);    const isFacultyRemedial = /Remedial Session Planner|Plan Support|Remedial Session/i.test(a);    const isFacultyGrading = /Smart Grading|Review PDF/i.test(a);    const isFacultyCourses = a === 'My Courses';    const isFacultyAssessments = a === 'Assessments';    const isFacultyResources = a === 'Faculty Resources';    const isFacultyAnnouncements = a === 'Announcements';    const isFacultyFeedback = a === 'Feedback & Surveys';    const isFacultyAttendance = a === 'Attendance';    const isFacultySchedule = a === 'Schedule Class';    const isAI = /AI Assistant|Faculty AI|AI Reports|Content Recommendations|Smart Grading|Remedial/i.test(a);    const isViva = /Viva/i.test(a);    const isMock = /Mock/i.test(a);    const isSummary = /Summary/i.test(a);    const isStudy = /Learning Path|Study Planner|30-Min|Exam Night|Readiness|Academic Twin|Mentorship/i.test(a);    const isAnnouncement = /Announcement|Share with Class/i.test(a);    const isPoll = /Poll/i.test(a);    const isIssue = /Issue|Doubt Ticket/i.test(a);    const title = workspace.title || "CampusLMS Workspace";    const currentFacultySubjects = facultyDirectory.find(f=>f.id===facultyId)?.subjects || [];    const steps=["Review your current weak topic","Practice 5 targeted questions","Complete a PYQ set","Take a mini test"];    const renderWorkspaceBody = () => (<>      {isStudentSubjects ? <div className="workspace-body"><h3>My Subjects — Live Backend Data</h3><p>These subjects are loaded from the CampusLMS backend.</p><div className="workspace-list">{(workspace.data?.subjects||[]).map(s=><div key={s.code}><b>{s.code}</b><span><strong>{s.name}</strong> • {s.progress}% • {s.status}</span></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Subject Data</button></div>      : isStudentAssignmentsSummary ? <div className="workspace-body"><h3>Pending Assignments — Live Backend Data</h3><p>{workspace.data?.count||0} assignment(s) currently require action.</p><div className="workspace-list">{(workspace.data?.pending||[]).map(a=><div key={a.id}><b>{a.status}</b><span><strong>{a.title}</strong> • {a.subject} • Due {a.deadline}</span></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Assignment Data</button></div>      : isStudentProgress ? <div className="workspace-body"><h3>Learning Progress — Live Backend Data</h3><div className="attendance-big"><strong>{workspace.data?.progress||0}%</strong><span>Average progress across all subjects</span></div><div className="workspace-list">{(workspace.data?.subjects||[]).map(s=><div key={s.code}><b>{s.progress}%</b><span><strong>{s.name}</strong> • {s.status}</span></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Progress</button></div>      : isStudentExams ? <div className="workspace-body"><h3>Upcoming Exams — Live Backend Data</h3><p>{workspace.data?.count||0} upcoming exam(s) are scheduled.</p><div className="workspace-list">{(workspace.data?.exams||[]).map(e=><div key={e.id}><b>{e.date}</b><span><strong>{e.title}</strong> • {e.subject}</span></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Exam Data</button></div>      : isAcademicTwin ? <div className="workspace-body"><h3>Academic Twin — Live Analysis</h3><p>This analysis is calculated from the backend student profile.</p><div className="workspace-list">{(workspace.data?.profile||[]).map(x=><div key={x.name}><b>{x.name}</b><span>{x.progress}% • {x.status}</span></div>)}</div><div className="ai-result"><b>Strongest:</b> {workspace.data?.strongest?.name} ({workspace.data?.strongest?.progress}%)<br/><b>Needs attention:</b> {workspace.data?.weakest?.name} ({workspace.data?.weakest?.progress}%)<p>{workspace.data?.recommendation}</p></div><button className="solid-button" onClick={async()=>{await saveStudentTool('Academic Twin',{analysis:workspace.data,updatedAt:new Date().toISOString()});showToast('Academic Twin analysis saved to backend.');}}>Save Analysis</button></div>      : isAcademicInsights ? <div className="workspace-body"><h3>Academic Insights</h3><p>Live recommendations generated from backend academic data.</p><div className="workspace-list">{(workspace.data?.insights||[]).map(x=><div key={x.id}><b>{x.title}</b><span>{x.detail}</span><em>{x.action}</em></div>)}</div><button className="solid-button" onClick={async()=>{await saveStudentTool('Academic Insights',{insights:workspace.data?.insights||[],viewedAt:new Date().toISOString()});showToast('Insights viewed and saved.');}}>Save Insight Review</button></div>      : isStudentTimetable ? <div className="workspace-body"><h3>Upcoming Classes</h3><p>Timetable loaded from the CampusLMS backend.</p><div className="workspace-list">{(workspace.data?.timetable||[]).map(x=><div key={x.id}><b>{x.time}</b><span><strong>{x.title}</strong> • {x.detail}</span></div>)}</div><button className="solid-button" onClick={()=>showToast('Timetable is already loaded from the backend.')}>Confirm Timetable</button></div>      : isMentorship ? <div className="workspace-body"><h3>Live AI Mentorship</h3><p>Join or book a real session record. The action is saved in the backend.</p><div className="ai-result"><b>{workspace.data?.next?.title}</b><p>{workspace.data?.next?.time} • {workspace.data?.next?.mentor}</p></div>{workspace.data?.latest&&<div className="success-message">✓ Latest action: {workspace.data.latest.status}</div>}<div className="workspace-actions"><button className="solid-button" onClick={()=>mentorshipAction('join')}>Join Session</button><button className="secondary-button" onClick={()=>mentorshipAction('book')}>Book Session</button></div><h3>Saved Sessions</h3><div className="workspace-list">{(workspace.data?.sessions||[]).slice(0,5).map(x=><div key={x.id}><b>{x.status}</b><span>{x.title} • {x.time}</span></div>)}</div></div>      : isFacultyHandoff ? <div className="workspace-body"><h3>AI → Faculty Handoff</h3><p>Create a real support ticket so a faculty member can follow it up.</p><input className="workspace-answer" id="handoff-title" placeholder="What do you need help with?"/><textarea className="workspace-answer" id="handoff-description" rows="5" placeholder="Describe your doubt or problem..."></textarea><button className="solid-button" onClick={createFacultyHandoff}>Send to Faculty</button></div>      : isNotifications ? <div className="workspace-body"><h3>Notification Center</h3><p>New materials and assignment deadlines create backend notification records. Telegram/WhatsApp bridge endpoints can receive the same event payload.</p><div className="attendance-big"><strong>{workspace.data?.health?.records?.notifications||0}</strong><span>notification records • DB schema v{workspace.data?.health?.schemaVersion||'?'}</span></div><div className="workspace-form"><label>Provider<select id="webhook-provider"><option>Telegram Bridge</option><option>WhatsApp Bridge</option><option>Generic Webhook</option></select></label><label>Name<input id="webhook-name" placeholder="College notification bridge"/></label><label>Webhook URL<input id="webhook-url" placeholder="https://your-bridge.example/webhook"/></label><label>Secret (optional)<input id="webhook-secret" type="password" placeholder="Shared secret"/></label></div><div className="workspace-actions"><button className="solid-button" onClick={configureWebhook}>Save Webhook</button><button className="secondary-button" onClick={sendNotificationTest}>Send Test Notification</button><button className="secondary-button" onClick={openNotifications}>Refresh</button></div><div className="workspace-list">{(workspace.data?.webhooks||[]).map(h=><div key={h.id}><b>{h.provider}</b><span>{h.name} • {h.url}</span><em>{h.enabled===false?'Disabled':'Enabled'}</em></div>)}</div><div className="workspace-list">{(workspace.data?.notifications||[]).map(n=><div key={n.id}><b>{n.type}</b><span><strong>{n.title}</strong> • {n.body}</span><em>{n.deliveries?.length?`${n.deliveries.length} webhook delivery attempt(s)`:'Outbox only'}</em></div>)}</div><div className="ai-result"><b>Database:</b> {workspace.data?.health?.integrity||'unknown'} • {workspace.data?.health?.records?.assignments||0} assignments • {workspace.data?.health?.records?.resources||0} resources • {workspace.data?.health?.records?.submissions||0} submissions.</div></div>      : isAssignmentPreview ? <div className="workspace-body"><h3>{workspace.assignment?.title}</h3><p>{workspace.assignment?.subject} • Deadline {workspace.assignment?.deadline}</p>{workspace.file?.type==='application/pdf'?<iframe title="Assignment PDF preview" src={workspace.previewUrl} style={{width:'100%',height:'480px',border:'1px solid #ddd',borderRadius:'12px'}}/>:<div className="ai-result"><b>Selected file:</b> {workspace.file?.name} • {Math.round((workspace.file?.size||0)/1024)} KB<br/>Browser preview is available for PDF files.</div>}<textarea className="workspace-answer" id="submission-answer-text" rows="5" placeholder="Optional answer text for similarity detection across student submissions..."/><div className="workspace-actions"><button className="solid-button" onClick={()=>submitAssignment(workspace.assignment.id,workspace.file,document.getElementById('submission-answer-text')?.value||'')}>Submit Assignment</button><button className="secondary-button" onClick={closeWorkspace}>Cancel</button></div></div>      : isAssignmentEvaluation ? <div className="workspace-body"><h3>{workspace.data?.assignment?.title}</h3><p>{workspace.data?.assignment?.subject} • Due {workspace.data?.assignment?.deadline} • {workspace.data?.submissions?.length||0} submission(s)</p>{(workspace.data?.submissions||[]).map(s=><div className="submission-row" key={s.id}><div className="avatar">{String(s.studentId||'ST').slice(-2)}</div><div style={{flex:1}}><strong>{s.studentId}</strong><span>{s.fileName} • {new Date(s.submittedAt).toLocaleString()} • {s.similarityFlags?.length?'Similarity flag':'No similarity flag'}</span>{s.similarityFlags?.length?<small>Potential duplicate/similar submission detected for faculty review.</small>:null}<input className="workspace-answer" id={`grade-${s.id}`} defaultValue={s.grade||''} placeholder="Grade (e.g. 8/10 or A)"/><textarea className="workspace-answer" id={`feedback-${s.id}`} defaultValue={s.feedback||''} rows="2" placeholder="Faculty feedback"/></div><div className="workspace-actions">{s.fileType==='application/pdf'&&s.content?<button className="secondary-button" onClick={()=>setWorkspace(w=>({...w,previewSubmission:s}))}>Preview PDF</button>:null}<button className="solid-button" onClick={()=>gradeSubmission(workspace.data.assignment.id,s.id)}>Save Grade</button></div></div>)}{workspace.previewSubmission?.content&&<div className="reader-content"><h4>In-browser PDF Preview</h4><iframe title="Submission PDF" src={workspace.previewSubmission.content} style={{width:'100%',height:'420px',border:'1px solid #ddd',borderRadius:'12px'}}/></div>}<button className="secondary-button" onClick={()=>openAssignmentEvaluation(workspace.data.assignment.id)}>Refresh Evaluation</button></div>      : isResource ? <div className="workspace-body"><div className="resource-preview"><div className="resource-file large">{workspace.resource?.type === "Lecture" ? "▶" : workspace.resource?.type === "PYQ" ? "Q" : workspace.resource?.type === "PPT" ? "P" : "N"}</div><h3>{workspace.resource?.title}</h3><p>{workspace.resource?.subject} • {workspace.resource?.type} • {workspace.resource?.size || "Online"}</p>{readerOpen ? <div className="reader-content"><h3>CampusLMS Reader</h3><p>{workspace.resource?.content || 'This resource is ready for reading.'}</p><div className="reader-note">✓ Reading session opened from the backend resource record.</div></div> : null}<div className="workspace-actions"><button className="solid-button" onClick={async()=>{setReaderOpen(true);await runAction('Resource reader opened',{resourceId:workspace.resource?.id});}}> {readerOpen ? 'Reader Opened ✓' : 'Open Reader'} </button><button className="secondary-button" onClick={()=>downloadResource(workspace.resource)}>Download</button><button className="secondary-button" onClick={()=>{setWorkspace(null);setAiInput(`Summarize ${workspace.resource?.title}`);go("AI Assistant");}}>Ask CampusAI</button></div></div></div>      : isAssignment ? <div className="workspace-body"><h3>Assignment workflow</h3><p>Create, publish and then track submissions from the backend.</p><div className="workspace-form"><label>Title<input defaultValue="New CSE Assignment" id="ws-title"/></label><label>Subject<input defaultValue="Programming" id="ws-subject"/></label><label>Deadline<input type="date" defaultValue="2026-10-05" id="ws-deadline"/></label></div><button className="solid-button" onClick={saveAssignmentFromWorkspace}>Save & Publish Assignment</button></div>      : isQuestion ? <div className="workspace-body"><h3>Question Paper Generator</h3><p>Generate a real question-paper record with questions and settings saved to the backend.</p><div className="workspace-form"><label>Subject<select id="qp-subject">{['Introduction to AI','Programming for Problem Solving (PPS)','Engineering Mathematics-I','Engineering Physics','Basic Electrical & Electronics Engineering (BEEE)','Universal Human Values'].filter(s=>!currentFacultySubjects.length||currentFacultySubjects.includes(s)).map(s=><option key={s}>{s}</option>)}</select></label><label>Questions<select id="qp-count"><option>10</option><option>20</option><option>30</option></select></label><label>Difficulty<select id="qp-level"><option>Mixed</option><option>Easy</option><option>Medium</option><option>Hard</option></select></label></div><button className="solid-button" onClick={generateQuestionPaper}>Generate & Save</button>{workspace.generatedPaper&&<div className="generated-paper"><h3>Generated Paper</h3>{workspace.generatedPaper.questions.map(q=><div key={q.number}><b>{q.number}.</b> {q.question}</div>)}</div>}</div>      : isCRAssignment ? <div className="workspace-body"><h3>Class Assignments</h3><p>View assignment deadlines and submission status from the live backend.</p><div className="workspace-list">{(serverData?.assignments||[]).map(item=><div key={item.id}><b>{item.status}</b><span><strong>{item.title}</strong> • {item.subject} • Due {item.deadline}</span></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Assignment Data</button></div>      : isAttendance ? <div className="workspace-body"><h3>Live Attendance</h3><div className="attendance-big"><strong>{serverData?.attendance?.present || 54}/{serverData?.attendance?.total || 62}</strong><span>Present today</span></div><p>Update the attendance count and save it to the backend.</p><div className="workspace-form one"><label>Present students<input type="number" min="0" max={serverData?.attendance?.total || 62} id="present-count" defaultValue={serverData?.attendance?.present || 54}/></label></div><button className="solid-button" onClick={async()=>{const present=Number(document.getElementById('present-count')?.value);const r=await api('/api/attendance',{method:'POST',body:JSON.stringify({present,role:'Faculty'})});setServerData(d=>({...d,attendance:r.attendance}));showToast(`Attendance saved: ${r.attendance.present}/${r.attendance.total}.`);}}>Save Attendance</button></div>      : isCRAttendance ? <div className="workspace-body"><h3>Class Attendance</h3><div className="attendance-big"><strong>{serverData?.attendance?.present || 54}/{serverData?.attendance?.total || 62}</strong><span>Present today</span></div><p>This view is read-only for the CR and is loaded from the backend.</p><button className="solid-button" onClick={refreshDashboard}>Refresh Attendance</button></div>      : isSchedule ? <div className="workspace-body"><h3>Class & Timetable</h3><p>Live schedule records from the backend.</p><div className="workspace-list">{(serverData?.schedules||[]).map(c=><div key={c.id}><b>{c.time}</b><span><strong>{c.title}</strong> • {c.detail}</span></div>)}</div><button className="solid-button" onClick={()=>showToast('Timetable is loaded from the backend.')}>Confirm Schedule</button></div>      : isViva ? <div className="workspace-body"><h3>AI Viva Simulator</h3><p>Answer the question and get feedback from CampusAI.</p><div className="viva-question"><b>Question 1</b><h3>Explain the difference between a stack and a queue.</h3></div><textarea className="workspace-answer" id="viva-answer" rows="4" placeholder="Type your answer here..."></textarea><button className="solid-button" onClick={async()=>{const v=document.getElementById('viva-answer')?.value||'';if(!v.trim())return showToast('Write an answer first.');setWorkspace(null);setAiInput(`Evaluate my viva answer: ${v}`);go('AI Assistant');}}>Submit for AI Feedback</button></div>      : isMock ? <div className="workspace-body"><h3>Mock Test</h3><p>Complete the question, submit it, and receive a saved result.</p><div className="mock-question"><b>Q1.</b> Which data structure follows LIFO?<label><input type="radio" name="mock" value="Stack"/> Stack</label><label><input type="radio" name="mock" value="Queue"/> Queue</label><label><input type="radio" name="mock" value="Tree"/> Tree</label></div><button className="solid-button" onClick={async()=>{const chosen=document.querySelector('input[name="mock"]:checked')?.value||'Not answered';const r=await api('/api/student-dashboard/mock-tests',{method:'POST',body:JSON.stringify({answer:chosen,studentId:'CSE26-001'})});showToast(r.message);}}>Submit Test</button></div>      : isSummary ? <div className="workspace-body"><h3>AI Summary</h3><p>Paste notes or a topic. CampusAI will create a concise revision response.</p><textarea className="workspace-answer" id="summary-text" rows="6" placeholder="Paste notes or type a topic..."></textarea><button className="solid-button" onClick={()=>{const v=document.getElementById('summary-text')?.value||'';if(!v.trim())return showToast('Add notes or a topic first.');setWorkspace(null);setAiInput(`Summarize this for revision: ${v}`);go('AI Assistant');}}>Generate Summary</button></div>      : isStudy ? <div className="workspace-body"><h3>Smart Academic Workflow</h3><p>Complete each stage. Every completed step is saved to the CampusLMS backend.</p><div className="workflow-progress"><div><strong>{Math.min(workflowStep,4)}/4</strong><span>steps completed</span></div><div className="workflow-bar"><i style={{width:`${Math.min(workflowStep,4)*25}%`}}/></div></div><div className="workspace-list">{steps.map((step,i)=><button className={`workflow-step ${i<workflowStep?'done':''} ${i===workflowStep?'current':''}`} key={step} onClick={()=>i===workflowStep&&updateWorkflowStep(i)}><b>{i<workflowStep?'✓':i+1}</b><span>{step}</span>{i===workflowStep&&<em>Complete</em>}</button>)}</div>{workflowStep>=4?<div className="success-message">✓ Workflow completed and saved. Your next study session is ready.</div>:<button className="solid-button" onClick={()=>updateWorkflowStep(workflowStep)}>Complete Step {workflowStep+1} →</button>}</div>      : isAnnouncement ? <div className="workspace-body"><h3>Announcement workflow</h3><p>Write, publish and verify the class announcement.</p><input className="workspace-answer" id="ws-ann-title" placeholder="Announcement title"/><textarea className="workspace-answer" id="ws-ann-body" rows="5" placeholder="Announcement message"></textarea><button className="solid-button" onClick={async()=>{const t=document.getElementById('ws-ann-title')?.value?.trim()||'Class Announcement';const b=document.getElementById('ws-ann-body')?.value?.trim();if(!b)return showToast('Write the announcement first.');await publishAnnouncement(t,b);closeWorkspace();}}>Publish to Backend</button></div>      : isPoll ? <div className="workspace-body"><h3>Create Poll & Feedback</h3><p>Collect a real response from your class and store it in the backend.</p><input className="workspace-answer" id="poll-question" placeholder="Poll question"/><button className="solid-button" onClick={async()=>{const q=document.getElementById('poll-question')?.value?.trim();if(!q)return showToast('Enter a poll question.');await api('/api/polls',{method:'POST',body:JSON.stringify({question:q,options:['Mathematics','Physics','Programming'],createdBy:'CR-CSE-01'})});await refreshDashboard();closeWorkspace();showToast('Poll created and saved.');}}>Create Poll</button></div>      : isIssue ? <div className="workspace-body"><h3>Issue / Doubt Ticket</h3><p>Create a trackable issue instead of a demo-only confirmation.</p><input className="workspace-answer" id="issue-title" placeholder="Issue title"/><textarea className="workspace-answer" id="issue-desc" rows="4" placeholder="Describe the issue"></textarea><button className="solid-button" onClick={async()=>{const t=document.getElementById('issue-title')?.value?.trim();const d=document.getElementById('issue-desc')?.value?.trim()||'';if(!t)return showToast('Enter an issue title.');const r=await api('/api/issues',{method:'POST',body:JSON.stringify({title:t,description:d,raisedBy:'CR-CSE-01'})});await refreshDashboard();closeWorkspace();showToast(`Issue #${r.issue.id} created and is now trackable.`);}}>Create Issue</button></div>      : isFacultyCourses ? <div className="workspace-body"><h3>My Courses</h3><p>Courses are scoped to the logged-in faculty member.</p><div className="workspace-list">{(workspace.data?.courses||[]).map(c=><div key={c}><b>{c}</b><span>Semester I • CSE (IoT)</span></div>)}</div></div>      : isFacultyAssessments ? <div className="workspace-body"><h3>Assessments & Evaluation Engine</h3><p>Deadline status, submissions, similarity flags and grading are all stored in the backend.</p><div className="workspace-list">{(workspace.data?.assignments||[]).map(x=><div key={x.id}><b>{x.title}</b><span>{x.subject} • Due {x.deadline} • {x.status} • {x.submissions?.length||0} submissions</span><button className="secondary-button" onClick={()=>openAssignmentEvaluation(x.id)}>Evaluate / Preview</button></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Assessments</button></div>      : isFacultyResources ? <div className="workspace-body"><h3>Faculty Resource Vault</h3><p>Resources are published into Department &gt; Semester &gt; Subject &gt; Module and immediately appear for students.</p><div className="workspace-form"><label>Title<input id="resource-title" placeholder="e.g. AI Unit 2 Lecture Notes"/></label><label>Subject<select id="resource-subject">{currentFacultySubjects.map(s=><option key={s}>{s}</option>)}</select></label><label>Module<input id="resource-module" placeholder="Module 1: AI Foundations"/></label><label>Type<select id="resource-type"><option>Notes</option><option>PPT</option><option>PYQ</option><option>Lecture</option></select></label><label>Content<textarea id="resource-content" rows="4" placeholder="Paste notes/lecture summary or resource description"/></label></div><button className="solid-button" onClick={async()=>{const title=document.getElementById('resource-title')?.value?.trim();const subject=document.getElementById('resource-subject')?.value;const module=document.getElementById('resource-module')?.value?.trim()||'Module 1';const type=document.getElementById('resource-type')?.value;const content=document.getElementById('resource-content')?.value?.trim()||'Published faculty resource.';if(!title||!subject)return showToast('Title and subject are required.');try{const r=await api('/api/resources',{method:'POST',body:JSON.stringify({title,subject,module,type,content,department:'Computer Science & Engineering (IoT)',semester:'Semester I',role:'Faculty'})});setWorkspace(w=>({...w,data:{...w.data,resources:[r.resource,...(w.data?.resources||[])]}}));showToast('Resource published and student notification created.');}catch(e){showToast(e.message)}}}>Publish Resource</button><div className="workspace-list">{(workspace.data?.resources||[]).map(r=><div key={r.id}><b>{r.title}</b><span>{r.subject} • {r.module} • {r.type}</span></div>)}</div></div>      : isFacultyAnnouncements ? <div className="workspace-body"><h3>Announcements</h3><p>Live announcements stored in the backend.</p><div className="workspace-list">{(workspace.data?.announcements||[]).map(x=><div key={x.id}><b>{x.title}</b><span>{x.body}</span></div>)}</div><button className="solid-button" onClick={()=>openRoleWorkspace('Announcement',{area:'Faculty Dashboard'})}>Create Announcement</button></div>      : isFacultyFeedback ? <div className="workspace-body"><h3>Feedback & Surveys</h3><p>Poll records stored in the backend.</p><div className="workspace-list">{(workspace.data?.polls||[]).map(x=><div key={x.id}><b>{x.question}</b><span>{x.options?.join(' • ')}</span></div>)}</div><button className="solid-button" onClick={()=>openRoleWorkspace('Poll',{area:'Faculty Dashboard'})}>Create Survey</button></div>      : isFacultyAttendance ? <div className="workspace-body"><h3>Attendance</h3><p>Current attendance record from the backend.</p><div className="attendance-big"><strong>{workspace.data?.attendance ? Math.round(workspace.data.attendance.present*100/workspace.data.attendance.total) : 0}%</strong><span>{workspace.data?.attendance?.present||0} present / {workspace.data?.attendance?.total||0} total</span></div><input className="workspace-answer" id="faculty-present" type="number" min="0" placeholder="Update present count"/><button className="solid-button" onClick={async()=>{const v=Number(document.getElementById('faculty-present')?.value);if(!Number.isFinite(v))return showToast('Enter a valid present count.');const r=await api('/api/attendance',{method:'POST',body:JSON.stringify({present:v,role:'Faculty'})});setWorkspace(w=>({...w,data:{attendance:r.attendance}}));showToast('Attendance updated and saved.');}}>Save Attendance</button></div>      : isFacultySchedule ? <div className="workspace-body"><h3>Schedule Class</h3><p>View the live Semester I schedule or add a class record.</p><div className="workspace-list">{(workspace.data?.schedules||[]).map(c=><div key={c.id}><b>{c.time}</b><span>{c.title} • {c.detail}</span></div>)}</div><div className="workspace-form"><label>Title<input id="schedule-title" placeholder="Class title"/></label><label>Time<input id="schedule-time" placeholder="06:00 PM"/></label><label>Room<input id="schedule-room" placeholder="CSE Lab 1"/></label></div><button className="solid-button" onClick={async()=>{const title=document.getElementById('schedule-title')?.value?.trim();const time=document.getElementById('schedule-time')?.value?.trim();if(!title||!time)return showToast('Title and time are required.');const r=await api('/api/schedules',{method:'POST',body:JSON.stringify({title,time,room:document.getElementById('schedule-room')?.value,faculty:facultyId,subject:currentFacultySubjects[0]||''})});setWorkspace(w=>({...w,data:{schedules:[...(w.data?.schedules||[]),r.schedule]}}));showToast('Class added to the backend schedule.');}}>Add Class</button></div>      : isFacultyAnalytics ? <div className="workspace-body"><h3>Faculty Analytics</h3><p>Course performance is loaded from the backend.</p><div className="workspace-list">{(workspace.data?.courses||[]).map(x=><div key={x.name}><b>{x.name}</b><span>{x.average}% class average</span></div>)}</div><button className="solid-button" onClick={async()=>{const r=await api(`/api/faculty/analytics?facultyId=${encodeURIComponent(facultyId)}`);setWorkspace(w=>({...w,data:r}));showToast('Analytics refreshed from backend.');}}>Refresh Analytics</button></div>      : isFacultyRisk ? <div className="workspace-body v16-body">        <h3>Real AI Risk</h3>        <p>Every figure below is derived from records already stored in the CampusLMS backend. Nothing here is hardcoded.</p>        <div className="v16-sem-row"><span>Scope</span>{FACULTY_V16.semesters.map(s=><button key={s} className={facultySemester===s?'active':''} onClick={()=>{setFacultySemester(s);v16Persist({});}}>{s}</button>)}</div>        {facultyIntel.exposure==null ? <div className="empty-state">No risk signal yet. This model needs subject progress, attendance or assignment records.</div> : <>          <div className="v16-risk-top">            <div className="v16-exposure"><strong>{facultyIntel.exposure}</strong><span>Cohort exposure</span><em>{FACULTY_V16.riskBands.find(b=>b.key===facultyIntel.band(facultyIntel.exposure))?.label}</em></div>            <div className="v16-bands">{facultyIntel.bands.map(b=><div key={b.key} className={b.count?'on':''}><i style={{background:b.color}}></i><b>{b.label}</b><strong>{b.count==null?'—':b.count}</strong><small>of {facultyIntel.cohort} enrolled</small></div>)}</div>          </div>          <h4>Risk drivers</h4>          <div className="v16-drivers">{facultyIntel.drivers.map(d=><div key={d.label} className={d.value==null?'muted':''}><div><b>{d.label}</b><small>{d.note} — {d.source}</small></div><div className="v16-bar"><i style={{width:`${Math.min(100,d.value||0)}%`}}></i></div><strong>{d.value==null?'no data':`${d.value}%`}</strong></div>)}</div>          <h4>Per-subject breakdown</h4>          <div className="v16-table"><div className="v16-tr v16-th"><span>Subject</span><span>Progress</span><span>Gap</span><span>Assignments</span><span>Resources</span><span>Band</span></div>{facultyIntel.subjectMetrics.map(s=>{const g=s.gap==null?null:Math.max(0,Math.round(100-s.progress));const b=g==null?null:g>=40?'high':g>=25?'at':'support';return <div className="v16-tr" key={s.name}><span>{s.name}</span><span>{s.known?`${s.progress}%`:'—'}</span><span>{g==null?'—':`${g}%`}</span><span>{s.assignments}</span><span>{s.resources}</span><span><em className={`band band-${b||'none'}`}>{b?FACULTY_V16.riskBands.find(x=>x.key===b).label:'No data'}</em></span></div>})}</div>          <p className="v16-note">Student-level risk requires per-student records. The backend currently exposes cohort-level aggregates only, so this view reports cohort exposure and course-level risk instead of inventing named students.</p>          <button className="solid-button" onClick={async()=>{await v16Ask('risk',`Draft a support plan for a ${FACULTY_V16.riskBands.find(b=>b.key===facultyIntel.band(facultyIntel.exposure))?.label} cohort. Average subject progress ${facultyIntel.avgProgress}%, attendance ${facultyIntel.attendancePct}%, weakest course ${facultyIntel.subjectMetrics.filter(s=>s.known).sort((a,b)=>a.progress-b.progress)[0]?.name||'n/a'}.`);setWorkspace(w=>({...w,action:'AI Concept Rescue',title:'AI Concept Rescue'}));}}>Generate a support plan with AI →</button>          {v16Out&&<pre className="v16-ai-out">{v16Out}</pre>}        </>}      </div>      : isV16Heat ? <div className="workspace-body v16-body">        <h3>AI Doubt Heatmap</h3>        <p>Concept heat = subject mastery gap, lifted by matching doubt tickets and pending evaluations. Cells with no published data are shown greyed rather than filled in.</p>        <div className="v16-sem-row"><span>Scope</span>{FACULTY_V16.semesters.map(s=><button key={s} className={facultySemester===s?'active':''} onClick={()=>{setFacultySemester(s);v16Persist({});}}>{s}</button>)}</div>        {!facultyIntel.concepts.length ? <div className="empty-state">No courses are mapped to this faculty account, so there is nothing to heat-map yet.</div> : <div className="v16-heat-groups">{facultyIntel.scope.map(sub=><div className="v16-heat-group" key={sub}><h4>{sub}<small>{facultyIntel.subjectMetrics.find(m=>m.name===sub)?.known?`${facultyIntel.subjectMetrics.find(m=>m.name===sub).progress}% progress`:'no progress record'}</small></h4><div className="v16-heat-grid">{facultyIntel.concepts.filter(c=>c.subject===sub).map(c=><button key={c.concept} className="v16-heat-cell" style={{'--h':c.heat==null?'#2b3240':`hsl(${Math.max(6,120-(c.heat/100)*120)} 70% ${34+(c.heat/100)*26}%)`,opacity:c.heat==null?.4:1}} onClick={()=>{const el=document.getElementById('v16-concept');if(el)el.value=c.concept;const s=document.getElementById('v16-concept-subject');if(s)s.value=c.subject;showToast(`${c.concept} — heat ${c.heat ?? 'n/a'}`);setWorkspace(w=>({...w,action:'AI Concept Rescue',title:'AI Concept Rescue'}));}}><b>{c.concept}</b><span>{c.heat==null?'no data':`${c.heat} heat`}</span><em>{c.signals} signal{c.signals===1?'':'s'}</em></button>)}</div></div>)}</div>}        <div className="v16-legend"><span>Calm</span><i className="heat-scale"></i><span>Critical</span><em>Signals in play: {facultyIntel.tickets.length} doubt tickets • {facultyIntel.pendingEvaluations==null?'—':facultyIntel.pendingEvaluations} pending evaluations</em></div>        <h4>Open doubt tickets</h4>        {facultyIntel.tickets.length ? <div className="workspace-list">{facultyIntel.tickets.slice(0,10).map(t=><div key={t.id}><b>#{t.id} • {t.status}</b><span>{t.title} — {t.description}</span></div>)}</div> : <div className="empty-state">No doubt tickets are recorded in the backend for this cohort. Heat is therefore derived from mastery gap alone.</div>}      </div>      : isV16Rescue ? <div className="workspace-body v16-body">        <h3>AI Concept Rescue</h3>        <p>Generate a rescue explanation for a concept that the heatmap flagged, then publish it to your class.</p>        <div className="workspace-form"><label>Subject<select id="v16-concept-subject">{facultyIntel.scope.map(s=><option key={s}>{s}</option>)}</select></label><label>Concept<select id="v16-concept">{facultyIntel.concepts.map(c=><option key={`${c.subject}-${c.concept}`} value={c.concept}>{c.concept}{c.heat==null?' (no data)':` (heat ${c.heat})`}</option>)}</select></label></div>        <button className="solid-button" disabled={v16Busy==='rescue'} onClick={async()=>{const s=document.getElementById('v16-concept-subject')?.value;const c=document.getElementById('v16-concept')?.value;const m=facultyIntel.subjectMetrics.find(x=>x.name===s);await v16Ask('rescue',`Explain ${c} from ${s} to first-year engineering students. The cohort is at ${m?.known?`${m.progress}% course progress`:'unrecorded progress'} and cohort attendance is ${facultyIntel.attendancePct==null?'unknown':`${facultyIntel.attendancePct}%`}. Give a definition, a worked example, one common mistake and a quick self-check question.`);}}>{v16Busy==='rescue'?'Generating…':'Generate rescue explanation'}</button>        {v16Out&&<pre className="v16-ai-out">{v16Out}</pre>}        <div className="v16-form"><label>Note for students<textarea rows="3" defaultValue={v16Out} placeholder="The generated explanation is pre-filled — edit before publishing."></textarea></label><button className="solid-button" disabled={!v16Out} onClick={async()=>{const c=document.getElementById('v16-concept')?.value;const s=document.getElementById('v16-concept-subject')?.value;const body=document.querySelector('.v16-form textarea')?.value?.trim();if(!body)return showToast('Nothing to publish yet.');await v16Persist({rescues:[{concept:c,subject:s,semester:facultySemester,body,at:new Date().toISOString()},...facultyV16.rescues]});setV16Out('');showToast(`Rescue note for ${c} published to ${facultySemester}.`);}}>Publish to class</button></div>        <h4>Published rescue notes</h4>        {facultyV16.rescues.length ? <div className="workspace-list">{facultyV16.rescues.map((r,i)=><div key={`${r.at}-${i}`}><b>{r.concept}</b><span>{r.subject} • {r.semester} • {new Date(r.at).toLocaleString()}</span><p>{String(r.body).slice(0,240)}{String(r.body).length>240?'…':''}</p></div>)}</div> : <div className="empty-state">No rescue notes published yet.</div>}      </div>      : isV16Parent ? <div className="workspace-body v16-body">        <h3>AI Parent Connect</h3>        <p>Compose a guardian update. The numbers are injected from the live backend record for {facultySemester} — the AI only turns them into readable prose.</p>        <div className="v16-facts"><div><small>Attendance</small><b>{facultyIntel.attendancePct==null?'not published':`${facultyIntel.attendancePct}%`}</b><span>{facultyIntel.attendance.present||0} of {facultyIntel.attendance.total||0} present</span></div><div><small>Avg course progress</small><b>{facultyIntel.avgProgress==null?'not published':`${facultyIntel.avgProgress}%`}</b><span>{facultyIntel.scope.length} subject{facultyIntel.scope.length===1?'':'s'}</span></div><div><small>Pending evaluations</small><b>{facultyIntel.pendingEvaluations==null?'—':facultyIntel.pendingEvaluations}</b><span>awaiting faculty review</span></div></div>        <div className="workspace-form"><label>Audience<select id="v16-parent-audience"><option>Entire cohort — {facultyIntel.cohort} students</option>{facultyIntel.scope.map(s=><option key={s}>{s}</option>)}</select></label><label>Channel<select id="v16-parent-channel">{FACULTY_V16.parentChannels.map(c=><option key={c}>{c}</option>)}</select></label></div>        <button className="solid-button" disabled={v16Busy==='parent'} onClick={()=>v16Ask('parent',`Write a short, warm guardian update for the ${document.getElementById('v16-parent-audience')?.value||'cohort'} in ${facultySemester}. Real data: attendance ${facultyIntel.attendance.present} of ${facultyIntel.attendance.total} present (${facultyIntel.attendancePct}%), average course progress ${facultyIntel.avgProgress}%, ${facultyIntel.pendingEvaluations} assignments awaiting evaluation, weakest course ${facultyIntel.subjectMetrics.filter(s=>s.known).sort((a,b)=>a.progress-b.progress)[0]?.name||'none'}. Keep it to 4 short sentences and end with one concrete ask.`)}>{v16Busy==='parent'?'Drafting…':'Draft update with AI'}</button>        {v16Out&&<pre className="v16-ai-out">{v16Out}</pre>}        <div className="v16-form"><label>Final message<textarea rows="4" defaultValue={v16Out} placeholder="Draft appears here — edit before sending."></textarea></label><button className="solid-button" disabled={!v16Out} onClick={async()=>{const body=document.querySelector('.v16-form textarea')?.value?.trim();if(!body)return showToast('Draft the message first.');const entry={audience:document.getElementById('v16-parent-audience')?.value,channel:document.getElementById('v16-parent-channel')?.value,semester:facultySemester,body,at:new Date().toISOString()};await v16Persist({parentLog:[entry,...facultyV16.parentLog]});setV16Out('');showToast(`Guardian update logged for ${entry.audience}.`);}}>Send & log</button></div>        <h4>Recent guardian updates</h4>        {facultyV16.parentLog.length ? <div className="workspace-list">{facultyV16.parentLog.map((m,i)=><div key={`${m.at}-${i}`}><b>{m.audience}</b><span>{m.channel} • {m.semester} • {new Date(m.at).toLocaleString()}</span><p>{m.body}</p></div>)}</div> : <div className="empty-state">No guardian updates sent yet.</div>}      </div>      : isV16Plans ? <div className="workspace-body v16-body">        <h3>AI Personalized Learning</h3>        <p>Per-course remediation plans built from the measured mastery gap of each subject, not from generic templates.</p>        <div className="v16-sem-row"><span>Scope</span>{FACULTY_V16.semesters.map(s=><button key={s} className={facultySemester===s?'active':''} onClick={()=>{setFacultySemester(s);v16Persist({});}}>{s}</button>)}</div>        <div className="v16-plan-courses">{facultyIntel.subjectMetrics.map(s=>{const g=s.known?Math.max(0,100-s.progress):null;return <div key={s.name} className="v16-plan-course"><div><b>{s.name}</b><small>{s.known?`${s.progress}% progress • ${g}% gap • ${s.assignments} assignments • ${s.resources} resources`:`No progress record • ${s.assignments} assignments • ${s.resources} resources`}</small></div><div className="v16-bar"><i style={{width:`${s.known?s.progress:0}%`}}></i></div><button className="secondary-button" disabled={!s.known} onClick={async()=>{const weak=facultyIntel.concepts.filter(c=>c.subject===s.name).sort((a,b)=>(b.heat||0)-(a.heat||0)).slice(0,2).map(c=>c.concept).join(' and ')||'the weakest measured areas';const t=await v16Ask('plan',`Create a 2-week personalized remediation plan for ${s.name}. Course progress is ${s.progress}%, so a ${g}% mastery gap remains. Weakest concepts: ${weak}. Give week 1 and week 2 goals, two practice activities, and a mastery check.`);if(t)await v16Persist({plans:[{subject:s.name,semester:facultySemester,progress:s.progress,gap:g,weak,body:t,at:new Date().toISOString()},...facultyV16.plans]});}}>Generate plan</button></div>})}</div>        {v16Busy==='plan'&&<div className="v16-loading">Generating plan…</div>}        <h4>Saved plans</h4>        {facultyV16.plans.length ? <div className="v16-plan-saved">{facultyV16.plans.map((p,i)=><div key={`${p.at}-${i}`}><div className="v16-plan-head"><b>{p.subject}</b><span>{p.semester} • {p.progress}% progress • {p.gap}% gap • {new Date(p.at).toLocaleDateString()}</span></div><p>{p.weak}</p><pre>{p.body}</pre></div>)}</div> : <div className="empty-state">No plans generated yet. Use “Generate plan” on a course with a published progress record.</div>}      </div>      : isCrCommand ? <div className="workspace-body cr16-body">        <h3>AI Class Command Center</h3>        <p>One decision surface for the CR. Every count below comes from a record already in the CampusLMS backend.</p>        <div className="cr16-pulse">{[['👥','Cohort',crIntel.cohort],['✓','Present',crIntel.present],['▤','Pending work',crIntel.byStatus('Pending')],['!','Open issues',crIntel.openIssues.length],['▤','Polls',crIntel.polls.length]].map(([i,t,n])=><div key={t}><span>{i}</span><small>{t}</small><b>{n}</b></div>)}</div>        <h4>Priority queue</h4>        <div className="cr16-queue">{crIntel.queue.map(q=><button key={q.key} className={q.level} onClick={()=>setWorkspace({title:q.to,action:q.to,data:crIntel})}><i></i><div><b>{q.label}</b><small>{q.detail}</small></div><span>›</span></button>)}</div>        <button className="solid-button" disabled={crBusy==='brief'} onClick={()=>crAsk('brief',`Give the class representative a short morning briefing. Real data: ${crIntel.openIssues.length} open issues, ${crIntel.byStatus('Pending')} assignments pending submission, attendance ${crIntel.present} of ${crIntel.cohort} (${crIntel.attendancePct}%), average subject progress ${crIntel.avgProgress}%, weakest subject ${crIntel.weakest[0]?.name||'none'}, ${crIntel.polls.length} active polls, ${crIntel.schedules.length} classes scheduled. Give 3 prioritised actions in 4 short sentences.`)}>{crBusy==='brief'?'Briefing…':'Generate today’s briefing'}</button>        {crOut&&<pre className="cr16-ai">{crOut}</pre>}        <h4>Dispatch</h4>        <div className="workspace-actions"><button className="secondary-button" onClick={()=>setWorkspace({title:'Smart Announcement Generator',action:'Smart Announcement Generator',data:crIntel})}>Draft an announcement</button><button className="secondary-button" onClick={()=>setWorkspace({title:'Anonymous Issue Box',action:'Anonymous Issue Box',data:crIntel})}>Triage issue box</button><button className="secondary-button" onClick={()=>setWorkspace({title:'Student Manager',action:'Student Manager',data:crIntel})}>Open student manager</button></div>      </div>      : isCrIssueBox ? <div className="workspace-body cr16-body">        <h3>Anonymous Issue Box</h3>        <p>Issues are stored with the raiser recorded as <b>Anonymous</b>, then shown behind a stable thread code so you can reply without ever seeing who raised it.</p>        <div className="cr16-form"><label>Category<select id="cr-issue-cat">{CR_V16.issueCategories.map(c=><option key={c}>{c}</option>)}</select></label><label>Issue title<input id="cr-issue-title" placeholder="e.g. Lab 2 projector not working"/></label><label>Details<textarea rows="3" id="cr-issue-desc" placeholder="Describe the problem. Do not include your name — it is not stored."/></label><button className="solid-button" onClick={async()=>{const t=document.getElementById('cr-issue-title')?.value?.trim();if(!t)return showToast('Add a title first.');const category=document.getElementById('cr-issue-cat')?.value;try{const r=await api('/api/issues',{method:'POST',body:JSON.stringify({title:`[${category}] ${t}`,description:document.getElementById('cr-issue-desc')?.value?.trim()||'',raisedBy:'Anonymous'})});setWorkspace(w=>({...w,data:{...w.data,issues:[r.issue,...(w.data?.issues||crIntel.issues)]}}));await refreshDashboard();showToast('Submitted anonymously.');}catch(e){showToast(e.message)}}}>Submit anonymously</button></div>        <h4>Incoming issues</h4>        {(workspace.data?.issues||crIntel.issues).length ? <div className="cr16-issues">{(workspace.data?.issues||crIntel.issues).map(i=>{const anon=!i.raisedBy||i.raisedBy==='Anonymous';return <div className="cr16-issue" key={i.id}><div className="cr16-issue-head"><b>{i.title}</b><em className={String(i.status||'Open').toLowerCase().replace(/\s/g,'-')}>{i.status||'Open'}</em></div><small>{anon?CR_V16.mask(i.id):`Raised by ${i.raisedBy}`} • {new Date(i.createdAt).toLocaleDateString()}</small><p>{i.description||'No details provided.'}</p>{i.response&&<div className="cr16-response"><b>Your reply</b><p>{i.response}</p></div>}<div className="cr16-issue-actions"><select id={`cr-status-${i.id}`}>{CR_V16.issueStatuses.map(s=><option key={s} selected={s===(i.status||'Open')}>{s}</option>)}</select><input id={`cr-reply-${i.id}`} placeholder="Reply to the student (stays anonymous)"/><button className="solid-button" onClick={async()=>{const status=document.getElementById(`cr-status-${i.id}`)?.value;const response=document.getElementById(`cr-reply-${i.id}`)?.value?.trim();try{await api(`/api/issues/${i.id}`,{method:'PATCH',body:JSON.stringify({status,response,role:'CR'})});setWorkspace(w=>({...w,data:{...w.data,issues:(w.data?.issues||crIntel.issues).map(x=>x.id===i.id?{...x,status,response}:x)}}));showToast('Issue updated.');}catch(e){showToast(e.message)}}}>Update</button></div></div>})}</div> : <div className="empty-state">No issues have been submitted yet. Anonymous submissions will appear here with the raiser masked.</div>}      </div>      : isCrAnnounce ? <div className="workspace-body cr16-body">        <h3>Smart Announcement Generator</h3>        <p>CampusAI drafts the announcement from the real class situation. You keep full control — nothing is published until you press publish.</p>        <div className="cr16-facts"><div><small>Pending assignments</small><b>{crIntel.byStatus('Pending')}</b><span>of {crIntel.allAssignments.length} total</span></div><div><small>Attendance</small><b>{crIntel.attendancePct==null?'—':`${crIntel.attendancePct}%`}</b><span>{crIntel.present} of {crIntel.cohort} present</span></div><div><small>Open issues</small><b>{crIntel.openIssues.length}</b><span>awaiting triage</span></div><div><small>Weakest subject</small><b>{crIntel.weakest[0]?`${crIntel.weakest[0].progress}%`:'—'}</b><span>{crIntel.weakest[0]?.name||'no data'}</span></div></div>        <div className="workspace-form"><label>Angle<select id="cr-gen-angle"><option>Deadline reminder</option><option>Attendance nudge</option><option>Weak-topic revision slot</option><option>Event invite</option><option>General class update</option></select></label></div>        <button className="solid-button" disabled={crBusy==='gen2'} onClick={()=>crAsk('gen2',`Write a class announcement for CSE Semester I about: ${document.getElementById('cr-gen-angle')?.value}. Real situation: ${crIntel.byStatus('Pending')} assignments pending submission, attendance ${crIntel.attendancePct}%, average subject progress ${crIntel.avgProgress}%, weakest subject ${crIntel.weakest[0]?.name||'none'} at ${crIntel.weakest[0]?.progress||0}%, ${crIntel.openIssues.length} open issues. Keep it under 60 words, warm but firm, and end with one clear ask.`)}>{crBusy==='gen2'?'Drafting…':'Draft with AI'}</button>        {crOut&&<pre className="cr16-ai">{crOut}</pre>}        <div className="cr16-form"><label>Title<input id="cr16-title" placeholder="Announcement title"/></label><label>Body<textarea rows="4" id="cr16-body" placeholder="Draft appears here — edit before publishing."/></label><div className="cr16-inline"><button className="secondary-button" disabled={!crOut} onClick={()=>{const t=document.getElementById('cr16-title');const b=document.getElementById('cr16-body');if(!t||!b)return;const m=crOut.match(/TITLE:\s*(.+)\n[\s\S]*?BODY:\s*([\s\S]+)/i);t.value=m?m[1].trim().split('\n')[0]:`Class Update — ${document.getElementById('cr-gen-angle')?.value||'Announcement'}`;b.value=m?m[2].trim():crOut;showToast('Draft moved into the editor.');}}>Move draft into editor</button><button className="solid-button" disabled={!crOut} onClick={async()=>{const t=document.getElementById('cr16-title')?.value?.trim();const b=document.getElementById('cr16-body')?.value?.trim();if(!t||!b)return showToast('Title and body are required.');await publishAnnouncement(t,b);setCrOut('');showToast('Announcement published to the class feed.');}}>Publish to Class →</button></div></div>        <h4>Recent announcements</h4>        <div className="workspace-list">{(workspace.data?.announcements||crIntel.recentAnnouncements).slice(0,6).map(a=><div key={a.id}><b>{a.title}</b><span>{a.createdAt?new Date(a.createdAt).toLocaleString():'Recent'}</span><p>{a.body}</p></div>)}</div>      </div>      : isCrAnalytics ? <div className="workspace-body cr16-body">        <h3>Class Analytics</h3>        <p>Cohort-level analytics computed from the dashboard response. No figure here is hardcoded.</p>        <div className="cr16-kpis">{[['Attendance',crIntel.attendancePct==null?'—':`${crIntel.attendancePct}%`,`${crIntel.present} of ${crIntel.cohort} present`],['Avg subject progress',crIntel.avgProgress==null?'—':`${crIntel.avgProgress}%`,`${crIntel.subjects.length} subjects`],['Submission rate',crIntel.submissionRate==null?'no submissions':`${crIntel.submissionRate}%`,`${crIntel.submissions} submissions stored`],['Assignment backlog',String(crIntel.byStatus('Pending')),`${crIntel.byStatus('Upcoming')} upcoming`]].map(([t,v,s])=><div key={t}><small>{t}</small><b>{v}</b><span>{s}</span></div>)}</div>        <h4>Subject progress</h4>        {crIntel.subjects.length ? <div className="cr16-bars">{crIntel.subjects.map(s=><div key={s.name}><div className="cr16-bar"><i style={{width:`${s.progress}%`}}></i></div><b>{s.name}</b><span>{s.progress}%</span></div>)}</div> : <div className="empty-state">No subject progress published.</div>}        <h4>Assignment pipeline</h4>        {crIntel.allAssignments.length ? <div className="cr16-table"><div className="cr16-tr cr16-th"><span>Assignment</span><span>Subject</span><span>Deadline</span><span>Status</span><span>Subs</span></div>{crIntel.allAssignments.map(a=><div className="cr16-tr" key={a.id}><span>{a.title}</span><span>{a.subject}</span><span>{a.deadline}</span><span><em className={`st st-${String(a.status||'').toLowerCase()}`}>{a.status}</em></span><span>{a.submissions?.length||0}</span></div>)}</div> : <div className="empty-state">No assignment records.</div>}        <h4>Participation</h4>        <div className="cr16-facts"><div><small>Polls created</small><b>{crIntel.polls.length}</b><span>feedback instruments</span></div><div><small>Doubt tickets</small><b>{crIntel.tickets.length}</b><span>from the class</span></div><div><small>Open issues</small><b>{crIntel.openIssues.length}</b><span>of {crIntel.issues.length} total</span></div><div><small>Announcements</small><b>{crIntel.recentAnnouncements.length}</b><span>in the feed</span></div></div>        <p className="cr16-note">Subject progress, attendance and assignment status are cohort aggregates. The backend does not yet store per-student marks, so this module reports class-level analytics rather than inventing an individual leaderboard.</p>      </div>      : isCrStudents ? <div className="workspace-body cr16-body">        <h3>Student Manager</h3>        <p>Cohort management for the class representative, grounded in stored records.</p>        <div className="cr16-facts"><div><small>Enrolled</small><b>{crIntel.cohort||'—'}</b><span>CSE (IoT) Semester I</span></div><div><small>Present today</small><b>{crIntel.present||'—'}</b><span>{crIntel.attendancePct==null?'no attendance record':`${crIntel.attendancePct}% attendance`}</span></div><div><small>Assignment records</small><b>{crIntel.allAssignments.length}</b><span>{crIntel.submissions} submissions stored</span></div><div><small>Individual records</small><b>{crIntel.roster.length}</b><span>students with submissions</span></div></div>        {crIntel.roster.length ? <><h4>Students with recorded activity</h4><div className="cr16-table"><div className="cr16-tr cr16-th"><span>Student</span><span>ID</span><span>Subs</span><span>Assignments</span></div>{crIntel.roster.map(s=><div className="cr16-tr" key={s.id}><span>{s.name}</span><span>{s.id}</span><span>{s.submitted}</span><span>{s.assignments.join(', ')||'—'}</span></div>)}</div></> : <div className="empty-state">No per-student submission records exist in the backend yet, so the roster table is empty rather than filled with invented names. It fills in automatically as soon as students submit work. The cohort size of {crIntel.cohort||'—'} comes from the attendance record.</div>}        <h4>Class-wide status by subject</h4>        <div className="cr16-table"><div className="cr16-tr cr16-th"><span>Subject</span><span>Progress</span><span>Assignments</span><span>Needs attention</span></div>{crIntel.subjects.map(s=>{const rows=crIntel.allAssignments.filter(a=>a.subject===s.name);return <div className="cr16-tr" key={s.name}><span>{s.name}</span><span>{s.progress}%</span><span>{rows.length}</span><span>{s.progress<70?'Yes — below 70%':s.progress<80?'Watch':'No'}</span></div>})}</div>        <div className="workspace-actions"><button className="secondary-button" onClick={()=>setWorkspace({title:'Smart Announcement Generator',action:'Smart Announcement Generator',data:crIntel})}>Message the class →</button><button className="secondary-button" onClick={async()=>{try{const r=await api('/api/student-records');showToast(r.studentRecord?`Record for ${r.studentRecord.name} loaded.`:'No student record available.');}catch(e){showToast(e.message)}}}>Load student record</button></div>      </div>      : isCrEvents ? <div className="workspace-body cr16-body">        <h3>Timetable &amp; Events</h3>        <p>The weekly timetable already lives on your CR dashboard and is read from the backend. This module adds the <b>events</b> layer, which the backend does not have yet.</p>        <h4>Weekly timetable (read-only)</h4>        {crIntel.schedules.length ? <div className="workspace-list">{crIntel.schedules.map(c=><div key={c.id}><b>{c.time} • {c.title}</b><span>{c.detail} • {c.room||'Room TBC'}</span></div>)}</div> : <div className="empty-state">No timetable published.</div>}        <h4>CR events</h4>        <div className="cr16-form"><label>Event title<input id="cr-ev-title" placeholder="e.g. IoT Workshop"/></label><label>Type<select id="cr-ev-type">{CR_V16.eventTypes.map(t=><option key={t}>{t}</option>)}</select></label><label>Date<input id="cr-ev-date" type="date"/></label><label>Venue<input id="cr-ev-venue" placeholder="e.g. CSE Lab 1"/></label><label>Note<textarea id="cr-ev-note" rows="2" placeholder="Anything the class should know"/></label><button className="solid-button" onClick={async()=>{const title=document.getElementById('cr-ev-title')?.value?.trim();if(!title)return showToast('Event title is required.');const ev={id:`EV-${Date.now().toString(36).toUpperCase()}`,title,type:document.getElementById('cr-ev-type')?.value,date:document.getElementById('cr-ev-date')?.value,venue:document.getElementById('cr-ev-venue')?.value?.trim(),note:document.getElementById('cr-ev-note')?.value?.trim(),at:new Date().toISOString()};await crPersist({events:[ev,...crEvents]});showToast(`Event “${ev.title}” saved.`);['cr-ev-title','cr-ev-date','cr-ev-venue','cr-ev-note'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';});}}>Add event</button></div>        {crEvents.length ? <div className="cr16-event-list">{crEvents.map(e=><div key={e.id} className="cr16-event"><time>{e.date||'TBD'}</time><div><b>{e.title}</b><small>{e.type} • {e.venue||'Campus'}</small>{e.note&&<p>{e.note}</p>}</div><button className="secondary-button" onClick={async()=>{await crPersist({events:crEvents.filter(x=>x.id!==e.id)});showToast('Event removed.');}}>Remove</button></div>)}</div> : <div className="empty-state">No CR events yet. Events you add are saved to the backend.</div>}        <div className="workspace-actions"><button className="secondary-button" onClick={()=>setWorkspace({title:'Smart Announcement Generator',action:'Smart Announcement Generator',data:crIntel})}>Announce an event →</button></div>      </div>      : isFacultyTickets ? <div className="workspace-body"><h3>Doubt Tickets</h3><p>Live tickets stored in the backend.</p><div className="workspace-list">{(serverData?.tickets||[]).slice(0,10).map(t=><div key={t.id}><b>#{t.id} • {t.status}</b><span>{t.title} — {t.description}</span></div>)}</div><button className="solid-button" onClick={refreshDashboard}>Refresh Tickets</button></div>      : isFacultyRemedial ? <div className="workspace-body"><h3>Remedial Session Planner</h3><p>Create a support session and save it to the faculty backend.</p><input className="workspace-answer" id="remedial-student" placeholder="Student or group"/><input className="workspace-answer" id="remedial-topic" placeholder="Topic, e.g. Normalization"/><input className="workspace-answer" id="remedial-date" type="date"/><button className="solid-button" onClick={async()=>{const r=await api('/api/faculty/remedial',{method:'POST',body:JSON.stringify({student:document.getElementById('remedial-student')?.value,topic:document.getElementById('remedial-topic')?.value,date:document.getElementById('remedial-date')?.value})});showToast(r.message);}}>Save Remedial Plan</button></div>      : isFacultyGrading ? <div className="workspace-body"><h3>Smart Grading</h3><p>Save grade and faculty feedback as a backend record.</p><input className="workspace-answer" id="grade-student" placeholder="Student name"/><select className="workspace-answer" id="grade-value"><option>A</option><option>B</option><option>C</option><option>D</option></select><textarea className="workspace-answer" id="grade-feedback" rows="4" placeholder="Feedback"></textarea><button className="solid-button" onClick={async()=>{const r=await api('/api/faculty/grading',{method:'POST',body:JSON.stringify({student:document.getElementById('grade-student')?.value,grade:document.getElementById('grade-value')?.value,feedback:document.getElementById('grade-feedback')?.value})});showToast(r.message);}}>Save Grade</button></div>      : isAI ? <div className="workspace-body"><h3>{title}</h3><p>CampusAI is connected to the same live records as this page. Ask for a plan, an explanation, a question paper or a message you can send to your class.</p>        <div className="px-ai-prompts">          {(role === 'Faculty'            ? ['Explain normalization with a simple example for my class', 'Draft 5 exam questions on pointers with answers', 'Write a note to students who missed two lectures']            : ['Give me a morning briefing for my class', 'Draft an announcement about pending submissions', 'Which subject should I focus on first?']          ).map((q) => <button key={q} disabled={roleChatBusy} onClick={() => sendRoleChat(q)}>{q}</button>)}        </div>        <div className="ai-chat px-ai-chat">          <div className="ai-thread">            {!roleChat.length && <div className="ai-message bot"><span className="ai-avatar">✦</span><div><strong>CampusAI</strong><p>Ask me anything about this module — I read the same attendance, progress and assignment records that are on your screen.</p></div></div>}            {roleChat.map((m, i) => <div className={`ai-message ${m.role === 'user' ? 'user' : 'bot'}`} key={i}><span className="ai-avatar">{m.role === 'user' ? (role === 'Faculty' ? 'F' : 'SP') : '✦'}</span><div><strong>{m.role === 'user' ? 'You' : 'CampusAI'}</strong><p>{m.text}</p></div></div>)}            {roleChatBusy && <div className="ai-message bot"><span className="ai-avatar">✦</span><div><strong>CampusAI</strong><p>Working on it…</p></div></div>}          </div>          <div className="ai-composer"><input value={roleChatInput} onChange={(e) => setRoleChatInput(e.target.value)} onKeyDown={(e) => e.key === 'Enter' && sendRoleChat()} placeholder="Ask CampusAI about this module…" /><button onClick={() => sendRoleChat()} disabled={roleChatBusy || !roleChatInput.trim()}>Send →</button></div>        </div>        <div className="workspace-actions"><button className="secondary-button" onClick={() => setRoleChat([])}>Clear conversation</button></div>      </div>      : <div className="workspace-body"><h3>{title}</h3><p>This module is wired to the CampusLMS backend. Pick an action below, run it, and the result is stored as a real record.</p><div className="workspace-actions"><button className="solid-button" onClick={async()=>{await runAction(`${title} workflow started`,{source:'workspace'});showToast(`${title} started.`);}}>Start Workflow</button><button className="secondary-button" onClick={async()=>{await runAction(`${title} completed`,{source:'workspace'});}}>Complete &amp; Save</button><button className="secondary-button" onClick={refreshDashboard}>Refresh live data</button></div></div>}    </>);    /* The module now opens as its own premium page inside the role layout, so       the dashboard, the sidebar and the top bar all stay visible behind it. */    const meta = workspaceModuleMeta(a, title);    return <PremiumPage      tone={meta.tone}      icon={meta.icon}      eyebrow={meta.eyebrow}      title={title}      subtitle={meta.subtitle}      badge={meta.badge}      breadcrumb={`${meta.group} / ${title}`}      backLabel={meta.back}      onBack={closeWorkspace}      chips={workspaceModuleChips()}    >{renderWorkspaceBody()}</PremiumPage>;  };  if (role === "Faculty") return <>{renderFacultyDashboard()}{toast && <div className="campus-toast">{toast}</div>}</>;  if (role === "CR") return <>{renderCRDashboard()}{toast && <div className="campus-toast">{toast}</div>}</>;  return (    <div className={`app-shell ${dark ? "theme-dark" : ""}`}>      <RailNav        role="Student"        tagline="Learn. Grow. Succeed."        user={{ initials: 'SP', name: 'Satya Prakash', sub: 'Student • CSE (Sem 1)' }}        items={railItems('Student', {          active,          moduleOpen: Boolean(workspace),          openPage: go,          onSearch: () => { go('Resources'); window.setTimeout(() => document.querySelector('.global-search input')?.focus(), 0); },        })}        onSettings={() => runAction('Settings panel opened.')}        onSignOut={logout}      />      <main className={`main-content ${active==='AI Mentorship'?'aar-shell':''}`}>        <header className="topbar">          <div className="mobile-brand">CampusLMS</div>          <div className="global-search"><span>⌕</span><input value={search} onChange={(e)=>setSearch(e.target.value)} onKeyDown={(e)=>{if(e.key==='Enter')go('Resources')}} placeholder="Search notes, PYQs, assignments, mentors, topics..."/><kbd>Ctrl K</kbd></div>          <div className="top-actions"><button className={`exam-toggle ${examMode?'on':''}`} onClick={()=>{setExamMode(!examMode); if(!examMode) go('Exam Night Mode')}}>🔥 Exam Mode</button><button onClick={()=>setDark(!dark)}>{dark?'☀':'☼'}</button><button onClick={openNotifications} className="bell">♧<b>{notifications}</b></button><div className="top-profile"><span className="avatar">SP</span><div><b>Satya Prakash</b><small>Student • CSE (Sem 1)</small></div><span>⌄</span></div></div>        </header>        <div className="page-content">{content}</div>        <footer className="footer"><div><b>◆ CampusLMS</b><small>Indian Students. Global Opportunities.</small></div><div className="footer-links"><span>About</span><span>Privacy</span><span>Help</span><span>Contact</span></div><div>🇮🇳 Learn Today. Lead Tomorrow.</div><span>Made for a Smarter India ❤️</span></footer>        {role === "Student" && <div className={`ai-launcher-wrap ${aiLauncherOpen ? "open" : ""}`}><div className="ai-launcher-panel"> <div className="ai-launcher-head"><div><b>CampusAI</b><small>Your academic assistant</small></div><span>● Online</span></div><button onClick={()=>{setAiLauncherOpen(false);go("AI Assistant");}}>💬 Ask CampusAI</button><button onClick={()=>{setAiLauncherOpen(false);openStudentTool("AI Summary");}}>✦ AI Summary</button><button onClick={()=>{setAiLauncherOpen(false);openStudentTool("Smart Revision Hub");}}>🗂 Smart Revision Hub</button><button onClick={()=>{setAiLauncherOpen(false);openStudentTool("AI Viva Simulator");}}>🎙 Viva Practice</button><button onClick={()=>{setAiLauncherOpen(false);openStudentTool("30-Min Rescue");}}>⏱ 30-Min Study Rescue</button><button onClick={()=>{setAiLauncherOpen(false);openStudentTool("Exam Readiness");}}>◎ Exam Readiness</button><button onClick={()=>{setAiLauncherOpen(false);openStudentTool("Placement & Career Hub");}}>🚀 Placement &amp; Career</button></div><button className="ai-launcher" aria-label="Open CampusAI" onClick={()=>setAiLauncherOpen(v=>!v)}><span>✦</span><i>AI</i></button></div>}        {toast && <div className="campus-toast">{toast}</div>}      </main>    </div>  );}export default App;